package templates

import (
	"context"
	"encoding/json"
	"io"
	"net/url"
	"strconv"
	"strings"

	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/accordion"
	"github.com/araihu/goshtoso/components/appshell"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/breadcrumbs"
	"github.com/araihu/goshtoso/components/codeblock"
	"github.com/araihu/goshtoso/components/emptystate"
	"github.com/araihu/goshtoso/components/pageheader"
	"github.com/araihu/goshtoso/components/panel"
	"github.com/araihu/goshtoso/components/schemaform"
	searchfield "github.com/araihu/goshtoso/components/search"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/goshtoso/components/sidebar"
	"github.com/araihu/goshtoso/components/skeleton"
	"github.com/araihu/goshtoso/components/table"
	"github.com/araihu/goshtoso/components/tabs"

	"github.com/araihu/manja/application/port"
	core "github.com/araihu/manja/domain"
)

type selectedDocsItem struct {
	Anchor    string
	Kind      string
	Operation core.Operation
	Schema    core.Schema
}

type EndpointSidebarLabelMode string

const (
	EndpointSidebarLabelAuto EndpointSidebarLabelMode = "auto"
	EndpointSidebarLabelPath EndpointSidebarLabelMode = "path"
)

type PublicDocsOptions struct {
	EndpointSidebarLabel EndpointSidebarLabelMode
	MarkdownRenderer     port.MarkdownRenderer
	ManageDefaultLogo    bool
	ManageDefaultFavicon bool
}

const (
	docsSearchID = "docs-search"
)

func (opts PublicDocsOptions) withDefaults() PublicDocsOptions {
	switch opts.EndpointSidebarLabel {
	case EndpointSidebarLabelPath:
		return opts
	default:
		opts.EndpointSidebarLabel = EndpointSidebarLabelAuto
		return opts
	}
}

type ExampleOptions struct {
	SkipNonRequired bool `json:"skipNonRequired"`
	Quiet           bool `json:"quiet"`
	MaxSampleDepth  int  `json:"maxSampleDepth"`
}

type ExampleConfig struct {
	ID              string
	Label           string
	Language        string
	SchemaJSON      string
	ExampleJSON     string
	ExplicitExample bool
	SpecJSON        string
	Options         ExampleOptions
}

type requestConfigBody struct {
	Has    bool
	Media  core.OperationMediaType
	Config ExampleConfig
}

type requestSampleTarget struct {
	Value    string
	Label    string
	Target   string
	Client   string
	Language string
}

templ PublicDocs(idx core.SpecIndex, selectedID string) {
	@PublicDocsWithOptions(idx, selectedID, PublicDocsOptions{})
}

templ PublicDocsWithOptions(idx core.SpecIndex, selectedID string, opts PublicDocsOptions) {
	{{ opts = opts.withDefaults() }}
	{{ selected := selectedDocsItemFor(idx, selectedID) }}
	@LayoutWithBranding(publicDocsDocumentTitle(idx, selected), idx.Branding, true, opts.ManageDefaultFavicon) {
		<div hx-history="false" class="fixed inset-0 overflow-clip bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			@appshell.AppShell(appshell.Config{
				Header:       publicApplicationHeader(idx, selected, opts),
				Sidebar:      publicDocsSidebar(idx, selected, opts),
				MainID:       "main-content",
				RootClass:    "h-full",
				RootAttrs:    templpkg.Attributes{"data-manja-app-shell": "true"},
				HeaderClass:  "manja-docs-header relative z-50 shrink-0 border-b border-outline bg-surface dark:border-outline-dark dark:bg-surface-dark",
				HeaderAttrs:  templpkg.Attributes{"data-boot-anim": "header"},
				SidebarClass: "hidden h-full w-72 shrink-0 lg:block",
				SidebarAttrs: templpkg.Attributes{"aria-label": "API sections", "data-boot-anim": "sidebar"},
				MainClass:    "min-h-0 min-w-0 flex-1 overflow-y-auto overflow-x-hidden p-6 lg:px-10 lg:py-8",
				MainAttrs: templpkg.Attributes{
					"data-boot-anim":            "main",
					"data-manja-primary-scroll": "true",
					"data-selected-doc":         selected.Anchor,
				},
			}) {
				<div class="mx-auto max-w-[100rem]">
					@PublicDocsFragmentContent(idx, selectedID, opts)
				</div>
			}
			@searchfield.SearchModal(docsSearchConfig(idx.Search))
			@manjaFuzzySearchScript()
		</div>
	}
}

templ publicApplicationHeader(idx core.SpecIndex, selected selectedDocsItem, opts PublicDocsOptions) {
	<div class="flex h-16 items-center justify-between gap-3 px-4 lg:px-8">
		<div class="flex min-w-0 items-center gap-2">
			@sidebar.Overlay(sidebar.OverlayConfig{
				ID:                    "public-docs-sidebar",
				TriggerLabel:          "Open API sections",
				TriggerClass:          "min-h-11 min-w-11",
				RootClass:             "lg:hidden",
				PanelPositionClass:    "fixed top-16 bottom-0 left-0",
				PanelWidthClass:       "w-72 max-w-[85vw]",
				BackdropPositionClass: "fixed top-16 bottom-0 left-0 right-0",
				Sidebar:               publicDocsSidebarConfig(idx, selected, opts, docsSearchOpenSlot(), "mobile"),
			})
			<a href={ templpkg.URL(docsBrandingHomeURL(idx.Branding)) } class="flex min-w-0 items-center gap-2 text-2xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">
				if idx.Branding.Logo.Src != "" {
					if opts.ManageDefaultLogo {
						<img src={ templpkg.URL(idx.Branding.Logo.Src) } alt={ idx.Branding.Logo.Alt } width="32" height="32" crossorigin="anonymous" data-asset-brand="logo" class="size-8 shrink-0 rounded-radius"/>
					} else {
						<img src={ templpkg.URL(idx.Branding.Logo.Src) } alt={ idx.Branding.Logo.Alt } width="32" height="32" class="size-8 shrink-0 rounded-radius"/>
					}
				}
				<span>{ docsBrandingDisplayName(idx.Branding) }</span>
			</a>
		</div>
		<div class="flex min-w-0 items-center gap-3 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
			<div class="manja-theme-select shrink-0">
				@selectfield.Select(selectfield.Config{
					ID:             "manja-theme",
					Name:           "theme",
					Alpine:         &selectfield.AlpineConfig{Model: "theme"},
					TriggerLeading: themeSelectIcon(),
					TriggerAttrs:   templpkg.Attributes{"aria-label": "Theme"},
					Options:        themeOptions(),
				})
			</div>
			@themeToggle()
			<button
				hidden
				type="button"
				aria-pressed="false"
				data-campaign-toggle
				data-use-campaign-label="Use seasonal appearance"
				data-use-baseline-label="Use standard appearance"
				class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-radius border border-outline text-on-surface-strong dark:border-outline-dark dark:text-on-surface-dark-strong"
			>
				<span data-campaign-toggle-icon aria-hidden="true"></span>
				<span class="sr-only">Use seasonal appearance</span>
			</button>
			<span class="hidden md:inline">OpenAPI docs</span>
			if idx.Version != "" {
				<span class="hidden rounded-radius border border-outline px-2 py-1 font-mono text-xs text-on-surface-strong dark:border-outline-dark dark:text-on-surface-dark-strong sm:inline">v{ idx.Version }</span>
			}
		</div>
	</div>
}

templ manjaFuzzySearchScript() {
	<script>
		(function () {
			var baseSearchModal = window.goshtosoSearchModal;
			if (!baseSearchModal || baseSearchModal.__manjaFuzzy) return;

			function compact(value) {
				return String(value || "").toLowerCase().replace(/[^a-z0-9]+/g, "");
			}

			function fuzzyScore(query, value) {
				var needle = compact(query);
				var haystack = compact(value);
				if (!needle || !haystack) return -1;
				var direct = haystack.indexOf(needle);
				if (direct >= 0) return direct;
				var cursor = 0;
				var first = -1;
				var last = -1;
				var gaps = 0;
				for (var i = 0; i < haystack.length && cursor < needle.length; i++) {
					if (haystack[i] !== needle[cursor]) continue;
					if (first < 0) first = i;
					if (last >= 0) gaps += i - last - 1;
					last = i;
					cursor++;
				}
				if (cursor !== needle.length) return -1;
				return 20 + first + gaps + Math.max(0, haystack.length - needle.length) / 10;
			}

			function resultScore(term, title, text) {
				term = String(term || "").trim().toLowerCase();
				title = String(title || "");
				text = String(text || "");
				if (!term) return -1;
				if (title.toLowerCase().indexOf(term) !== -1) return 0;
				if (text.toLowerCase().indexOf(term) !== -1) return 100;
				var titleScore = fuzzyScore(term, title);
				if (titleScore >= 0) return 200 + titleScore;
				var textScore = fuzzyScore(term, text);
				if (textScore >= 0) return 400 + textScore;
				return -1;
			}

			function rankedMatches(values, scoreFor) {
				var matches = [];
				values.forEach(function (value, index) {
					var score = scoreFor(value);
					if (score >= 0) matches.push({ value: value, index: index, score: score });
				});
				matches.sort(function (a, b) {
					if (a.score !== b.score) return a.score - b.score;
					return a.index - b.index;
				});
				return matches.map(function (match) { return match.value; });
			}

			window.goshtosoSearchModal = function () {
				var state = baseSearchModal.apply(this, arguments);
				state.matches = function (el) {
					return resultScore(this.query, el && el.dataset && el.dataset.searchTitle, el && el.dataset && el.dataset.searchText) >= 0;
				};
				state.matchedDOMResults = function () {
					var term = this.query.trim().toLowerCase();
					if (!term) return [];
					if (term === this.cachedDOMTerm) return this.cachedDOMResults;
					this.cachedDOMTerm = term;
					this.cachedDOMResults = rankedMatches(this.allResults(), function (el) {
						return resultScore(term, el.dataset.searchTitle, el.dataset.searchText);
					}).slice(0, this.maxResults);
					return this.cachedDOMResults;
				};
				state.matchedClientResults = function () {
					var term = this.query.trim().toLowerCase();
					if (!term) return [];
					if (term === this.cachedClientTerm) return this.cachedClientResults;
					this.cachedClientTerm = term;
					this.cachedClientResults = rankedMatches(this.clientItems, function (item) {
						return resultScore(term, item.title, item.searchText);
					}).slice(0, this.maxResults);
					return this.cachedClientResults;
				};
				return state;
			};
			window.goshtosoSearchModal.__manjaFuzzy = true;
		})();
	</script>
}

templ PublicDocsFragmentWithOptions(idx core.SpecIndex, selectedID string, opts PublicDocsOptions) {
	{{ opts = opts.withDefaults() }}
	@PublicDocsFragmentContent(idx, selectedID, opts)
}

templ PublicDocsFragmentContent(idx core.SpecIndex, selectedID string, opts PublicDocsOptions) {
	{{ selected := selectedDocsItemFor(idx, selectedID) }}
	@publicDocsLoading(selected)
	<div data-public-docs-content="true" data-selected-doc={ selected.Anchor } data-document-title={ publicDocsDocumentTitle(idx, selected) }>
		@publicDocsPageHeader(idx, selected)
		@selectedDocsContent(idx, selected, opts)
	</div>
	@publicDocsFooter()
}

templ publicDocsPageHeader(idx core.SpecIndex, selected selectedDocsItem) {
	@pageheader.PageHeader(pageheader.Config{
		Title:       publicDocsPageTitle(idx, selected),
		Description: publicDocsPageDescription(idx, selected),
		Breadcrumbs: selectedDocsBreadcrumbs(idx, selected),
		Actions:     publicDocsPageActions(idx, selected),
		RootClass:   "mb-8",
		RootAttrs: templpkg.Attributes{
			"data-public-page-header": "true",
		},
		TitleClass: "manja-doc-title",
		TitleAttrs: templpkg.Attributes{
			"id":                       selected.Anchor + "-heading",
			"tabindex":                 "-1",
			"data-public-doc-identity": selected.Anchor,
			"data-manja-settled-focus": "true",
		},
	})
}

templ publicDocsPageActions(idx core.SpecIndex, selected selectedDocsItem) {
	<div class="flex flex-wrap items-center gap-2">
		if selected.Kind == "overview" && idx.Version != "" {
			@badge.Badge(badge.Config{Label: "v" + idx.Version, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
		}
		if selected.Kind == "overview" && overviewHasSpecDownload(idx) {
			<a href="/openapi.json" download={ overviewSpecFilename(idx.SpecDownload) } aria-label="Download OpenAPI JSON spec" class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-radius border border-outline bg-surface-alt px-3 text-sm font-semibold text-on-surface-strong transition hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark-strong dark:hover:bg-surface-dark dark:focus-visible:outline-primary-dark">
				@downloadIcon()
				<span>Download JSON</span>
			</a>
		}
	</div>
}

templ publicDocsLoading(selected selectedDocsItem) {
	<div id="public-docs-loading" data-public-docs-loading="true" data-loading-doc={ selected.Anchor } class="htmx-indicator mb-8" aria-busy="true">
		@skeleton.Skeleton(skeleton.Config{
			Shape:     skeleton.ShapeRectangle,
			Count:     3,
			Label:     "Loading public documentation",
			RootClass: "grid gap-4",
			ItemClass: "min-h-16",
		})
	</div>
}

templ publicDocsSidebar(idx core.SpecIndex, selected selectedDocsItem, opts PublicDocsOptions) {
	<div id="sidebar-nav-content" class="h-full">
		@sidebar.Sidebar(publicDocsSidebarConfig(idx, selected, opts, docsSearchField(idx.Search), ""))
	</div>
}

func publicDocsSidebarConfig(idx core.SpecIndex, selected selectedDocsItem, opts PublicDocsOptions, searchSlot templpkg.Component, idPrefix string) sidebar.Config {
	return sidebar.Config{
		Items:         overviewSidebarItems(selected.Anchor),
		SectionsTitle: "API Reference",
		Sections:      sidebarSections(idx, selected.Anchor, opts.EndpointSidebarLabel, idPrefix),
		SearchSlot:    searchSlot,
		DisableSkipLink: true,
	}
}

templ selectedDocsContent(idx core.SpecIndex, selected selectedDocsItem, opts PublicDocsOptions) {
	if selected.Kind == "overview" {
		@overviewSection(idx, opts)
	} else if selected.Kind == "operation" {
		<section aria-labelledby="operations-heading" class="grid gap-16">
			<h2 id="operations-heading" data-toc-heading class="sr-only">Operations</h2>
			@endpointSection(selected.Operation, idx.Overview.Servers, idx.ExampleSpecJSON, opts)
		</section>
	} else if selected.Kind == "schema" {
		<section aria-labelledby="schemas-heading">
			<h2 id="schemas-heading" data-toc-heading class="sr-only">Schemas</h2>
			@schemaSection(selected.Schema, idx.ExampleSpecJSON, opts)
		</section>
	} else if selected.Kind == "missing" {
		@publicDocsNotFound(idx, selected.Anchor)
	} else {
		@publicDocsEmpty(idx)
	}
}

templ publicDocsEmpty(idx core.SpecIndex) {
	@emptystate.EmptyState(emptystate.Config{
		Title:       "No public documentation",
		Description: "Publish a spec with operations or schemas to populate this view.",
		Action:      publicDocsOverviewLink("Open contract overview"),
		RootAttrs: templpkg.Attributes{
			"data-public-docs-empty": "true",
		},
	})
}

templ publicDocsNotFound(idx core.SpecIndex, requested string) {
	@emptystate.EmptyState(emptystate.Config{
		Title:       "Documentation not found",
		Description: "The requested operation or schema is not part of the current contract.",
		Action:      publicDocsOverviewLink("Return to contract overview"),
		RootAttrs: templpkg.Attributes{
			"data-public-docs-not-found": "true",
			"data-requested-doc":         requested,
		},
	})
}

templ publicDocsOverviewLink(label string) {
	<a href={ templpkg.URL(selectedDocsHref("overview")) } class="inline-flex min-h-11 items-center justify-center rounded-radius bg-primary px-4 py-2 text-sm font-semibold text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-primary-dark dark:text-on-primary-dark dark:focus-visible:outline-primary-dark">{ label }</a>
}

templ publicDocsFooter() {
	<footer aria-label="Powered by Manja" class="mt-16 border-t border-outline pt-6 pb-2 text-sm text-on-surface-muted dark:border-outline-dark dark:text-on-surface-dark-muted">
		<p class="inline-flex items-center gap-2">
			<svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0 text-primary dark:text-primary-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"></path>
			</svg>
			<span>
				Powered by
				<a href="https://manja.araihu.com" target="_blank" rel="noopener" class="font-semibold text-on-surface-strong underline-offset-4 transition-colors hover:text-primary hover:underline dark:text-on-surface-dark-strong dark:hover:text-primary-dark">Manja</a>
			</span>
		</p>
	</footer>
}

templ selectedDocsBreadcrumbs(idx core.SpecIndex, selected selectedDocsItem) {
	if selected.Kind == "operation" {
		@breadcrumbs.Breadcrumbs(breadcrumbs.Config{
			Items:    operationBreadcrumbItems(idx, selected.Operation, selected.Anchor),
			Current: operationTitle(selected.Operation),
			NavClass: "mb-8",
		})
	}
}

templ overviewSection(idx core.SpecIndex, opts PublicDocsOptions) {
	<section id="overview" aria-labelledby="overview-heading" class="scroll-mt-24">
		<div class="max-w-[88rem]">
			@panel.Panel(panel.Config{
				Body:      overviewSummary(idx),
				RootClass: "max-w-3xl",
				RootAttrs: templpkg.Attributes{"data-public-overview-summary": "true"},
			})
			if len(idx.Overview.Servers) > 0 {
				<section class="mt-10 overflow-hidden rounded-radius border border-outline bg-surface-dark text-on-surface-dark dark:border-outline-dark" aria-labelledby="overview-base-url-heading">
					<div class="border-b border-outline-dark bg-surface-dark px-4 py-3">
						<h3 id="overview-base-url-heading" class="text-sm font-semibold text-on-surface-dark-strong">API Base URL</h3>
					</div>
					<div class="grid gap-4 bg-surface-dark-alt p-4">
						for _, server := range idx.Overview.Servers {
							<section class="overflow-hidden rounded-radius bg-surface-dark">
								<div class="flex min-w-0 flex-wrap items-center gap-2 px-4 py-3">
									<span aria-hidden="true" class="text-on-surface-dark-muted">▾</span>
									<p class="min-w-0 text-sm font-semibold text-on-surface-dark-strong">
										Live Server:
										<code class="ml-1 break-all font-mono text-sm font-semibold text-on-surface-dark">{ server.URL }</code>
									</p>
								</div>
								if server.Description != "" {
									<div class="px-4 pb-4">
										if hasMarkdown(opts.MarkdownRenderer, server.Description) {
											<div class="max-w-[70ch] text-sm">
												@renderedMarkdown(opts.MarkdownRenderer, server.Description)
											</div>
										} else {
											<p class="text-sm leading-6 text-on-surface-dark">{ server.Description }</p>
										}
									</div>
								}
								if len(server.Variables) > 0 {
									<dl class="grid gap-5 border-t border-outline-dark px-8 py-6">
										for _, variable := range server.Variables {
											<div class="grid gap-2">
												<dt class="font-mono text-sm font-bold text-on-surface-dark-strong">{ variable.Name }</dt>
												<dd class="grid gap-2 text-sm text-on-surface-dark-muted">
													<span>string</span>
													if variable.Description != "" {
														if hasMarkdown(opts.MarkdownRenderer, variable.Description) {
															<div class="max-w-[70ch] text-sm">
																@renderedMarkdown(opts.MarkdownRenderer, variable.Description)
															</div>
														} else {
															<p class="text-sm leading-6 text-on-surface-dark">{ variable.Description }</p>
														}
													}
													if variable.Default != "" {
														<p class="text-xs text-on-surface-dark-muted">
															Default:
															<code class="ml-1 rounded-radius bg-surface-dark-alt px-1.5 py-0.5 font-mono text-xs text-on-surface-dark">{ variable.Default }</code>
														</p>
													}
												</dd>
											</div>
										}
									</dl>
								}
							</section>
						}
					</div>
				</section>
			}
			if overviewHasAdditionalInfo(idx.Overview) {
				<section class="mt-10 overflow-hidden rounded-radius border border-outline bg-surface-alt dark:border-outline-dark dark:bg-surface-dark-alt" aria-labelledby="overview-additional-info-heading">
					<div class="border-b border-outline bg-surface-alt px-4 py-3 dark:border-outline-dark dark:bg-surface-dark-alt">
						<h3 id="overview-additional-info-heading" class="text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Additional Information</h3>
					</div>
					<div class="grid gap-3 p-4">
						if overviewContactHref(idx.Overview.Contact) != "" {
							<a href={ templpkg.URL(overviewContactHref(idx.Overview.Contact)) } class="w-fit text-sm font-medium text-primary underline-offset-4 hover:underline dark:text-primary-dark">{ overviewContactLabel(idx.Overview.Contact) }</a>
						}
						if overviewLicenseLabel(idx.Overview.License) != "" {
							if idx.Overview.License.URL != "" {
								<a href={ templpkg.URL(idx.Overview.License.URL) } class="w-fit text-sm font-medium text-primary underline-offset-4 hover:underline dark:text-primary-dark">{ overviewLicenseLabel(idx.Overview.License) }</a>
							} else {
								<p class="text-sm font-medium text-on-surface dark:text-on-surface-dark">{ overviewLicenseLabel(idx.Overview.License) }</p>
							}
						}
						if idx.Overview.TermsOfService != "" {
							<a href={ templpkg.URL(idx.Overview.TermsOfService) } class="w-fit text-sm font-medium text-primary underline-offset-4 hover:underline dark:text-primary-dark">Terms of Service</a>
						}
					</div>
				</section>
			}
			if hasMarkdown(opts.MarkdownRenderer, idx.Overview.Description) {
				<div class="mt-8 max-w-[70ch]">
					@renderedMarkdown(opts.MarkdownRenderer, idx.Overview.Description)
				</div>
			} else if idx.Overview.Description != "" {
				<div class="manja-markdown mt-8 max-w-[70ch]">
					<p>{ idx.Overview.Description }</p>
				</div>
			}
		</div>
	</section>
}

templ overviewSummary(idx core.SpecIndex) {
	<dl class="grid gap-4 sm:grid-cols-2">
		<div>
			<dt class="text-sm font-medium text-on-surface-muted dark:text-on-surface-dark-muted">Endpoints</dt>
			<dd class="mt-1 font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ pluralizedCount(len(idx.Operations), "endpoint") }</dd>
		</div>
		<div>
			<dt class="text-sm font-medium text-on-surface-muted dark:text-on-surface-dark-muted">Schemas</dt>
			<dd class="mt-1 font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ pluralizedCount(len(idx.Schemas), "schema") }</dd>
		</div>
	</dl>
}

templ overviewIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" class="size-full" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6M9 16h6M8 4h8l3 3v13H5V4h3Z"></path>
	</svg>
}

templ downloadIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"></path>
	</svg>
}

func overviewSidebarItems(selectedAnchor string) []sidebar.Item {
	href := selectedDocsHref("overview")
	return []sidebar.Item{{
		ID:        "overview",
		Label:     "Overview",
		Icon:      overviewIcon(),
		Href:      href,
		Active:    selectedAnchor == "overview",
		LinkAttrs: sidebarNavigationAttrs("Overview", href),
	}}
}

func overviewHasSpecDownload(idx core.SpecIndex) bool {
	return len(idx.SpecDownload.JSON) > 0
}

func overviewSpecFilename(download core.SpecDownload) string {
	filename := strings.TrimSpace(download.Filename)
	if filename == "" {
		return "openapi.json"
	}
	return filename
}

func overviewHasAdditionalInfo(overview core.SpecOverview) bool {
	return overviewContactHref(overview.Contact) != "" || overviewLicenseLabel(overview.License) != "" || overview.TermsOfService != ""
}

func overviewContactHref(contact core.SpecContact) string {
	if strings.TrimSpace(contact.URL) != "" {
		return strings.TrimSpace(contact.URL)
	}
	if strings.TrimSpace(contact.Email) != "" {
		return "mailto:" + strings.TrimSpace(contact.Email)
	}
	return ""
}

func overviewContactLabel(contact core.SpecContact) string {
	return firstNonEmpty(contact.Name, contact.URL, contact.Email, "Contact")
}

func overviewLicenseLabel(license core.SpecLicense) string {
	return firstNonEmpty(license.Name, license.Identifier)
}

func docsBrandingDisplayName(branding core.DocsBranding) string {
	return firstNonEmpty(branding.DisplayName, "Manja")
}

func docsBrandingHomeURL(branding core.DocsBranding) string {
	return firstNonEmpty(branding.Logo.HomeURL, "/")
}

func hasMarkdown(renderer port.MarkdownRenderer, input string) bool {
	return renderer != nil && strings.TrimSpace(input) != ""
}

func renderedMarkdown(renderer port.MarkdownRenderer, input string) templpkg.Component {
	return templpkg.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		result, err := renderer.Render(ctx, input)
		if err != nil {
			return err
		}
		return templpkg.Raw(result.HTML).Render(ctx, w)
	})
}

templ endpointSection(op core.Operation, servers []core.SpecServer, exampleSpecJSON string, opts PublicDocsOptions) {
	{{ opID := operationAnchor(op) }}
	<section id={ opID } class="scroll-mt-24">
		<div class="manja-endpoint-shell-layout">
			<div class="manja-endpoint-main min-w-0">
				<div class="border-b border-outline pb-6 dark:border-outline-dark">
					if op.Deprecated {
						<div class="mb-3 flex flex-wrap items-center gap-2">
							@badge.Badge(badge.Config{Label: "Deprecated", Tone: badge.ToneWarning, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
						</div>
					}
					<div aria-label="Endpoint route" class="mt-4 inline-flex max-w-full items-center gap-3 rounded-radius border border-outline bg-surface-alt px-3 py-2 dark:border-outline-dark dark:bg-surface-dark-alt">
						@methodBadge(op.Method)
						<p class="min-w-0 break-words font-mono text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ op.Path }</p>
					</div>
					if hasMarkdown(opts.MarkdownRenderer, op.Description) {
						<div class="mt-4 max-w-[70ch]">
							@renderedMarkdown(opts.MarkdownRenderer, op.Description)
						</div>
					} else if op.Description != "" {
						<p class="mt-4 max-w-[70ch] text-base leading-6 text-on-surface dark:text-on-surface-dark">{ op.Description }</p>
					}
				</div>
				if operationHasRequest(op) || len(op.Responses) > 0 {
					<div class={ endpointDetailLayoutClass(op) }>
						if operationHasRequest(op) {
							<section class="grid gap-8" aria-label="Request">
								<h4 class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Request</h4>
								@paramGroup(opID, "Path Parameters", parametersIn(op.Parameters, "path"), opts)
								@paramGroup(opID, "Query Parameters", parametersIn(op.Parameters, "query"), opts)
								@paramGroup(opID, "Header Parameters", parametersIn(op.Parameters, "header"), opts)
								if op.RequestBody != nil {
									<section class="grid gap-4" aria-label="Request body">
										<div class="flex flex-wrap items-center gap-2">
											<h5 class="font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Request body</h5>
											if op.RequestBody.Required {
												<span class="text-xs font-semibold text-danger dark:text-danger-dark">required</span>
											}
										</div>
										if op.RequestBody.Description != "" {
											if hasMarkdown(opts.MarkdownRenderer, op.RequestBody.Description) {
												<div class="max-w-[70ch] text-sm">
													@renderedMarkdown(opts.MarkdownRenderer, op.RequestBody.Description)
												</div>
											} else {
												<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ op.RequestBody.Description }</p>
											}
										}
										@mediaTypeList(opID+"-request-body", "Request body", op.RequestBody.MediaTypes, opts)
									</section>
								}
							</section>
						}
						if len(op.Responses) > 0 {
							<section class="manja-endpoint-responses-section grid gap-5" aria-label="Responses">
								<h4 class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Responses</h4>
								<div id={ opID + "-responses" }>
								@tabs.Tabs(responseTabsConfig(opID, op.Responses, exampleSpecJSON, opts))
								</div>
							</section>
						}
					</div>
				}
			</div>
			if operationHasRail(op, servers) {
				<aside class="manja-endpoint-examples-rail" aria-label="Endpoint examples">
					<div class="manja-endpoint-examples-rail-content">
						if requestConfigHasContent(op, servers) {
							@requestComposer(opID, op, servers, exampleSpecJSON)
						}
						for _, snippet := range op.Snippets {
							if !requestComposerOwnsSnippet(op, servers, snippet) {
								@codeExample("Request Sample: "+snippet.Label, snippet.Language, snippet.Code)
							}
						}
						if op.RequestBody != nil && !requestConfigHasBody(op, exampleSpecJSON) {
							for _, media := range op.RequestBody.MediaTypes {
								{{ cfg := mediaSchemaExampleConfig(opID+"-request-body-"+anchorFragment(media.ContentType)+"-example", "Request Example: "+media.ContentType, media, exampleSpecJSON) }}
								if hasSchemaExample(cfg) {
									@schemaExample(cfg)
								}
							}
						}
					</div>
				</aside>
			}
		</div>
	</section>
}

templ requestComposer(opID string, op core.Operation, servers []core.SpecServer, exampleSpecJSON string) {
	{{ server := primarySpecServer(servers) }}
	{{ body := requestConfigBodyFor(op, opID, exampleSpecJSON) }}
	{{ snippet := requestComposerSnippet(op.Snippets) }}
	{{ items := requestConfigAccordionItems(opID, op, server, body) }}
	<div data-manja-request-composer class="grid min-w-0 gap-6">
		if len(items) > 0 {
			<section class="grid min-w-0 gap-2" data-manja-request-config-panel aria-labelledby={ opID + "-request-config-heading" }>
				<p id={ opID + "-request-config-heading" } class="px-1 text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Request configuration</p>
				@accordion.Accordion(accordion.AccordionConfig{
					ID:            opID + "-request-config-accordion",
					Items:         items,
					AllowMultiple: true,
					Appearance:    accordion.AppearanceDefault,
					RootClass:     "min-w-0 shadow-sm",
				})
			</section>
		}
		if snippet.Label != "" || snippet.Code != "" {
			<div data-manja-request-sample class="min-w-0">
				@requestSampleTargetSelect(opID)
				@codeExample("Request Sample: "+requestSampleTargets()[0].Label, snippet.Language, snippet.Code)
			</div>
		}
		@templpkg.JSONScript(opID+"-request-composer-payload", requestComposerPayload(op, server, body))
	</div>
}

templ requestSampleTargetSelect(opID string) {
	<div
		data-manja-request-sample-target
		x-data="{ requestSampleTarget: 'shell:curl' }"
		x-init="$watch('requestSampleTarget', value => $el.dispatchEvent(new CustomEvent('manja-request-sample-target-change', { detail: { value: value }, bubbles: true })))"
		class="mb-2 max-w-xs"
	>
		@selectfield.Select(selectfield.Config{
			ID:          opID + "-request-sample-target",
			Name:        "requestSampleTarget",
			Placeholder: "Request sample",
			Options:     requestSampleTargetOptions(),
			Alpine:      &selectfield.AlpineConfig{Model: "requestSampleTarget"},
			RootClass:   "w-full",
		})
	</div>
}

func requestConfigAccordionItems(opID string, op core.Operation, server core.SpecServer, body requestConfigBody) []accordion.AccordionItem {
	items := make([]accordion.AccordionItem, 0, 4)
	if fields := requestServerVariableFields(server); len(fields) > 0 {
		items = append(items, accordion.AccordionItem{
			ID:                opID + "-server-variables",
			Title:             "Server Variables",
			Content:           requestConfigFieldsContent(fields, "server"),
			InitiallyExpanded: true,
		})
	}
	if fields := requestParameterFields(op.Parameters); len(fields) > 0 {
		items = append(items, accordion.AccordionItem{
			ID:                opID + "-parameters",
			Title:             "Parameters",
			Content:           requestConfigFieldsContent(fields, "parameters"),
			InitiallyExpanded: true,
		})
	}
	if len(op.Security) > 0 {
		items = append(items, accordion.AccordionItem{
			ID:                opID + "-security",
			Title:             "Security",
			Content:           requestSecurityContent(op.Security),
			InitiallyExpanded: true,
		})
	}
	if body.Has {
		items = append(items, accordion.AccordionItem{
			ID:                opID + "-body",
			Title:             "Body",
			Content:           requestConfigBodyContent(opID, body.Config),
			InitiallyExpanded: true,
		})
	}
	return items
}

templ requestConfigFieldsContent(fields []schemaform.Field, namePrefix string) {
	<div class="manja-request-config-fields">
		@schemaform.Fields(schemaform.FieldsConfig{
			Fields:     fields,
			NamePrefix: namePrefix,
		})
	</div>
}

templ requestSecurityContent(security []core.OperationSecurity) {
	<div class="grid gap-3 text-sm">
		for _, item := range security {
			<div class="grid grid-cols-[6rem_1rem_minmax(0,1fr)] gap-2">
				<span class="truncate font-mono text-on-surface-strong dark:text-on-surface-dark-strong">security</span>
				<span class="text-on-surface-muted dark:text-on-surface-dark-muted">:</span>
				<span class="truncate text-on-surface-muted dark:text-on-surface-dark-muted">{ securityLabel(item) }</span>
			</div>
		}
	</div>
}

templ requestConfigBodyContent(opID string, cfg ExampleConfig) {
	<div class="grid gap-2" data-manja-request-config-body>
		<label class="sr-only" for={ opID + "-request-body-input" }>Request body JSON</label>
		<div class="manja-request-body-editor relative" data-manja-request-body-editor>
			<pre aria-hidden="true" class="codeblock manja-request-body-highlight pointer-events-none absolute inset-0 min-h-48 overflow-hidden whitespace-pre-wrap break-words rounded-radius border border-transparent px-3 py-2 font-mono text-xs leading-5"><code data-manja-request-body-highlight></code></pre>
			<textarea
				id={ opID + "-request-body-input" }
				data-manja-request-body-input
				spellcheck="false"
				rows="10"
				class="relative min-h-48 w-full resize-y rounded-radius border border-outline bg-surface px-3 py-2 font-mono text-xs leading-5 text-on-surface-strong outline-none placeholder:text-on-surface-muted focus:ring-2 focus:ring-primary dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-strong dark:placeholder:text-on-surface-dark-muted dark:focus:ring-primary-dark"
			>{ exampleFallback(cfg) }</textarea>
		</div>
		@templpkg.JSONScript(opID+"-request-body-payload", schemaExamplePayload(cfg))
		<p data-manja-request-body-status class="sr-only" aria-live="polite"></p>
	</div>
}

templ schemaSection(schema core.Schema, exampleSpecJSON string, opts PublicDocsOptions) {
	{{ summary := schema.Summary }}
	if summary.Name == "" {
		{{ summary.Name = schema.Name }}
	}
	if summary.Description == "" {
		{{ summary.Description = schema.Description }}
	}
	<section id={ schemaAnchor(schema) } class="scroll-mt-24">
		<div class="max-w-3xl border-b border-outline pb-8 dark:border-outline-dark">
			<p class="font-mono text-sm font-semibold uppercase text-on-surface-muted dark:text-on-surface-dark-muted">Schema</p>
			if summary.Description != "" {
				if hasMarkdown(opts.MarkdownRenderer, summary.Description) {
					<div class="mt-6 max-w-[70ch]">
						@renderedMarkdown(opts.MarkdownRenderer, summary.Description)
					</div>
				} else {
					<p class="mt-6 max-w-[70ch] text-base leading-7 text-on-surface dark:text-on-surface-dark">{ summary.Description }</p>
				}
			}
		</div>
		{{ cfg := schemaPageExampleConfig(schema, exampleSpecJSON) }}
		if hasSchemaExample(cfg) {
			<div class="manja-schema-detail-layout">
				<div class="manja-schema-tree-panel">
					@schemaTree(schemaAnchor(schema)+"-tree", schema.Name, summary, opts)
				</div>
				<aside class="manja-schema-example-panel" aria-label="Schema example">
					@schemaExample(cfg)
				</aside>
			</div>
		} else {
			@schemaTree(schemaAnchor(schema)+"-tree", schema.Name, summary, opts)
		}
	</section>
}

templ responsePanel(opID string, response core.OperationResponse, exampleSpecJSON string, opts PublicDocsOptions) {
	<section class="grid gap-4">
		if response.Description != "" {
			if hasMarkdown(opts.MarkdownRenderer, response.Description) {
				<div class="max-w-[70ch]">
					@renderedMarkdown(opts.MarkdownRenderer, response.Description)
				</div>
			} else {
				<p class="text-base font-medium text-on-surface dark:text-on-surface-dark">{ response.Description }</p>
			}
		}
		@responseMediaTypeList(opID, response, exampleSpecJSON, opts)
	</section>
}

templ mediaTypeList(idPrefix string, label string, mediaTypes []core.OperationMediaType, opts PublicDocsOptions) {
	if len(mediaTypes) > 0 {
		<div class="grid gap-4">
			for _, media := range mediaTypes {
				<div class="border-t border-outline pt-6 pb-5 dark:border-outline-dark">
					<div class="flex flex-wrap items-center gap-3">
						<span class="font-mono text-xs font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ media.ContentType }</span>
						if schemaInline(media.Schema) != "" {
							<span class="font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ schemaInline(media.Schema) }</span>
						}
					</div>
					@schemaProperties(mediaTypeTableID(idPrefix, media), label+" schema for "+media.ContentType, media.Schema, opts)
				</div>
			}
		</div>
	}
}

templ responseMediaTypeList(opID string, response core.OperationResponse, exampleSpecJSON string, opts PublicDocsOptions) {
	if len(response.MediaTypes) > 0 {
		<div class="grid gap-4">
			for _, media := range response.MediaTypes {
				{{ idPrefix := opID+"-response-"+anchorFragment(response.Status) }}
				{{ cfg := mediaSchemaExampleConfig(idPrefix+"-"+anchorFragment(media.ContentType)+"-example", "Response Example: "+response.Status+" "+media.ContentType, media, exampleSpecJSON) }}
				<div class="manja-response-media-block border-t border-outline pt-6 pb-5 dark:border-outline-dark">
					<div class="manja-response-panel-layout">
						<div class="manja-response-panel-main grid gap-4">
							<div class="flex flex-wrap items-center gap-3">
								<span class="font-mono text-xs font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ media.ContentType }</span>
							if schemaInline(media.Schema) != "" {
								<span class="font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ schemaInline(media.Schema) }</span>
							}
						</div>
						@schemaProperties(mediaTypeTableID(idPrefix, media), "Response "+response.Status+" schema for "+media.ContentType, media.Schema, opts)
					</div>
						if hasSchemaExample(cfg) {
							<aside class="manja-response-panel-example" aria-label={ "Response " + response.Status + " " + media.ContentType + " example" }>
								@schemaExample(cfg)
							</aside>
						}
					</div>
				</div>
			}
		</div>
	}
}

templ paramGroup(idPrefix string, title string, parameters []core.OperationParameter, opts PublicDocsOptions) {
	if len(parameters) > 0 {
		<section class="grid gap-4">
			<h5 class="font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h5>
			<div>
				@table.Table(parameterTableConfig(idPrefix, title, parameters, opts.MarkdownRenderer))
			</div>
		</section>
	}
}

templ schemaProperties(id string, caption string, schema core.SchemaSummary, opts PublicDocsOptions) {
	if schemaTreeHasContent(schema) {
		<div class="mt-4">
			@schemaTree(id, caption, schema, opts)
		</div>
	}
}

templ schemaTree(id string, caption string, schema core.SchemaSummary, opts PublicDocsOptions) {
	<section id={ id } aria-label={ caption + " schema tree" } class="manja-schema-tree">
		if schemaTreeExpandable(schema) {
			<div class="manja-schema-root">
				@schemaTreeChildNodes(schema, opts)
			</div>
		} else {
			@schemaTreeNode(schemaTreeRootName(caption, schema), false, schema, true, opts)
		}
	</section>
}

templ schemaTreeNode(name string, required bool, schema core.SchemaSummary, root bool, opts PublicDocsOptions) {
	{{ displayName := schemaTreeDisplayName(name, schema) }}
	if schemaTreeExpandable(schema) {
		if root {
			<details open data-schema-tree-node={ displayName } class="manja-schema-node manja-schema-node-root">
				@schemaTreeSummary(displayName, required, schema, opts)
				@schemaTreeChildren(schema, opts)
			</details>
		} else {
			<details open data-schema-tree-row={ displayName } class="manja-schema-node">
				@schemaTreeSummary(displayName, required, schema, opts)
				@schemaTreeChildren(schema, opts)
			</details>
		}
	} else {
		if root {
			<div data-schema-tree-node={ displayName } class="manja-schema-node manja-schema-node-root">
				<div class="manja-schema-row">
					<span class="manja-schema-branch" aria-hidden="true"></span>
					@schemaTreeLabel(displayName, schema, opts)
					@schemaTreeRequired(required)
				</div>
			</div>
		} else {
			<div data-schema-tree-row={ displayName } class="manja-schema-node">
				<div class="manja-schema-row">
					<span class="manja-schema-branch" aria-hidden="true"></span>
					@schemaTreeLabel(displayName, schema, opts)
					@schemaTreeRequired(required)
				</div>
			</div>
		}
	}
}

templ schemaTreeSummary(name string, required bool, schema core.SchemaSummary, opts PublicDocsOptions) {
	<summary class="manja-schema-row">
		<span class="manja-schema-branch" aria-hidden="true"></span>
		<span class="manja-schema-caret" aria-hidden="true"></span>
		@schemaTreeLabel(name, schema, opts)
		@schemaTreeRequired(required)
	</summary>
}

templ schemaTreeLabel(name string, schema core.SchemaSummary, opts PublicDocsOptions) {
	<div class="manja-schema-label">
		<div class="manja-schema-heading">
			<span class="manja-schema-name">{ name }</span>
			if schemaInline(schema) != "" {
				<span class="manja-schema-type">{ schemaInline(schema) }</span>
			}
		</div>
		if schema.Description != "" {
			if hasMarkdown(opts.MarkdownRenderer, schema.Description) {
				<div class="manja-schema-description">
					@renderedMarkdown(opts.MarkdownRenderer, schema.Description)
				</div>
			} else {
				<p class="manja-schema-description">{ schema.Description }</p>
			}
		}
		if schema.Example != "" {
			if schemaTreeExampleBlock(schema.Example) {
				<div class="manja-schema-example manja-schema-example-block">
					<span>Example:</span>
					<pre><code>{ schema.Example }</code></pre>
				</div>
			} else {
				<p class="manja-schema-example manja-schema-example-inline">
					<span>Example:</span>
					<code>{ schema.Example }</code>
				</p>
			}
		}
	</div>
}

templ schemaTreeRequired(required bool) {
	if required {
		<span class="manja-schema-required">required</span>
	}
}

templ schemaTreeChildren(schema core.SchemaSummary, opts PublicDocsOptions) {
	<div class="manja-schema-children">
		@schemaTreeChildNodes(schema, opts)
	</div>
}

templ schemaTreeChildNodes(schema core.SchemaSummary, opts PublicDocsOptions) {
	if schema.Items != nil && schemaTreeExpandable(*schema.Items) {
		@schemaTreeNode("items", false, *schema.Items, false, opts)
	}
	for _, property := range schema.Properties {
		@schemaTreeNode(property.Name, property.Required, property.Schema, false, opts)
	}
}

templ codeExample(label string, language string, code string) {
	@codeblock.CodeBlock(codeblock.Config{
		Label:     label,
		Language:  language,
		Code:      code,
		MaxHeight: "24rem",
	})
}

templ schemaExample(cfg ExampleConfig) {
	<div id={ cfg.ID } data-manja-example>
		@codeblock.CodeBlock(codeblock.Config{
			ID: cfg.ID+"-code",
			Label: cfg.Label,
			Language: exampleLanguage(cfg),
			Code: exampleFallback(cfg),
			MaxHeight: "24rem",
		})
		@templpkg.JSONScript(cfg.ID+"-payload", schemaExamplePayload(cfg))
		<p data-manja-example-status class="sr-only" aria-live="polite"></p>
	</div>
}

templ docsSearchField(docs []core.SearchDocument) {
	<div class="shrink-0 px-4 py-3" aria-label="Documentation search">
		@searchfield.SearchField(docsSearchConfig(docs))
	</div>
}

templ docsSearchOpenSlot() {
	<div class="shrink-0 px-4 py-3" aria-label="Documentation search">
		<button
			type="button"
			class="flex min-h-10 w-full items-center gap-2 rounded-radius border border-outline bg-surface px-3 text-left text-sm text-on-surface-muted transition hover:border-outline-strong hover:text-on-surface-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark/50 dark:text-on-surface-dark-muted dark:hover:border-outline-dark-strong dark:hover:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark"
			x-on:click="window.dispatchEvent(new CustomEvent('goshtoso-search-open', { detail: { id: 'docs-search' } }))"
			aria-haspopup="dialog"
			aria-controls="docs-search-dialog"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" class="size-5 shrink-0" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
			</svg>
			<span class="min-w-0 flex-1 truncate">Search docs</span>
		</button>
	</div>
}

func docsSearchConfig(docs []core.SearchDocument) searchfield.Config {
	return searchfield.Config{
		ID:             docsSearchID,
		Label:          "Search docs",
		Placeholder:    "Search operations and schemas",
		GlobalShortcut: true,
		ItemsURL:       "/search.json",
		MaxResults:     8,
		EmptyText:      "No operations or schemas found.",
	}
}

func responseTabsConfig(opID string, responses []core.OperationResponse, exampleSpecJSON string, opts PublicDocsOptions) tabs.Config {
	tabItems := make([]tabs.Tab, 0, len(responses))
	for _, response := range responses {
		tabItems = append(tabItems, tabs.Tab{
			ID:        responseTabID(response),
			Label:     response.Status,
			LabelSlot: responseStatusBadge(response.Status),
			Content:   responsePanel(opID, response, exampleSpecJSON, opts),
		})
	}
	cfg := tabs.Config{
		ID:        opID + "-responses",
		Tabs:      tabItems,
		RootClass: "manja-response-tabs",
	}
	if len(responses) > 0 {
		cfg.DefaultTab = responseTabID(responses[0])
	}
	return cfg
}

func responseTabID(response core.OperationResponse) string {
	id := anchorFragment(response.Status)
	if id == "" {
		id = "default"
	}
	return "response-" + id
}

templ parameterDescriptionCell(renderer port.MarkdownRenderer, description string, example string) {
	if strings.TrimSpace(description) != "" {
		if hasMarkdown(renderer, description) {
			@renderedMarkdown(renderer, description)
		} else {
			<p>{ description }</p>
		}
	}
	if strings.TrimSpace(example) != "" {
		<p class="mt-2 text-xs text-on-surface-muted dark:text-on-surface-dark-muted">
			Example:
			<code class="ml-1 rounded-radius bg-surface-alt px-1.5 py-0.5 font-mono text-xs text-on-surface-strong dark:bg-surface-dark-alt dark:text-on-surface-dark-strong">{ example }</code>
		</p>
	}
}

func parameterTableConfig(idPrefix string, title string, parameters []core.OperationParameter, renderer port.MarkdownRenderer) table.Config {
	rows := make([]table.Row, 0, len(parameters))
	for _, param := range parameters {
		required := "optional"
		requiredColor := "neutral"
		if param.Required {
			required = "required"
			requiredColor = "danger"
		}
		description := param.Description
		if param.Example != "" {
			if description != "" {
				description += " "
			}
			description += "Example: " + param.Example
		}
		descriptionCell := table.Cell{Text: description}
		if renderer != nil && (strings.TrimSpace(param.Description) != "" || strings.TrimSpace(param.Example) != "") {
			descriptionCell = table.Cell{Component: parameterDescriptionCell(renderer, param.Description, param.Example)}
		}
		rows = append(rows, table.Row{
			ID: idPrefix + "-" + anchorFragment(title) + "-" + anchorFragment(param.In+"-"+param.Name),
			Cells: map[string]table.Cell{
				"name":        {Text: param.Name, Code: true},
				"in":          {Text: param.In, Code: true},
				"type":        {Text: firstNonEmpty(schemaInline(param.Schema), param.In), Code: true},
				"requirement": {Text: required, BadgeColor: requiredColor},
				"description": descriptionCell,
			},
		})
	}
	return table.Config{
		ID:      idPrefix + "-" + anchorFragment(title),
		Caption: title,
		Columns: []table.Column{
			{Key: "name", Label: "Name", Width: "min-w-[8rem]"},
			{Key: "in", Label: "In", Width: "w-24"},
			{Key: "type", Label: "Type", Width: "min-w-[8rem]"},
			{Key: "requirement", Label: "Required", Width: "w-28"},
			{Key: "description", Label: "Description"},
		},
		Rows:      rows,
		RootClass: "text-sm",
	}
}

func mediaTypeTableID(idPrefix string, media core.OperationMediaType) string {
	contentType := anchorFragment(media.ContentType)
	if contentType == "" {
		contentType = "media"
	}
	return idPrefix + "-" + contentType + "-schema"
}

func mediaSchemaExampleConfig(id string, label string, media core.OperationMediaType, specJSON string) ExampleConfig {
	return ExampleConfig{
		ID:          id,
		Label:       label,
		Language:    "json",
		SchemaJSON:  media.Schema.JSON,
		ExampleJSON: media.Example,
		ExplicitExample: media.ExampleProvided,
		SpecJSON:    specJSON,
		Options:     defaultExampleOptions(),
	}
}

func schemaPageExampleConfig(schema core.Schema, specJSON string) ExampleConfig {
	return ExampleConfig{
		ID:          schemaAnchor(schema) + "-example",
		Label:       "Example: " + schema.Name,
		Language:    "json",
		SchemaJSON:  schema.Example.JSON,
		ExampleJSON: schema.Example.Example,
		ExplicitExample: schema.Example.Provided,
		SpecJSON:    specJSON,
		Options: ExampleOptions{
			SkipNonRequired: false,
			Quiet:           true,
			MaxSampleDepth:  4,
		},
	}
}

func defaultExampleOptions() ExampleOptions {
	return ExampleOptions{
		SkipNonRequired: false,
		Quiet:           true,
		MaxSampleDepth:  3,
	}
}

func hasSchemaExample(cfg ExampleConfig) bool {
	return strings.TrimSpace(cfg.SchemaJSON) != "" || strings.TrimSpace(cfg.ExampleJSON) != ""
}

func exampleLanguage(cfg ExampleConfig) string {
	if strings.TrimSpace(cfg.Language) != "" {
		return cfg.Language
	}
	return "json"
}

func exampleFallback(cfg ExampleConfig) string {
	if strings.TrimSpace(cfg.ExampleJSON) != "" {
		return cfg.ExampleJSON
	}
	return "Example unavailable"
}

func schemaExamplePayload(cfg ExampleConfig) map[string]any {
	payload := map[string]any{
		"options": cfg.Options,
	}
	if cfg.ExplicitExample && strings.TrimSpace(cfg.ExampleJSON) != "" {
		payload["hasExplicitExample"] = true
	}
	var schema any
	if strings.TrimSpace(cfg.SchemaJSON) != "" {
		if err := json.Unmarshal([]byte(cfg.SchemaJSON), &schema); err != nil {
			schema = nil
		}
	}
	payload["schema"] = schema
	if strings.TrimSpace(cfg.SpecJSON) != "" {
		var spec any
		if err := json.Unmarshal([]byte(cfg.SpecJSON), &spec); err == nil {
			payload["spec"] = spec
		}
	}
	return payload
}

func sidebarSections(idx core.SpecIndex, selectedAnchor string, labelMode EndpointSidebarLabelMode, idPrefix string) []sidebar.Section {
	sections := make([]sidebar.Section, 0, 2)
	if len(idx.Operations) > 0 {
		tagOrder := make([]string, 0)
		tagItems := map[string][]sidebar.Item{}
		tagOpen := map[string]bool{}
		for _, op := range idx.Operations {
			tags := op.Tags
			if len(tags) == 0 {
				tags = []string{"Untagged"}
			}
			for _, tag := range tags {
				tag = strings.TrimSpace(tag)
				if tag == "" {
					tag = "Untagged"
				}
				if _, ok := tagItems[tag]; !ok {
					tagOrder = append(tagOrder, tag)
				}
				anchor := operationAnchor(op)
				active := anchor == selectedAnchor
				if active {
					tagOpen[tag] = true
				}
				label := operationSidebarLabel(op, labelMode)
				href := selectedDocsHref(anchor)
				tagItems[tag] = append(tagItems[tag], sidebar.Item{
					ID:         sidebarItemID(idPrefix, anchor),
					Label:      label,
					Href:       href,
					Active:     active,
					Badge:      op.Method,
					LinkAttrs:  sidebarNavigationAttrs(label, href),
				})
			}
		}
		items := make([]sidebar.Item, 0, len(tagOrder))
		for _, tag := range tagOrder {
			items = append(items, sidebar.Item{
				ID:        sidebarItemID(idPrefix, "tag-"+anchorFragment(tag)),
				Label:     tag,
				Href:      "#",
				Open:      tagOpen[tag],
				Items:     tagItems[tag],
				LinkAttrs: sidebarTagAttrs(tag),
			})
		}
		sections = append(sections, sidebar.Section{Title: "Operations", Collapsible: true, Items: items})
	}
	if len(idx.Schemas) > 0 {
		items := make([]sidebar.Item, 0, len(idx.Schemas))
		for _, schema := range idx.Schemas {
			anchor := schemaAnchor(schema)
			label := schemaSidebarLabel(schema)
			href := selectedDocsHref(anchor)
			items = append(items, sidebar.Item{
				ID:        sidebarItemID(idPrefix, anchor),
				Label:     label,
				Href:      href,
				Active:    anchor == selectedAnchor,
				LinkAttrs: sidebarNavigationAttrs(label, href),
			})
		}
		sections = append(sections, sidebar.Section{Title: "Schemas", Items: items, IndentItems: true})
	}
	return sections
}

func sidebarItemID(prefix string, id string) string {
	prefix = strings.TrimSpace(prefix)
	if prefix == "" {
		return id
	}
	return prefix + "-" + id
}

func selectedDocsItemFor(idx core.SpecIndex, selectedID string) selectedDocsItem {
	selectedID = strings.TrimPrefix(strings.TrimSpace(selectedID), "#")
	if selectedID == "" || selectedID == "overview" {
		return selectedDocsItem{Anchor: "overview", Kind: "overview"}
	}
	for _, op := range idx.Operations {
		anchor := operationAnchor(op)
		if anchor == selectedID {
			return selectedDocsItem{Anchor: anchor, Kind: "operation", Operation: op}
		}
	}
	for _, schema := range idx.Schemas {
		anchor := schemaAnchor(schema)
		if anchor == selectedID {
			return selectedDocsItem{Anchor: anchor, Kind: "schema", Schema: schema}
		}
	}
	return selectedDocsItem{Anchor: selectedID, Kind: "missing"}
}

func publicDocsPageTitle(idx core.SpecIndex, selected selectedDocsItem) string {
	switch selected.Kind {
	case "operation":
		return operationTitle(selected.Operation)
	case "schema":
		return selected.Schema.Name
	case "missing":
		return "Documentation not found"
	default:
		return firstNonEmpty(idx.Title, "OpenAPI documentation")
	}
}

func publicDocsPageDescription(idx core.SpecIndex, selected selectedDocsItem) string {
	switch selected.Kind {
	case "operation":
		return strings.TrimSpace(strings.ToUpper(selected.Operation.Method) + " " + selected.Operation.Path)
	case "schema":
		return "Schema reference"
	case "missing":
		return "The requested documentation is not part of this contract."
	default:
		if idx.Version != "" {
			return "OpenAPI " + idx.Version
		}
		return "OpenAPI contract overview"
	}
}

func publicDocsDocumentTitle(idx core.SpecIndex, selected selectedDocsItem) string {
	pageTitle := publicDocsPageTitle(idx, selected)
	contractTitle := firstNonEmpty(idx.Title, "Manja")
	if pageTitle == contractTitle {
		return contractTitle
	}
	return pageTitle + " · " + contractTitle
}

func operationBreadcrumbItems(idx core.SpecIndex, op core.Operation, fallbackAnchor string) []breadcrumbs.Item {
	items := []breadcrumbs.Item{{
		Label: "Home",
		Href:  selectedDocsHref("overview"),
	}}
	tag := operationBreadcrumbTag(op)
	if tag != "" {
		items = append(items, breadcrumbs.Item{
			Label: tag,
			Href:  operationTagBreadcrumbHref(idx, tag, fallbackAnchor),
		})
	}
	return items
}

func operationBreadcrumbTag(op core.Operation) string {
	for _, tag := range op.Tags {
		if tag = strings.TrimSpace(tag); tag != "" {
			return tag
		}
	}
	return "Untagged"
}

func operationTagBreadcrumbHref(idx core.SpecIndex, tag string, fallbackAnchor string) string {
	tag = strings.TrimSpace(tag)
	for _, op := range idx.Operations {
		tags := op.Tags
		if len(tags) == 0 {
			tags = []string{"Untagged"}
		}
		for _, opTag := range tags {
			if strings.EqualFold(strings.TrimSpace(opTag), tag) {
				return selectedDocsHref(operationAnchor(op))
			}
		}
	}
	return selectedDocsHref(fallbackAnchor)
}

func selectedDocsHref(anchor string) string {
	anchor = strings.TrimPrefix(strings.TrimSpace(anchor), "#")
	if anchor == "" {
		return "/"
	}
	return "/?selected=" + url.QueryEscape(anchor) + "#" + anchor
}

func selectedDocsHrefFromDoc(href string) string {
	anchor, ok := strings.CutPrefix(strings.TrimSpace(href), "#")
	if !ok {
		return href
	}
	return selectedDocsHref(anchor)
}

func sidebarTitleAttrs(label string) templpkg.Attributes {
	label = strings.TrimSpace(label)
	if label == "" {
		return nil
	}
	return templpkg.Attributes{"title": label}
}

func sidebarTagAttrs(label string) templpkg.Attributes {
	attrs := sidebarTitleAttrs(label)
	if attrs == nil {
		attrs = templpkg.Attributes{}
	}
	attrs["data-manja-sidebar-tag"] = "true"
	return attrs
}

func sidebarNavigationAttrs(label string, href string) templpkg.Attributes {
	attrs := sidebarTitleAttrs(label)
	if attrs == nil {
		attrs = templpkg.Attributes{}
	}
	href = strings.TrimSpace(href)
	if href == "" || !strings.HasPrefix(href, "/") {
		return attrs
	}
	attrs["hx-get"] = href
	attrs["hx-target"] = "#main-content"
	attrs["hx-swap"] = "innerHTML swap:120ms settle:240ms"
	attrs["hx-push-url"] = "true"
	attrs["hx-indicator"] = "#public-docs-loading"
	attrs["data-manja-sidebar-nav"] = "true"
	return attrs
}

func firstSidebarHref(items []sidebar.Item) string {
	for _, item := range items {
		if item.Href != "" {
			return item.Href
		}
	}
	return "/"
}

templ methodBadge(method string) {
	@badge.Badge(badge.Config{
		Label:     strings.ToUpper(strings.TrimSpace(method)),
		Tone:      methodBadgeTone(method),
		Size:      badge.SizeSM,
		RootClass: "font-mono font-bold",
	})
}

func methodBadgeTone(method string) badge.Tone {
	switch strings.ToUpper(strings.TrimSpace(method)) {
	case "GET":
		return badge.TonePrimary
	case "POST":
		return badge.ToneSuccess
	case "PUT":
		return badge.ToneWarning
	case "PATCH":
		return badge.ToneWarning
	case "DELETE":
		return badge.ToneDanger
	default:
		return badge.ToneDefault
	}
}

