		{Value: "swift:urlsession", Label: "Swift / URLSession", Target: "swift", Client: "urlsession", Language: "swift"},
		{Value: "kotlin:okhttp", Label: "Kotlin / OkHttp", Target: "kotlin", Client: "okhttp", Language: "kotlin"},
		{Value: "http:http1.1", Label: "HTTP / HTTP/1.1", Target: "http", Client: "http1.1", Language: "http"},
		{Value: "c:libcurl", Label: "C / Libcurl", Target: "c", Client: "libcurl", Language: "c"},
		{Value: "clojure:clj_http", Label: "Clojure / clj-http", Target: "clojure", Client: "clj_http", Language: "clojure"},
		{Value: "objc:nsurlsession", Label: "Objective-C / NSURLSession", Target: "objc", Client: "nsurlsession", Language: "objc"},
		{Value: "ocaml:cohttp", Label: "OCaml / CoHTTP", Target: "ocaml", Client: "cohttp", Language: "ocaml"},
		{Value: "r:httr", Label: "R / httr", Target: "r", Client: "httr", Language: "r"},
	}
}

func requestSampleTargetOptions() []selectfield.Option {
	targets := requestSampleTargets()
	options := make([]selectfield.Option, 0, len(targets))
	for i, target := range targets {
		options = append(options, selectfield.Option{
			Value:    target.Value,
			Label:    target.Label,
			Selected: i == 0,
		})
	}
	return options
}

func requestSampleTargetsPayload() []map[string]string {
	targets := requestSampleTargets()
	payload := make([]map[string]string, 0, len(targets))
	for _, target := range targets {
		payload = append(payload, map[string]string{
			"value":    target.Value,
			"label":    target.Label,
			"target":   target.Target,
			"client":   target.Client,
			"language": target.Language,
		})
	}
	return payload
}

func requestComposerURLTemplate(server core.SpecServer, op core.Operation) string {
	base := strings.TrimRight(server.URL, "/")
	if base == "" {
		return op.Path
	}
	return base + op.Path
}

func requestComposerParameters(parameters []core.OperationParameter) []map[string]string {
	result := make([]map[string]string, 0, len(parameters))
	for _, param := range parameters {
		result = append(result, map[string]string{
			"name":      param.Name,
			"in":        strings.ToLower(param.In),
			"fieldName": "parameters." + param.Name,
		})
	}
	return result
}

func requestComposerSnippet(snippets []core.RequestSnippet) core.RequestSnippet {
	for _, snippet := range snippets {
		if strings.EqualFold(snippet.Label, "curl") || strings.EqualFold(snippet.Language, "shell") || strings.EqualFold(snippet.Language, "bash") {
			return snippet
		}
	}
	return core.RequestSnippet{}
}

func requestComposerOwnsSnippet(op core.Operation, servers []core.SpecServer, snippet core.RequestSnippet) bool {
	if !requestConfigHasContent(op, servers) {
		return false
	}
	owned := requestComposerSnippet(op.Snippets)
	return owned.Label == snippet.Label && owned.Language == snippet.Language && owned.Code == snippet.Code
}

func operationHasRequest(op core.Operation) bool {
	return len(op.Security) > 0 || len(op.Parameters) > 0 || op.RequestBody != nil
}

func endpointDetailLayoutClass(op core.Operation) string {
	classes := "manja-endpoint-detail-layout"
	if !operationHasRequest(op) || len(op.Responses) == 0 {
		classes += " manja-endpoint-detail-layout-single"
	}
	return classes
}

func parametersIn(parameters []core.OperationParameter, location string) []core.OperationParameter {
	filtered := make([]core.OperationParameter, 0)
	for _, parameter := range parameters {
		if strings.EqualFold(parameter.In, location) {
			filtered = append(filtered, parameter)
		}
	}
	return filtered
}

templ responseStatusBadge(status string) {
	@badge.Badge(badge.Config{
		Label:     status,
		Tone:      responseBadgeTone(status),
		RootClass: "font-mono font-bold",
	})
}

func responseBadgeTone(status string) badge.Tone {
	trimmed := strings.TrimSpace(status)
	if strings.HasPrefix(trimmed, "2") {
		return badge.ToneSuccess
	}
	if strings.HasPrefix(trimmed, "3") {
		return badge.TonePrimary
	}
	if strings.HasPrefix(trimmed, "4") {
		return badge.ToneWarning
	}
	if strings.HasPrefix(trimmed, "5") {
		return badge.ToneDanger
	}
	return badge.ToneDefault
}

func requiredMark(required bool) string {
	if required {
		return "*"
	}
	return ""
}

func firstNonEmpty(values ...string) string {
	for _, value := range values {
		if strings.TrimSpace(value) != "" {
			return value
		}
	}
	return ""
}

func anchorFragment(value string) string {
	var builder strings.Builder
	lastWasSeparator := false
	for _, r := range strings.ToLower(value) {
		switch {
		case r >= 'a' && r <= 'z':
			builder.WriteRune(r)
			lastWasSeparator = false
		case r >= '0' && r <= '9':
			builder.WriteRune(r)
			lastWasSeparator = false
		default:
			if builder.Len() > 0 && !lastWasSeparator {
				builder.WriteByte('-')
				lastWasSeparator = true
			}
		}
	}
	return strings.Trim(builder.String(), "-")
}
