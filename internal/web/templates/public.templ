package templates

import (
	"encoding/json"
	"net/url"
	"strconv"
	"strings"

	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/breadcrumbs"
	"github.com/araihu/goshtoso/components/codeblock"
	searchfield "github.com/araihu/goshtoso/components/search"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/goshtoso/components/sidebar"
	"github.com/araihu/goshtoso/components/table"
	"github.com/araihu/goshtoso/components/tabs"

	"github.com/araihu/manja/internal/core"
)

type selectedDocsItem struct {
	Anchor    string
	Kind      string
	Operation core.Operation
	Schema    core.Schema
}

type EndpointSidebarLabelMode string

const (
	EndpointSidebarLabelAuto EndpointSidebarLabelMode = "auto"
	EndpointSidebarLabelPath EndpointSidebarLabelMode = "path"
)

type PublicDocsOptions struct {
	EndpointSidebarLabel EndpointSidebarLabelMode
}

func (opts PublicDocsOptions) withDefaults() PublicDocsOptions {
	switch opts.EndpointSidebarLabel {
	case EndpointSidebarLabelPath:
		return opts
	default:
		opts.EndpointSidebarLabel = EndpointSidebarLabelAuto
		return opts
	}
}

type ExampleOptions struct {
	SkipNonRequired bool `json:"skipNonRequired"`
	Quiet           bool `json:"quiet"`
	MaxSampleDepth  int  `json:"maxSampleDepth"`
}

type ExampleConfig struct {
	ID              string
	Label           string
	Language        string
	SchemaJSON      string
	ExampleJSON     string
	ExplicitExample bool
	SpecJSON        string
	Options         ExampleOptions
}

templ PublicDocs(idx core.SpecIndex, selectedID string) {
	@PublicDocsWithOptions(idx, selectedID, PublicDocsOptions{})
}

templ PublicDocsWithOptions(idx core.SpecIndex, selectedID string, opts PublicDocsOptions) {
	{{ opts = opts.withDefaults() }}
	{{ selected := selectedDocsItemFor(idx, selectedID) }}
	@Layout(idx.Title) {
		<div class="h-screen overflow-hidden bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			<header class="manja-docs-header sticky top-0 z-50 border-b border-outline bg-surface dark:border-outline-dark dark:bg-surface-dark">
				<div class="flex h-16 items-center justify-between gap-3 px-4 lg:px-8">
					<a href="/" class="flex items-center gap-2 text-2xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">
						<span>Manja</span>
					</a>
					<div class="flex min-w-0 items-center gap-3 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
						<div class="manja-theme-select shrink-0">
							@selectfield.Select(selectfield.Config{
								ID:             "manja-theme",
								Name:           "theme",
								Alpine:         &selectfield.AlpineConfig{Model: "theme"},
								TriggerLeading: themeSelectIcon(),
								Options:        themeOptions(),
							})
						</div>
						@themeToggle()
						<span class="hidden md:inline">OpenAPI docs</span>
						if idx.Version != "" {
							<span class="hidden rounded-radius border border-outline px-2 py-1 font-mono text-xs text-on-surface-strong dark:border-outline-dark dark:text-on-surface-dark-strong sm:inline">v{ idx.Version }</span>
						}
					</div>
				</div>
			</header>
			<div class="flex h-[calc(100vh-4rem)] overflow-hidden">
				<aside class="hidden h-[calc(100vh-4rem)] w-72 shrink-0 lg:block" aria-label="API sections">
					<div id="sidebar-nav-content" class="h-full">
						@publicDocsSidebar(idx, selected, opts)
					</div>
				</aside>
				<main class="min-w-0 flex-1 overflow-x-hidden overflow-y-auto p-6 lg:px-10 lg:py-8">
					<div id="main-content" class="mx-auto max-w-[100rem]">
						@PublicDocsFragmentContent(idx, selectedID, opts)
					</div>
				</main>
				@searchfield.SearchModal(docsSearchConfig(idx.Search))
			</div>
		</div>
	}
}

templ PublicDocsFragmentWithOptions(idx core.SpecIndex, selectedID string, opts PublicDocsOptions) {
	{{ opts = opts.withDefaults() }}
	{{ selected := selectedDocsItemFor(idx, selectedID) }}
	<title hx-swap-oob="true">{ idx.Title }</title>
	<div id="sidebar-nav-content" hx-swap-oob="true" class="h-full">
		@publicDocsSidebar(idx, selected, opts)
	</div>
	@PublicDocsFragmentContent(idx, selectedID, opts)
}

templ PublicDocsFragmentContent(idx core.SpecIndex, selectedID string, opts PublicDocsOptions) {
	{{ selected := selectedDocsItemFor(idx, selectedID) }}
	<h1 class="sr-only">{ idx.Title } OpenAPI docs</h1>
	@selectedDocsBreadcrumbs(idx, selected)
	@selectedDocsContent(idx, selected)
}

templ publicDocsSidebar(idx core.SpecIndex, selected selectedDocsItem, opts PublicDocsOptions) {
	@sidebar.Sidebar(sidebar.Config{
		Items: overviewSidebarItems(selected.Anchor),
		SectionsTitle: "API Reference",
		Sections: sidebarSections(idx, selected.Anchor, opts.EndpointSidebarLabel),
		SearchSlot: docsSearchField(idx.Search),
	})
}

templ selectedDocsContent(idx core.SpecIndex, selected selectedDocsItem) {
	if selected.Kind == "overview" {
		@overviewSection(idx)
	} else if selected.Kind == "operation" {
		<section aria-labelledby="operations-heading" class="grid gap-16">
			<h2 id="operations-heading" data-toc-heading class="sr-only">Operations</h2>
			@endpointSection(selected.Operation, idx.ExampleSpecJSON)
		</section>
	} else if selected.Kind == "schema" {
		<section aria-labelledby="schemas-heading">
			<h2 id="schemas-heading" data-toc-heading class="sr-only">Schemas</h2>
			@schemaSection(selected.Schema, idx.ExampleSpecJSON)
		</section>
	} else {
		<section class="rounded-radius border border-outline bg-surface-alt p-6 dark:border-outline-dark dark:bg-surface-dark-alt">
			<h2 class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">No public documentation</h2>
			<p class="mt-2 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Publish a spec with operations or schemas to populate this view.</p>
		</section>
	}
}

templ selectedDocsBreadcrumbs(idx core.SpecIndex, selected selectedDocsItem) {
	if selected.Kind == "operation" {
		@breadcrumbs.Breadcrumbs(breadcrumbs.Config{
			Items:    operationBreadcrumbItems(idx, selected.Operation, selected.Anchor),
			Current: operationTitle(selected.Operation),
			NavClass: "mb-8",
		})
	}
}

templ overviewSection(idx core.SpecIndex) {
	<section id="overview" aria-labelledby="overview-heading" class="scroll-mt-24">
		<div class="max-w-[88rem]">
			<div class="flex flex-wrap items-start justify-between gap-6 border-b border-outline pb-8 dark:border-outline-dark">
				<div class="min-w-0">
					<h2 id="overview-heading" data-toc-heading class="font-title text-4xl font-bold leading-tight text-on-surface-strong dark:text-on-surface-dark-strong lg:text-5xl">{ idx.Title }</h2>
					if idx.Version != "" {
						<div class="mt-4">
							<span class="rounded-radius border border-outline bg-surface-alt px-2 py-1 font-mono text-xs font-semibold text-on-surface-strong dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark-strong">v{ idx.Version }</span>
						</div>
					}
				</div>
				if overviewHasSpecDownload(idx) {
					<a href="/openapi.json" download={ overviewSpecFilename(idx.SpecDownload) } aria-label="Download OpenAPI JSON spec" class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-radius border border-outline bg-surface-alt px-3 text-sm font-semibold text-on-surface-strong transition hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark-strong dark:hover:bg-surface-dark dark:focus-visible:outline-primary-dark">
						@downloadIcon()
						<span>Download JSON</span>
					</a>
				}
			</div>
			<dl class="mt-6 grid max-w-3xl gap-3 sm:grid-cols-2">
				<div class="rounded-radius border border-outline bg-surface-alt px-4 py-3 dark:border-outline-dark dark:bg-surface-dark-alt">
					<dt class="text-sm font-medium text-on-surface-muted dark:text-on-surface-dark-muted">Endpoints</dt>
					<dd class="mt-1 font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ pluralizedCount(len(idx.Operations), "endpoint") }</dd>
				</div>
				<div class="rounded-radius border border-outline bg-surface-alt px-4 py-3 dark:border-outline-dark dark:bg-surface-dark-alt">
					<dt class="text-sm font-medium text-on-surface-muted dark:text-on-surface-dark-muted">Schemas</dt>
					<dd class="mt-1 font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ pluralizedCount(len(idx.Schemas), "schema") }</dd>
				</div>
			</dl>
			if len(idx.Overview.Servers) > 0 {
				<section class="mt-10 overflow-hidden rounded-radius border border-outline bg-surface-dark text-on-surface-dark dark:border-outline-dark" aria-labelledby="overview-base-url-heading">
					<div class="border-b border-outline-dark bg-surface-dark px-4 py-3">
						<h3 id="overview-base-url-heading" class="text-sm font-semibold text-on-surface-dark-strong">API Base URL</h3>
					</div>
					<div class="grid gap-4 bg-surface-dark-alt p-4">
						for _, server := range idx.Overview.Servers {
							<section class="overflow-hidden rounded-radius bg-surface-dark">
								<div class="flex min-w-0 flex-wrap items-center gap-2 px-4 py-3">
									<span aria-hidden="true" class="text-on-surface-dark-muted">▾</span>
									<p class="min-w-0 text-sm font-semibold text-on-surface-dark-strong">
										{ overviewServerLabel(server) }:
										<code class="ml-1 break-all font-mono text-sm font-semibold text-on-surface-dark">{ server.URL }</code>
									</p>
								</div>
								if len(server.Variables) > 0 {
									<dl class="grid gap-5 border-t border-outline-dark px-8 py-6">
										for _, variable := range server.Variables {
											<div class="grid gap-2">
												<div class="flex flex-wrap items-baseline gap-2">
													<dt class="font-mono text-sm font-bold text-on-surface-dark-strong">{ variable.Name }</dt>
													<dd class="text-sm text-on-surface-dark-muted">string</dd>
												</div>
												if variable.Description != "" {
													<p class="text-sm leading-6 text-on-surface-dark">{ variable.Description }</p>
												}
												if variable.Default != "" {
													<p class="text-xs text-on-surface-dark-muted">
														Default:
														<code class="ml-1 rounded-radius bg-surface-dark-alt px-1.5 py-0.5 font-mono text-xs text-on-surface-dark">{ variable.Default }</code>
													</p>
												}
											</div>
										}
									</dl>
								}
							</section>
						}
					</div>
				</section>
			}
			if overviewHasAdditionalInfo(idx.Overview) {
				<section class="mt-10 overflow-hidden rounded-radius border border-outline bg-surface-alt dark:border-outline-dark dark:bg-surface-dark-alt" aria-labelledby="overview-additional-info-heading">
					<div class="border-b border-outline bg-surface-alt px-4 py-3 dark:border-outline-dark dark:bg-surface-dark-alt">
						<h3 id="overview-additional-info-heading" class="text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Additional Information</h3>
					</div>
					<div class="grid gap-3 p-4">
						if overviewContactHref(idx.Overview.Contact) != "" {
							<a href={ templpkg.URL(overviewContactHref(idx.Overview.Contact)) } class="w-fit text-sm font-medium text-primary underline-offset-4 hover:underline dark:text-primary-dark">{ overviewContactLabel(idx.Overview.Contact) }</a>
						}
						if overviewLicenseLabel(idx.Overview.License) != "" {
							if idx.Overview.License.URL != "" {
								<a href={ templpkg.URL(idx.Overview.License.URL) } class="w-fit text-sm font-medium text-primary underline-offset-4 hover:underline dark:text-primary-dark">{ overviewLicenseLabel(idx.Overview.License) }</a>
							} else {
								<p class="text-sm font-medium text-on-surface dark:text-on-surface-dark">{ overviewLicenseLabel(idx.Overview.License) }</p>
							}
						}
						if idx.Overview.TermsOfService != "" {
							<a href={ templpkg.URL(idx.Overview.TermsOfService) } class="w-fit text-sm font-medium text-primary underline-offset-4 hover:underline dark:text-primary-dark">Terms of Service</a>
						}
					</div>
				</section>
			}
			if idx.Overview.Description != "" {
				<div class="manja-markdown mt-8 max-w-[70ch]">
					<p>{ idx.Overview.Description }</p>
				</div>
			}
		</div>
	</section>
}

templ overviewIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" class="size-full" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6M9 16h6M8 4h8l3 3v13H5V4h3Z"></path>
	</svg>
}

templ downloadIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"></path>
	</svg>
}

func overviewSidebarItems(selectedAnchor string) []sidebar.Item {
	href := selectedDocsHref("overview")
	return []sidebar.Item{{
		ID:        "overview",
		Label:     "Overview",
		Icon:      overviewIcon(),
		Href:      href,
		Active:    selectedAnchor == "overview",
		LinkAttrs: sidebarNavigationAttrs("Overview", href),
	}}
}

func overviewHasSpecDownload(idx core.SpecIndex) bool {
	return len(idx.SpecDownload.JSON) > 0
}

func overviewSpecFilename(download core.SpecDownload) string {
	filename := strings.TrimSpace(download.Filename)
	if filename == "" {
		return "openapi.json"
	}
	return filename
}

func overviewServerLabel(server core.SpecServer) string {
	return firstNonEmpty(server.Description, "Live Server")
}

func overviewHasAdditionalInfo(overview core.SpecOverview) bool {
	return overviewContactHref(overview.Contact) != "" || overviewLicenseLabel(overview.License) != "" || overview.TermsOfService != ""
}

func overviewContactHref(contact core.SpecContact) string {
	if strings.TrimSpace(contact.URL) != "" {
		return strings.TrimSpace(contact.URL)
	}
	if strings.TrimSpace(contact.Email) != "" {
		return "mailto:" + strings.TrimSpace(contact.Email)
	}
	return ""
}

func overviewContactLabel(contact core.SpecContact) string {
	return firstNonEmpty(contact.Name, contact.URL, contact.Email, "Contact")
}

func overviewLicenseLabel(license core.SpecLicense) string {
	return firstNonEmpty(license.Name, license.Identifier)
}

templ endpointSection(op core.Operation, exampleSpecJSON string) {
	{{ opID := operationAnchor(op) }}
	<section id={ opID } class="scroll-mt-24">
		<div class="grid gap-10 xl:grid-cols-[minmax(0,50rem)_24rem] xl:items-start 2xl:grid-cols-[minmax(0,54rem)_26rem]">
			<div class="min-w-0">
				<div class="border-b border-outline pb-8 dark:border-outline-dark">
					if op.Deprecated {
						<div class="mb-3 flex flex-wrap items-center gap-2">
							@badge.Badge(badge.Config{Label: "Deprecated", Variant: badge.Warning, Style: badge.StyleSoft, Size: badge.SizeSM})
						</div>
					}
					<h3 class="manja-doc-title font-title text-3xl font-bold leading-tight text-on-surface-strong dark:text-on-surface-dark-strong lg:text-4xl">{ operationTitle(op) }</h3>
					<div aria-label="Endpoint route" class="mt-5 inline-flex max-w-full items-center gap-3 rounded-radius border border-outline bg-surface-alt px-3 py-2 dark:border-outline-dark dark:bg-surface-dark-alt">
						@methodBadge(op.Method)
						<p class="min-w-0 break-words font-mono text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ op.Path }</p>
					</div>
					if op.Description != "" {
						<p class="mt-5 max-w-[70ch] text-base leading-7 text-on-surface dark:text-on-surface-dark">{ op.Description }</p>
					}
				</div>
				if operationHasRequest(op) || len(op.Responses) > 0 {
					<div class="manja-endpoint-detail-layout">
						if operationHasRequest(op) {
							<section class="grid gap-8" aria-label="Request">
								<h4 class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Request</h4>
								@paramGroup(opID, "Path Parameters", parametersIn(op.Parameters, "path"))
								@paramGroup(opID, "Query Parameters", parametersIn(op.Parameters, "query"))
								@paramGroup(opID, "Header Parameters", parametersIn(op.Parameters, "header"))
								if op.RequestBody != nil {
									<section class="grid gap-4" aria-label="Request body">
										<div class="flex flex-wrap items-center gap-2">
											<h5 class="font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Request body</h5>
											if op.RequestBody.Required {
												<span class="text-xs font-semibold text-danger dark:text-danger-dark">required</span>
											}
										</div>
										if op.RequestBody.Description != "" {
											<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ op.RequestBody.Description }</p>
										}
										@mediaTypeList(opID+"-request-body", "Request body", op.RequestBody.MediaTypes)
									</section>
								}
							</section>
						}
						if len(op.Responses) > 0 {
							<section class="manja-endpoint-responses-section grid gap-7" aria-label="Responses">
								<h4 class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Responses</h4>
								<div id={ opID + "-responses" }>
									@tabs.Tabs(responseTabsConfig(opID, op.Responses))
								</div>
							</section>
						}
					</div>
				}
			</div>
			if operationHasRail(op) {
				<aside class="min-w-0" aria-label="Endpoint examples">
					<div class="grid gap-6 lg:sticky lg:top-8">
						if len(op.Security) > 0 || len(op.Parameters) > 0 {
							<section class="overflow-hidden rounded-radius bg-surface-dark text-on-surface-dark shadow-sm">
								<div class="border-b border-outline-dark bg-surface-dark-alt px-4 py-3">
									<p class="text-sm font-semibold text-on-surface-dark-strong">Endpoint parameters</p>
								</div>
								<div class="grid gap-3 p-4 text-sm">
									for _, param := range op.Parameters {
										<div class="grid grid-cols-[6rem_1rem_minmax(0,1fr)] gap-2">
											<span class="truncate font-mono text-on-surface-dark-strong">{ param.Name }{ requiredMark(param.Required) }</span>
											<span class="text-on-surface-dark-muted">:</span>
											<span class="truncate text-on-surface-dark-muted">{ firstNonEmpty(schemaInline(param.Schema), param.In) }</span>
										</div>
									}
									for _, security := range op.Security {
										<p class="pt-2 text-xs font-semibold uppercase text-on-surface-dark-strong">Security</p>
										<div class="grid grid-cols-[6rem_1rem_minmax(0,1fr)] gap-2">
											<span class="truncate font-mono text-on-surface-dark-strong">security</span>
											<span class="text-on-surface-dark-muted">:</span>
											<span class="truncate text-on-surface-dark-muted">{ securityLabel(security) }</span>
										</div>
									}
								</div>
							</section>
						}
						for _, snippet := range op.Snippets {
							@codeExample("Request Sample: "+snippet.Label, snippet.Language, snippet.Code)
						}
						if op.RequestBody != nil {
							for _, media := range op.RequestBody.MediaTypes {
								{{ cfg := mediaSchemaExampleConfig(opID+"-request-body-"+anchorFragment(media.ContentType)+"-example", "Request Example: "+media.ContentType, media, exampleSpecJSON) }}
								if hasSchemaExample(cfg) {
									@schemaExample(cfg)
								}
							}
						}
						for _, response := range op.Responses {
							for _, media := range response.MediaTypes {
								{{ cfg := mediaSchemaExampleConfig(opID+"-response-"+anchorFragment(response.Status)+"-"+anchorFragment(media.ContentType)+"-example", "Response Example: "+response.Status+" "+media.ContentType, media, exampleSpecJSON) }}
								if hasSchemaExample(cfg) {
									@schemaExample(cfg)
								}
							}
						}
					</div>
				</aside>
			}
		</div>
	</section>
}

templ schemaSection(schema core.Schema, exampleSpecJSON string) {
	{{ summary := schema.Summary }}
	if summary.Name == "" {
		{{ summary.Name = schema.Name }}
	}
	if summary.Description == "" {
		{{ summary.Description = schema.Description }}
	}
	<section id={ schemaAnchor(schema) } class="scroll-mt-24">
		<div class="max-w-3xl border-b border-outline pb-8 dark:border-outline-dark">
			<p class="font-mono text-sm font-semibold uppercase text-on-surface-muted dark:text-on-surface-dark-muted">Schema</p>
			<h3 class="manja-doc-title mt-4 font-title text-4xl font-bold leading-tight text-on-surface-strong dark:text-on-surface-dark-strong lg:text-5xl">{ schema.Name }</h3>
			if summary.Description != "" {
				<p class="mt-6 max-w-[70ch] text-base leading-7 text-on-surface dark:text-on-surface-dark">{ summary.Description }</p>
			}
		</div>
		{{ cfg := schemaPageExampleConfig(schema, exampleSpecJSON) }}
		if hasSchemaExample(cfg) {
			<div class="manja-schema-detail-layout">
				<div class="manja-schema-tree-panel">
					@schemaTree(schemaAnchor(schema)+"-tree", schema.Name, summary)
				</div>
				<aside class="manja-schema-example-panel" aria-label="Schema example">
					@schemaExample(cfg)
				</aside>
			</div>
		} else {
			@schemaTree(schemaAnchor(schema)+"-tree", schema.Name, summary)
		}
	</section>
}

templ responsePanel(opID string, response core.OperationResponse) {
	<section>
		<div class="flex flex-wrap items-center gap-3">
			<span class={ responseBadgeClass(response.Status) }>{ response.Status }</span>
			if response.Description != "" {
				<p class="text-base font-medium text-on-surface dark:text-on-surface-dark">{ response.Description }</p>
			}
		</div>
		@mediaTypeList(opID+"-response-"+anchorFragment(response.Status), "Response "+response.Status, response.MediaTypes)
	</section>
}

templ mediaTypeList(idPrefix string, label string, mediaTypes []core.OperationMediaType) {
	if len(mediaTypes) > 0 {
		<div class="grid gap-4">
			for _, media := range mediaTypes {
				<div class="border-t border-outline py-5 dark:border-outline-dark">
					<div class="flex flex-wrap items-center gap-3">
						<span class="font-mono text-xs font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ media.ContentType }</span>
						if schemaInline(media.Schema) != "" {
							<span class="font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ schemaInline(media.Schema) }</span>
						}
					</div>
					@schemaProperties(mediaTypeTableID(idPrefix, media), label+" schema for "+media.ContentType, media.Schema)
				</div>
			}
		</div>
	}
}

templ paramGroup(idPrefix string, title string, parameters []core.OperationParameter) {
	if len(parameters) > 0 {
		<section class="grid gap-4">
			<h5 class="font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h5>
			<div>
				@table.Table(parameterTableConfig(idPrefix, title, parameters))
			</div>
		</section>
	}
}

templ schemaProperties(id string, caption string, schema core.SchemaSummary) {
	if schemaTreeHasContent(schema) {
		<div class="mt-4">
			@schemaTree(id, caption, schema)
		</div>
	}
}

templ schemaTree(id string, caption string, schema core.SchemaSummary) {
	<section id={ id } aria-label={ caption + " schema tree" } class="manja-schema-tree">
		if schemaTreeExpandable(schema) {
			<div class="manja-schema-root">
				@schemaTreeChildNodes(schema)
			</div>
		} else {
			@schemaTreeNode(schemaTreeRootName(caption, schema), false, schema, true)
		}
	</section>
}

templ schemaTreeNode(name string, required bool, schema core.SchemaSummary, root bool) {
	{{ displayName := schemaTreeDisplayName(name, schema) }}
	if schemaTreeExpandable(schema) {
		if root {
			<details open data-schema-tree-node={ displayName } class="manja-schema-node manja-schema-node-root">
				@schemaTreeSummary(displayName, required, schema)
				@schemaTreeChildren(schema)
			</details>
		} else {
			<details open data-schema-tree-row={ displayName } class="manja-schema-node">
				@schemaTreeSummary(displayName, required, schema)
				@schemaTreeChildren(schema)
			</details>
		}
	} else {
		if root {
			<div data-schema-tree-node={ displayName } class="manja-schema-node manja-schema-node-root">
				<div class="manja-schema-row">
					<span class="manja-schema-branch" aria-hidden="true"></span>
					@schemaTreeLabel(displayName, schema)
					@schemaTreeRequired(required)
				</div>
			</div>
		} else {
			<div data-schema-tree-row={ displayName } class="manja-schema-node">
				<div class="manja-schema-row">
					<span class="manja-schema-branch" aria-hidden="true"></span>
					@schemaTreeLabel(displayName, schema)
					@schemaTreeRequired(required)
				</div>
			</div>
		}
	}
}

templ schemaTreeSummary(name string, required bool, schema core.SchemaSummary) {
	<summary class="manja-schema-row">
		<span class="manja-schema-branch" aria-hidden="true"></span>
		<span class="manja-schema-caret" aria-hidden="true"></span>
		@schemaTreeLabel(name, schema)
		@schemaTreeRequired(required)
	</summary>
}

templ schemaTreeLabel(name string, schema core.SchemaSummary) {
	<div class="manja-schema-label">
		<div class="manja-schema-heading">
			<span class="manja-schema-name">{ name }</span>
			if schemaInline(schema) != "" {
				<span class="manja-schema-type">{ schemaInline(schema) }</span>
			}
		</div>
		if schema.Description != "" {
			<p class="manja-schema-description">{ schema.Description }</p>
		}
		if schema.Example != "" {
			if schemaTreeExampleBlock(schema.Example) {
				<div class="manja-schema-example manja-schema-example-block">
					<span>Example:</span>
					<pre><code>{ schema.Example }</code></pre>
				</div>
			} else {
				<p class="manja-schema-example manja-schema-example-inline">
					<span>Example:</span>
					<code>{ schema.Example }</code>
				</p>
			}
		}
	</div>
}

templ schemaTreeRequired(required bool) {
	if required {
		<span class="manja-schema-required">required</span>
	}
}

templ schemaTreeChildren(schema core.SchemaSummary) {
	<div class="manja-schema-children">
		@schemaTreeChildNodes(schema)
	</div>
}

templ schemaTreeChildNodes(schema core.SchemaSummary) {
	if schema.Items != nil && schemaTreeExpandable(*schema.Items) {
		@schemaTreeNode("items", false, *schema.Items, false)
	}
	for _, property := range schema.Properties {
		@schemaTreeNode(property.Name, property.Required, property.Schema, false)
	}
}

templ codeExample(label string, language string, code string) {
	@codeblock.CodeBlock(codeblock.Config{
		Label:     label,
		Language:  language,
		Code:      code,
		MaxHeight: "24rem",
	})
}

templ schemaExample(cfg ExampleConfig) {
	<div id={ cfg.ID } data-manja-example>
		@codeblock.CodeBlock(codeblock.Config{
			ID: cfg.ID+"-code",
			Label: cfg.Label,
			Language: exampleLanguage(cfg),
			Code: exampleFallback(cfg),
			MaxHeight: "24rem",
		})
		@templpkg.JSONScript(cfg.ID+"-payload", schemaExamplePayload(cfg))
		<p data-manja-example-status class="sr-only" aria-live="polite"></p>
	</div>
}

templ docsSearchField(docs []core.SearchDocument) {
	<div class="shrink-0 px-4 py-3" aria-label="Documentation search">
		@searchfield.SearchField(docsSearchConfig(docs))
	</div>
}

func docsSearchConfig(docs []core.SearchDocument) searchfield.Config {
	return searchfield.Config{
		ID:             "docs-search",
		Label:          "Search docs",
		Placeholder:    "Search operations and schemas",
		GlobalShortcut: true,
		ItemsURL:       "/search.json",
		MaxResults:     8,
		EmptyText:      "No operations or schemas found.",
	}
}

func responseTabsConfig(opID string, responses []core.OperationResponse) tabs.Config {
	tabItems := make([]tabs.Tab, 0, len(responses))
	for _, response := range responses {
		tabItems = append(tabItems, tabs.Tab{
			ID:      responseTabID(response),
			Label:   response.Status,
			Content: responsePanel(opID, response),
		})
	}
	cfg := tabs.Config{
		ID:        opID + "-responses",
		Tabs:      tabItems,
		RootClass: "manja-response-tabs",
	}
	if len(responses) > 0 {
		cfg.DefaultTab = responseTabID(responses[0])
	}
	return cfg
}

func responseTabID(response core.OperationResponse) string {
	id := anchorFragment(response.Status)
	if id == "" {
		id = "default"
	}
	return "response-" + id
}

func parameterTableConfig(idPrefix string, title string, parameters []core.OperationParameter) table.Config {
	rows := make([]table.Row, 0, len(parameters))
	for _, param := range parameters {
		required := "optional"
		requiredColor := "neutral"
		if param.Required {
			required = "required"
			requiredColor = "danger"
		}
		description := param.Description
		if param.Example != "" {
			if description != "" {
				description += " "
			}
			description += "Example: " + param.Example
		}
		rows = append(rows, table.Row{
			ID: idPrefix + "-" + anchorFragment(title) + "-" + anchorFragment(param.In+"-"+param.Name),
			Cells: map[string]table.Cell{
				"name":        {Text: param.Name, Code: true},
				"in":          {Text: param.In, Code: true},
				"type":        {Text: firstNonEmpty(schemaInline(param.Schema), param.In), Code: true},
				"requirement": {Text: required, BadgeColor: requiredColor},
				"description": {Text: description},
			},
		})
	}
	return table.Config{
		ID:      idPrefix + "-" + anchorFragment(title),
		Caption: title,
		Columns: []table.Column{
			{Key: "name", Label: "Name", Width: "min-w-[8rem]"},
			{Key: "in", Label: "In", Width: "w-24"},
			{Key: "type", Label: "Type", Width: "min-w-[8rem]"},
			{Key: "requirement", Label: "Required", Width: "w-28"},
			{Key: "description", Label: "Description"},
		},
		Rows:      rows,
		RootClass: "text-sm",
	}
}

func mediaTypeTableID(idPrefix string, media core.OperationMediaType) string {
	contentType := anchorFragment(media.ContentType)
	if contentType == "" {
		contentType = "media"
	}
	return idPrefix + "-" + contentType + "-schema"
}

func mediaSchemaExampleConfig(id string, label string, media core.OperationMediaType, specJSON string) ExampleConfig {
	return ExampleConfig{
		ID:          id,
		Label:       label,
		Language:    "json",
		SchemaJSON:  media.Schema.JSON,
		ExampleJSON: media.Example,
		ExplicitExample: media.ExampleProvided,
		SpecJSON:    specJSON,
		Options:     defaultExampleOptions(),
	}
}

func schemaPageExampleConfig(schema core.Schema, specJSON string) ExampleConfig {
	return ExampleConfig{
		ID:          schemaAnchor(schema) + "-example",
		Label:       "Example: " + schema.Name,
		Language:    "json",
		SchemaJSON:  schema.Example.JSON,
		ExampleJSON: schema.Example.Example,
		ExplicitExample: schema.Example.Provided,
		SpecJSON:    specJSON,
		Options: ExampleOptions{
			SkipNonRequired: false,
			Quiet:           true,
			MaxSampleDepth:  4,
		},
	}
}

func defaultExampleOptions() ExampleOptions {
	return ExampleOptions{
		SkipNonRequired: false,
		Quiet:           true,
		MaxSampleDepth:  3,
	}
}

func hasSchemaExample(cfg ExampleConfig) bool {
	return strings.TrimSpace(cfg.SchemaJSON) != "" || strings.TrimSpace(cfg.ExampleJSON) != ""
}

func exampleLanguage(cfg ExampleConfig) string {
	if strings.TrimSpace(cfg.Language) != "" {
		return cfg.Language
	}
	return "json"
}

func exampleFallback(cfg ExampleConfig) string {
	if strings.TrimSpace(cfg.ExampleJSON) != "" {
		return cfg.ExampleJSON
	}
	return "Example unavailable"
}

func schemaExamplePayload(cfg ExampleConfig) map[string]any {
	payload := map[string]any{
		"options": cfg.Options,
	}
	if cfg.ExplicitExample && strings.TrimSpace(cfg.ExampleJSON) != "" {
		payload["hasExplicitExample"] = true
	}
	var schema any
	if strings.TrimSpace(cfg.SchemaJSON) != "" {
		if err := json.Unmarshal([]byte(cfg.SchemaJSON), &schema); err != nil {
			schema = nil
		}
	}
	payload["schema"] = schema
	if strings.TrimSpace(cfg.SpecJSON) != "" {
		var spec any
		if err := json.Unmarshal([]byte(cfg.SpecJSON), &spec); err == nil {
			payload["spec"] = spec
		}
	}
	return payload
}

func sidebarSections(idx core.SpecIndex, selectedAnchor string, labelMode EndpointSidebarLabelMode) []sidebar.Section {
	sections := make([]sidebar.Section, 0, 2)
	if len(idx.Operations) > 0 {
		tagOrder := make([]string, 0)
		tagItems := map[string][]sidebar.Item{}
		for _, op := range idx.Operations {
			tags := op.Tags
			if len(tags) == 0 {
				tags = []string{"Untagged"}
			}
			for _, tag := range tags {
				tag = strings.TrimSpace(tag)
				if tag == "" {
					tag = "Untagged"
				}
				if _, ok := tagItems[tag]; !ok {
					tagOrder = append(tagOrder, tag)
				}
				anchor := operationAnchor(op)
				label := operationSidebarLabel(op, labelMode)
				href := selectedDocsHref(anchor)
				tagItems[tag] = append(tagItems[tag], sidebar.Item{
					ID:         anchor,
					Label:      label,
					Href:       href,
					Active:     anchor == selectedAnchor,
					Badge:      op.Method,
					BadgeClass: methodBadgeClass(op.Method),
					LinkAttrs:  sidebarNavigationAttrs(label, href),
				})
			}
		}
		items := make([]sidebar.Item, 0, len(tagOrder))
		for _, tag := range tagOrder {
			href := firstSidebarHref(tagItems[tag])
			items = append(items, sidebar.Item{
				ID:        "tag-" + anchorFragment(tag),
				Label:     tag,
				Href:      href,
				Items:     tagItems[tag],
				LinkAttrs: sidebarNavigationAttrs(tag, href),
			})
		}
		sections = append(sections, sidebar.Section{Title: "Operations", Items: items})
	}
	if len(idx.Schemas) > 0 {
		items := make([]sidebar.Item, 0, len(idx.Schemas))
		for _, schema := range idx.Schemas {
			anchor := schemaAnchor(schema)
			label := schemaSidebarLabel(schema)
			href := selectedDocsHref(anchor)
			items = append(items, sidebar.Item{
				ID:        anchor,
				Label:     label,
				Href:      href,
				Active:    anchor == selectedAnchor,
				LinkAttrs: sidebarNavigationAttrs(label, href),
			})
		}
		sections = append(sections, sidebar.Section{Title: "Schemas", Items: items})
	}
	return sections
}

func selectedDocsItemFor(idx core.SpecIndex, selectedID string) selectedDocsItem {
	selectedID = strings.TrimPrefix(strings.TrimSpace(selectedID), "#")
	if selectedID == "" || selectedID == "overview" {
		return selectedDocsItem{Anchor: "overview", Kind: "overview"}
	}
	for _, op := range idx.Operations {
		anchor := operationAnchor(op)
		if anchor == selectedID {
			return selectedDocsItem{Anchor: anchor, Kind: "operation", Operation: op}
		}
	}
	for _, schema := range idx.Schemas {
		anchor := schemaAnchor(schema)
		if anchor == selectedID {
			return selectedDocsItem{Anchor: anchor, Kind: "schema", Schema: schema}
		}
	}
	if len(idx.Operations) > 0 {
		anchor := operationAnchor(idx.Operations[0])
		return selectedDocsItem{Anchor: anchor, Kind: "operation", Operation: idx.Operations[0]}
	}
	if len(idx.Schemas) > 0 {
		anchor := schemaAnchor(idx.Schemas[0])
		return selectedDocsItem{Anchor: anchor, Kind: "schema", Schema: idx.Schemas[0]}
	}
	return selectedDocsItem{Anchor: "overview", Kind: "overview"}
}

func operationBreadcrumbItems(idx core.SpecIndex, op core.Operation, fallbackAnchor string) []breadcrumbs.Item {
	items := []breadcrumbs.Item{{
		Label: "Home",
		Href:  selectedDocsHref("overview"),
	}}
	tag := operationBreadcrumbTag(op)
	if tag != "" {
		items = append(items, breadcrumbs.Item{
			Label: tag,
			Href:  operationTagBreadcrumbHref(idx, tag, fallbackAnchor),
		})
	}
	return items
}

func operationBreadcrumbTag(op core.Operation) string {
	for _, tag := range op.Tags {
		if tag = strings.TrimSpace(tag); tag != "" {
			return tag
		}
	}
	return "Untagged"
}

func operationTagBreadcrumbHref(idx core.SpecIndex, tag string, fallbackAnchor string) string {
	tag = strings.TrimSpace(tag)
	for _, op := range idx.Operations {
		tags := op.Tags
		if len(tags) == 0 {
			tags = []string{"Untagged"}
		}
		for _, opTag := range tags {
			if strings.EqualFold(strings.TrimSpace(opTag), tag) {
				return selectedDocsHref(operationAnchor(op))
			}
		}
	}
	return selectedDocsHref(fallbackAnchor)
}

func selectedDocsHref(anchor string) string {
	anchor = strings.TrimPrefix(strings.TrimSpace(anchor), "#")
	if anchor == "" {
		return "/"
	}
	return "/?selected=" + url.QueryEscape(anchor) + "#" + anchor
}

func selectedDocsHrefFromDoc(href string) string {
	anchor, ok := strings.CutPrefix(strings.TrimSpace(href), "#")
	if !ok {
		return href
	}
	return selectedDocsHref(anchor)
}

func sidebarTitleAttrs(label string) templpkg.Attributes {
	label = strings.TrimSpace(label)
	if label == "" {
		return nil
	}
	return templpkg.Attributes{"title": label}
}

func sidebarNavigationAttrs(label string, href string) templpkg.Attributes {
	attrs := sidebarTitleAttrs(label)
	if attrs == nil {
		attrs = templpkg.Attributes{}
	}
	href = strings.TrimSpace(href)
	if href == "" || !strings.HasPrefix(href, "/") {
		return attrs
	}
	attrs["hx-get"] = href
	attrs["hx-target"] = "#main-content"
	attrs["hx-swap"] = "innerHTML"
	attrs["hx-push-url"] = "true"
	return attrs
}

func firstSidebarHref(items []sidebar.Item) string {
	for _, item := range items {
		if item.Href != "" {
			return item.Href
		}
	}
	return "/"
}

templ methodBadge(method string) {
	@badge.Badge(badge.Config{
		Label:     strings.ToUpper(strings.TrimSpace(method)),
		Variant:   methodBadgeVariant(method),
		Size:      badge.SizeSM,
		RootClass: "font-mono font-bold",
	})
}

func methodBadgeClass(method string) string {
	return badge.Config{Variant: methodBadgeVariant(method), Size: badge.SizeSM}.VariantClasses()
}

func methodBadgeVariant(method string) badge.Variant {
	switch strings.ToUpper(strings.TrimSpace(method)) {
	case "GET":
		return badge.Info
	case "POST":
		return badge.Success
	case "PUT":
		return badge.Warning
	case "PATCH":
		return badge.Secondary
	case "DELETE":
		return badge.Danger
	default:
		return badge.Default
	}
}

func themeOptions() []selectfield.Option {
	return []selectfield.Option{
		{Value: "goshtoso", Label: "Goshtoso", Selected: true},
		{Value: "minimal", Label: "Minimal"},
		{Value: "modern", Label: "Modern"},
		{Value: "arctic", Label: "Arctic"},
		{Value: "high-contrast", Label: "High Contrast"},
		{Value: "neo-brutalism", Label: "Neo Brutalism"},
		{Value: "news", Label: "News"},
		{Value: "industrial", Label: "Industrial"},
		{Value: "90s", Label: "90s"},
		{Value: "pastel", Label: "Pastel"},
		{Value: "christmas", Label: "Christmas"},
		{Value: "halloween", Label: "Halloween"},
		{Value: "zombie", Label: "Halloween II"},
		{Value: "prototype", Label: "Prototype"},
		{Value: "dracula", Label: "Dracula"},
	}
}

templ themeSelectIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 0 1-4-4V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v12a4 4 0 0 1-4 4Zm0 0h12a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 0 1 2.828 0l2.829 2.829a2 2 0 0 1 0 2.828l-8.486 8.485M7 17h.01"></path>
	</svg>
}

templ themeToggle() {
	<button
		id="darkModeToggleBtn"
		type="button"
		aria-label="dark mode toggle"
		x-on:click="toggleDarkMode()"
		x-bind:aria-pressed="darkMode.toString()"
		class="inline-flex size-10 shrink-0 items-center justify-center rounded-radius border border-outline bg-surface text-on-surface transition hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark dark:hover:bg-surface-dark-alt dark:focus-visible:outline-primary-dark"
	>
		<svg x-show="darkMode" xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<circle cx="12" cy="12" r="4"></circle>
			<path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
		</svg>
		<svg x-show="!darkMode" xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
		</svg>
	</button>
}

func operationAnchor(op core.Operation) string {
	if op.Anchor != "" {
		return op.Anchor
	}
	if op.ID != "" {
		return "operation-" + op.ID
	}
	fragment := anchorFragment(op.Method + " " + op.Path)
	if fragment == "" {
		return "operation"
	}
	return "operation-" + fragment
}

func schemaAnchor(schema core.Schema) string {
	return "schema-" + strings.ToLower(schema.Name)
}

func operationTitle(op core.Operation) string {
	if strings.TrimSpace(op.Summary) != "" {
		return op.Summary
	}
	if strings.TrimSpace(op.ID) != "" {
		return op.ID
	}
	return strings.TrimSpace(op.Method + " " + op.Path)
}

func operationSidebarLabel(op core.Operation, labelMode EndpointSidebarLabelMode) string {
	if labelMode == EndpointSidebarLabelPath {
		return firstNonEmpty(op.Path, operationTitle(op))
	}
	return firstNonEmpty(op.Summary, op.Path, operationTitle(op))
}

func schemaSidebarLabel(schema core.Schema) string {
	return firstNonEmpty(schema.Summary.Name, schema.Name)
}

func pluralizedCount(count int, singular string) string {
	label := singular
	if count != 1 {
		label += "s"
	}
	return strconv.Itoa(count) + " " + label
}

func schemaInline(schema core.SchemaSummary) string {
	typeLabel := schema.Type
	if strings.Contains(schema.Type, "array") {
		typeLabel = "array"
		if schema.Items != nil {
			if item := schemaInline(*schema.Items); item != "" {
				typeLabel += "[" + item + "]"
			}
		}
	} else if schema.Format != "" {
		if typeLabel != "" {
			typeLabel += "<" + schema.Format + ">"
		} else {
			typeLabel = schema.Format
		}
	}

	parts := make([]string, 0, 2)
	if schema.Name != "" {
		parts = append(parts, schema.Name)
	}
	if typeLabel != "" {
		parts = append(parts, typeLabel)
	}
	return strings.Join(parts, " ")
}

func schemaTreeRootName(caption string, schema core.SchemaSummary) string {
	if strings.TrimSpace(schema.Name) != "" {
		return schema.Name
	}
	if strings.TrimSpace(caption) != "" {
		return caption
	}
	return "schema"
}

func schemaTreeDisplayName(name string, schema core.SchemaSummary) string {
	if strings.TrimSpace(name) != "" {
		return name
	}
	if strings.TrimSpace(schema.Name) != "" {
		return schema.Name
	}
	return "schema"
}

func schemaTreeHasContent(schema core.SchemaSummary) bool {
	return schemaInline(schema) != "" ||
		strings.TrimSpace(schema.Description) != "" ||
		strings.TrimSpace(schema.Example) != "" ||
		len(schema.Properties) > 0 ||
		schema.Items != nil
}

func schemaTreeExpandable(schema core.SchemaSummary) bool {
	if len(schema.Properties) > 0 {
		return true
	}
	return schema.Items != nil && schemaTreeExpandable(*schema.Items)
}

func schemaTreeExampleBlock(example string) bool {
	trimmed := strings.TrimSpace(example)
	return len(trimmed) > 96 || strings.Contains(trimmed, "\n")
}

func securityLabel(security core.OperationSecurity) string {
	if len(security.Scopes) == 0 {
		return security.Name
	}
	return security.Name + " (" + strings.Join(security.Scopes, ", ") + ")"
}

func operationHasRail(op core.Operation) bool {
	if len(op.Parameters) > 0 || len(op.Security) > 0 {
		return true
	}
	if len(op.Snippets) > 0 {
		return true
	}
	if op.RequestBody != nil {
		for _, media := range op.RequestBody.MediaTypes {
			if strings.TrimSpace(media.Example) != "" || strings.TrimSpace(media.Schema.JSON) != "" {
				return true
			}
		}
	}
	for _, response := range op.Responses {
		for _, media := range response.MediaTypes {
			if strings.TrimSpace(media.Example) != "" || strings.TrimSpace(media.Schema.JSON) != "" {
				return true
			}
		}
	}
	return false
}

func operationHasRequest(op core.Operation) bool {
	return len(op.Parameters) > 0 || op.RequestBody != nil
}

func parametersIn(parameters []core.OperationParameter, location string) []core.OperationParameter {
	filtered := make([]core.OperationParameter, 0)
	for _, parameter := range parameters {
		if strings.EqualFold(parameter.In, location) {
			filtered = append(filtered, parameter)
		}
	}
	return filtered
}

func responseBadgeClass(status string) string {
	base := "rounded-radius px-3 py-1 font-mono text-xs font-bold "
	if strings.HasPrefix(status, "2") {
		return base + "bg-success text-on-success"
	}
	if strings.HasPrefix(status, "4") || strings.HasPrefix(status, "5") {
		return base + "text-danger dark:text-danger-dark"
	}
	return base + "border border-outline text-on-surface-strong dark:border-outline-dark dark:text-on-surface-dark-strong"
}

func requiredMark(required bool) string {
	if required {
		return "*"
	}
	return ""
}

func firstNonEmpty(values ...string) string {
	for _, value := range values {
		if strings.TrimSpace(value) != "" {
			return value
		}
	}
	return ""
}

func anchorFragment(value string) string {
	var builder strings.Builder
	lastWasSeparator := false
	for _, r := range strings.ToLower(value) {
		switch {
		case r >= 'a' && r <= 'z':
			builder.WriteRune(r)
			lastWasSeparator = false
		case r >= '0' && r <= '9':
			builder.WriteRune(r)
			lastWasSeparator = false
		default:
			if builder.Len() > 0 && !lastWasSeparator {
				builder.WriteByte('-')
				lastWasSeparator = true
			}
		}
	}
	return strings.Trim(builder.String(), "-")
}
