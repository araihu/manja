package templates

import (
	"context"
	"encoding/json"
	"io"
	"net/http"
	"net/url"
	"strconv"
	"strings"
	"unicode/utf8"

	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/accordion"
	"github.com/araihu/goshtoso/components/appshell"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/breadcrumbs"
	"github.com/araihu/goshtoso/components/codeblock"
	"github.com/araihu/goshtoso/components/dropdown"
	"github.com/araihu/goshtoso/components/emptystate"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/pageheader"
	"github.com/araihu/goshtoso/components/panel"
	"github.com/araihu/goshtoso/components/schemaform"
	searchfield "github.com/araihu/goshtoso/components/search"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/goshtoso/components/sidebar"
	"github.com/araihu/goshtoso/components/skeleton"
	"github.com/araihu/goshtoso/components/tooltip"

	"github.com/araihu/manja/application/port"
	core "github.com/araihu/manja/domain"
)

type selectedDocsItem struct {
	Anchor    string
	Kind      string
	Operation core.Operation
	Schema    core.Schema
}

// PublicDocsSelection binds one normalized route selection across metadata and rendering.
type PublicDocsSelection struct {
	item selectedDocsItem
}

// CanonicalSelectedID returns the only selection value admitted to canonical URLs.
func (selected PublicDocsSelection) CanonicalSelectedID() string {
	switch selected.item.Kind {
	case "operation", "schema":
		return selected.item.Anchor
	default:
		return ""
	}
}

type OperationNavigationItem struct {
	Title  string
	Method string
	Href   string
}

type OperationNavigationData struct {
	Group    string
	Previous *OperationNavigationItem
	Next     *OperationNavigationItem
	Catalog  bool
}

type EndpointSidebarLabelMode string

const (
	EndpointSidebarLabelAuto EndpointSidebarLabelMode = "auto"
	EndpointSidebarLabelPath EndpointSidebarLabelMode = "path"
)

type PublicDocsOptions struct {
	EndpointSidebarLabel      EndpointSidebarLabelMode
	MarkdownRenderer          port.MarkdownRenderer
	ManageDefaultLogo         bool
	ManageDefaultFavicon      bool
	Metadata                  PageMetadata
	OperationIdentityInHeader bool
	Selection                 *PublicDocsSelection
	SchemaLinks               map[string]string
	SchemaLinkTarget          string
	SchemaLinkSelect          string
	SchemaLinkSwap            string
}

type CapabilityFooterLink struct {
	Label    string
	Href     string
	Title    string
	Download bool
}

type CapabilityFooterData struct {
	LLMsHref string
	Clone    *CapabilityFooterLink
	Exports  []CapabilityFooterLink
}

const (
	docsSearchID = "docs-search"
)

func (opts PublicDocsOptions) withDefaults() PublicDocsOptions {
	if strings.TrimSpace(opts.SchemaLinkTarget) == "" {
		opts.SchemaLinkTarget = "#main-content"
	}
	if strings.TrimSpace(opts.SchemaLinkSwap) == "" {
		opts.SchemaLinkSwap = "innerHTML swap:120ms settle:240ms"
	}
	switch opts.EndpointSidebarLabel {
	case EndpointSidebarLabelPath:
		return opts
	default:
		opts.EndpointSidebarLabel = EndpointSidebarLabelAuto
		return opts
	}
}

func (opts PublicDocsOptions) selectedFor(idx core.SpecIndex, selectedID string) selectedDocsItem {
	if opts.Selection != nil {
		return opts.Selection.item
	}
	return selectedDocsItemFor(idx, selectedID)
}

type ExampleOptions struct {
	SkipNonRequired bool `json:"skipNonRequired"`
	Quiet           bool `json:"quiet"`
	MaxSampleDepth  int  `json:"maxSampleDepth"`
}

type ExampleConfig struct {
	ID              string
	Label           string
	Language        string
	SchemaJSON      string
	ExampleJSON     string
	ExplicitExample bool
	SpecJSON        string
	Options         ExampleOptions
}

type requestConfigBody struct {
	Has    bool
	Media  core.OperationMediaType
	Config ExampleConfig
}

type requestSampleTarget struct {
	Value    string
	Label    string
	Target   string
	Client   string
	Language string
}

templ PublicDocs(idx core.SpecIndex, selectedID string) {
	@PublicDocsWithOptions(idx, selectedID, PublicDocsOptions{})
}

templ PublicDocsWithOptions(idx core.SpecIndex, selectedID string, opts PublicDocsOptions) {
	{{ opts = opts.withDefaults() }}
	{{ opts.SchemaLinks = schemaLinksForIndex(idx, opts.SchemaLinks) }}
	{{ selected := opts.selectedFor(idx, selectedID) }}
	@LayoutWithBrandingMetadata(publicDocsPageMetadata(idx, selected, opts.Metadata), idx.Branding, true, opts.ManageDefaultFavicon) {
		<div hx-history="false" class="fixed inset-0 overflow-clip bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			@appshell.AppShell(appshell.Config{
				Header:       publicApplicationHeader(idx, selected, opts),
				Sidebar:      publicDocsSidebar(idx, selected, opts),
				MainID:       "main-content",
				RootClass:    "h-full",
				RootAttrs:    templpkg.Attributes{"data-manja-app-shell": "true"},
				HeaderClass:  "manja-docs-header relative z-50 shrink-0 border-b border-outline bg-surface dark:border-outline-dark dark:bg-surface-dark",
				HeaderAttrs:  templpkg.Attributes{"data-boot-anim": "header"},
				SidebarClass: "hidden h-full w-72 shrink-0 lg:block",
				SidebarAttrs: templpkg.Attributes{"aria-label": "API sections", "data-boot-anim": "sidebar"},
				MainClass:    "min-h-0 min-w-0 flex-1 overflow-y-auto overflow-x-hidden p-6 lg:px-10 lg:py-8",
				MainAttrs: templpkg.Attributes{
					"data-boot-anim":            "main",
					"data-manja-primary-scroll": "true",
					"data-selected-doc":         selected.Anchor,
				},
			}) {
				<div class="mx-auto max-w-[100rem]">
					@PublicDocsFragmentContent(idx, selectedID, opts)
				</div>
			}
			@searchfield.SearchModal(docsSearchConfig(idx.Search))
			@manjaFuzzySearchScript()
			@copyPageScript()
		</div>
	}
}

templ publicApplicationHeader(idx core.SpecIndex, selected selectedDocsItem, opts PublicDocsOptions) {
	<div class="flex h-16 items-center justify-between gap-3 px-4 lg:px-8">
		<div class="flex min-w-0 items-center gap-2">
			@sidebar.Overlay(sidebar.OverlayConfig{
				ID:                    "public-docs-sidebar",
				TriggerLabel:          "Open API sections",
				TriggerClass:          "min-h-11 min-w-11",
				RootClass:             "lg:hidden",
				PanelPositionClass:    "fixed top-16 bottom-0 left-0",
				PanelWidthClass:       "w-72 max-w-[85vw]",
				BackdropPositionClass: "fixed top-16 bottom-0 left-0 right-0",
				Sidebar:               publicDocsSidebarConfig(idx, selected, opts, docsSearchOpenSlot(), "mobile"),
			})
			<a href={ templpkg.URL(docsBrandingHomeURL(idx.Branding)) } class="flex min-w-0 items-center gap-2 text-2xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">
				if idx.Branding.Logo.Src != "" {
					if opts.ManageDefaultLogo {
						<img src={ templpkg.URL(idx.Branding.Logo.Src) } alt={ idx.Branding.Logo.Alt } width="32" height="32" crossorigin="anonymous" data-asset-brand="logo" class="size-8 shrink-0 rounded-radius"/>
					} else {
						<img src={ templpkg.URL(idx.Branding.Logo.Src) } alt={ idx.Branding.Logo.Alt } width="32" height="32" class="size-8 shrink-0 rounded-radius"/>
					}
				}
				<span>{ docsBrandingDisplayName(idx.Branding) }</span>
			</a>
		</div>
		<div class="flex min-w-0 items-center gap-3 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
			<div class="manja-theme-select shrink-0">
				@selectfield.Select(selectfield.Config{
					ID:             "manja-theme",
					Name:           "theme",
					Alpine:         &selectfield.AlpineConfig{Model: "theme"},
					TriggerLeading: themeSelectIcon(),
					TriggerAttrs:   templpkg.Attributes{"aria-label": "Theme"},
					Options:        themeOptions(),
				})
			</div>
			@themeToggle()
			<button
				hidden
				type="button"
				aria-label="Use seasonal appearance"
				aria-pressed="false"
				data-campaign-toggle
				data-use-campaign-label="Use seasonal appearance"
				data-use-baseline-label="Use standard appearance"
				class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-radius border border-outline text-on-surface-strong dark:border-outline-dark dark:text-on-surface-dark-strong"
			>
				<span class="manja-campaign-toggle-icon" data-campaign-toggle-icon aria-hidden="true"></span>
				<span class="sr-only" data-campaign-toggle-label>Use seasonal appearance</span>
			</button>
			<span class="hidden md:inline">OpenAPI docs</span>
			if idx.Version != "" {
				<span class="hidden rounded-radius border border-outline px-2 py-1 font-mono text-xs text-on-surface-strong dark:border-outline-dark dark:text-on-surface-dark-strong sm:inline">v{ idx.Version }</span>
			}
		</div>
	</div>
}

templ manjaFuzzySearchScript() {
	<script>
		(function () {
			var baseSearchModal = window.goshtosoSearchModal;
			if (!baseSearchModal || baseSearchModal.__manjaFuzzy) return;

			function compact(value) {
				return String(value || "").toLowerCase().replace(/[^a-z0-9]+/g, "");
			}

			function fuzzyScore(query, value) {
				var needle = compact(query);
				var haystack = compact(value);
				if (!needle || !haystack) return -1;
				var direct = haystack.indexOf(needle);
				if (direct >= 0) return direct;
				var cursor = 0;
				var first = -1;
				var last = -1;
				var gaps = 0;
				for (var i = 0; i < haystack.length && cursor < needle.length; i++) {
					if (haystack[i] !== needle[cursor]) continue;
					if (first < 0) first = i;
					if (last >= 0) gaps += i - last - 1;
					last = i;
					cursor++;
				}
				if (cursor !== needle.length) return -1;
				return 20 + first + gaps + Math.max(0, haystack.length - needle.length) / 10;
			}

			function resultScore(term, title, text) {
				term = String(term || "").trim().toLowerCase();
				title = String(title || "");
				text = String(text || "");
				if (!term) return -1;
				if (title.toLowerCase().indexOf(term) !== -1) return 0;
				if (text.toLowerCase().indexOf(term) !== -1) return 100;
				var titleScore = fuzzyScore(term, title);
				if (titleScore >= 0) return 200 + titleScore;
				var textScore = fuzzyScore(term, text);
				if (textScore >= 0) return 400 + textScore;
				return -1;
			}

			function rankedMatches(values, scoreFor) {
				var matches = [];
				values.forEach(function (value, index) {
					var score = scoreFor(value);
					if (score >= 0) matches.push({ value: value, index: index, score: score });
				});
				matches.sort(function (a, b) {
					if (a.score !== b.score) return a.score - b.score;
					return a.index - b.index;
				});
				return matches.map(function (match) { return match.value; });
			}

			window.goshtosoSearchModal = function () {
				var state = baseSearchModal.apply(this, arguments);
				state.matches = function (el) {
					return resultScore(this.query, el && el.dataset && el.dataset.searchTitle, el && el.dataset && el.dataset.searchText) >= 0;
				};
				state.matchedDOMResults = function () {
					var term = this.query.trim().toLowerCase();
					if (!term) return [];
					if (term === this.cachedDOMTerm) return this.cachedDOMResults;
					this.cachedDOMTerm = term;
					this.cachedDOMResults = rankedMatches(this.allResults(), function (el) {
						return resultScore(term, el.dataset.searchTitle, el.dataset.searchText);
					}).slice(0, this.maxResults);
					return this.cachedDOMResults;
				};
				state.matchedClientResults = function () {
					var term = this.query.trim().toLowerCase();
					if (!term) return [];
					if (term === this.cachedClientTerm) return this.cachedClientResults;
					this.cachedClientTerm = term;
					this.cachedClientResults = rankedMatches(this.clientItems, function (item) {
						return resultScore(term, item.title, item.searchText);
					}).slice(0, this.maxResults);
					return this.cachedClientResults;
				};
				return state;
			};
			window.goshtosoSearchModal.__manjaFuzzy = true;
		})();
	</script>
}

templ PublicDocsFragmentWithOptions(idx core.SpecIndex, selectedID string, opts PublicDocsOptions) {
	{{ opts = opts.withDefaults() }}
	{{ opts.SchemaLinks = schemaLinksForIndex(idx, opts.SchemaLinks) }}
	@PublicDocsFragmentContent(idx, selectedID, opts)
}

templ PublicDocsFragmentContent(idx core.SpecIndex, selectedID string, opts PublicDocsOptions) {
	{{ selected := opts.selectedFor(idx, selectedID) }}
	@publicDocsLoading(selected)
	<div data-public-docs-content="true" data-selected-doc={ selected.Anchor } data-document-title={ publicDocsDocumentTitle(idx, selected) }>
		@publicDocsPageHeader(idx, selected)
		@selectedDocsContent(idx, selected, opts)
	</div>
	@capabilityFooter(publicDocsCapabilityFooter(idx, selected))
}

templ publicDocsPageHeader(idx core.SpecIndex, selected selectedDocsItem) {
	@pageheader.PageHeader(pageheader.Config{
		Title:       publicDocsPageTitle(idx, selected),
		Description: publicDocsPageDescription(idx, selected),
		Breadcrumbs: selectedDocsBreadcrumbs(idx, selected),
		Actions:     publicDocsPageActions(idx, selected),
		RootClass:   "mb-8",
		RootAttrs: templpkg.Attributes{
			"data-public-page-header": "true",
		},
		TitleClass: "manja-doc-title",
		TitleAttrs: templpkg.Attributes{
			"id":                       selected.Anchor + "-heading",
			"tabindex":                 "-1",
			"data-public-doc-identity": selected.Anchor,
			"data-manja-settled-focus": "true",
			"data-manja-scroll-sentinel": "true",
		},
	})
}

templ publicDocsPageActions(idx core.SpecIndex, selected selectedDocsItem) {
	<div class="flex flex-wrap items-center gap-2">
		if selected.Kind == "operation" || selected.Kind == "schema" {
			@copyPageAction(selected.Anchor, publicPageMarkdownHref(selected))
		}
		if selected.Kind == "overview" && idx.Version != "" {
			@badge.Badge(badge.Config{Label: "v" + idx.Version, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
		}
		if selected.Kind == "overview" && overviewHasSpecDownload(idx) {
			<a href="/openapi.json" download={ overviewSpecFilename(idx.SpecDownload) } aria-label="Download OpenAPI JSON spec" class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-radius border border-outline bg-surface-alt px-3 text-sm font-semibold text-on-surface-strong transition hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark-strong dark:hover:bg-surface-dark dark:focus-visible:outline-primary-dark">
				@downloadIcon()
				<span>Download JSON</span>
			</a>
		}
	</div>
}

templ copyPageAction(id string, markdownHref string) {
	<div data-manja-copy-page class="manja-copy-page-actions inline-flex items-stretch" role="group" aria-label="Copy page as Markdown">
		<button
			type="button"
			data-manja-copy-page-trigger
			data-markdown-source={ markdownHref }
			class="inline-flex min-h-9 items-center justify-center gap-2 rounded-radius border border-outline bg-surface-alt px-3 text-sm font-semibold text-on-surface-strong transition hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark-strong dark:hover:bg-surface-dark dark:focus-visible:outline-primary-dark"
		>
			<span class="relative inline-flex size-4 items-center justify-center" aria-hidden="true">
				<span data-manja-copy-page-icon="copy" class="opacity-100 transition-opacity duration-150">
					@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidClipboard, Size: icon.SizeSM, Decorative: true})
				</span>
				<span data-manja-copy-page-icon="check" class="absolute opacity-0 transition-opacity duration-150">
					@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidCheck, Size: icon.SizeSM, Decorative: true})
				</span>
			</span>
			<span data-manja-copy-page-label>Copy Page</span>
		</button>
		@dropdown.Dropdown(dropdown.Config{
			ID:              id + "-copy-page-menu",
			Label:           "More Copy Page actions",
			TriggerIcon:     icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidChevronDown, Size: icon.SizeSM, Decorative: true}),
			TriggerIconOnly: true,
			MenuAlign:       dropdown.AlignEnd,
			Sections: []dropdown.Section{{Items: []dropdown.Item{{
				Label: "View as Markdown",
				Href: markdownHref,
				Icon: icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidDocumentText, Size: icon.SizeSM, Decorative: true}),
			}}}},
		})
		<span class="sr-only" aria-live="polite" data-manja-copy-page-status></span>
	</div>
}

templ copyPageScript() {
	<script data-manja-copy-page-script="true">
		(function () {
			if (window.__manjaCopyPageReady) return;
			window.__manjaCopyPageReady = true;

			async function copyText(value) {
				if (navigator.clipboard && window.isSecureContext) {
					await navigator.clipboard.writeText(value);
					return;
				}
				var input = document.createElement('textarea');
				input.value = value;
				input.setAttribute('readonly', '');
				input.style.position = 'fixed';
				input.style.opacity = '0';
				document.body.appendChild(input);
				input.select();
				var copied = document.execCommand('copy');
				input.remove();
				if (!copied) throw new Error('copy failed');
			}

			function setState(root, copied, failed) {
				var trigger = root.querySelector('[data-manja-copy-page-trigger]');
				var label = root.querySelector('[data-manja-copy-page-label]');
				var status = root.querySelector('[data-manja-copy-page-status]');
				var copyIcon = root.querySelector('[data-manja-copy-page-icon="copy"]');
				var checkIcon = root.querySelector('[data-manja-copy-page-icon="check"]');
				if (trigger) trigger.disabled = copied && !failed;
				if (label) label.textContent = failed ? 'Copy failed' : copied ? 'Copied!' : 'Copy Page';
				if (status) status.textContent = failed ? 'Unable to copy page Markdown' : copied ? 'Page Markdown copied' : '';
				if (copyIcon) copyIcon.classList.toggle('opacity-0', copied && !failed);
				if (copyIcon) copyIcon.classList.toggle('opacity-100', !copied || failed);
				if (checkIcon) checkIcon.classList.toggle('opacity-0', !copied || failed);
				if (checkIcon) checkIcon.classList.toggle('opacity-100', copied && !failed);
			}

			document.addEventListener('click', async function (event) {
				var origin = event.target;
				if (!(origin instanceof Element)) return;
				var trigger = origin.closest('[data-manja-copy-page-trigger]');
				if (!trigger) return;
				var root = trigger.closest('[data-manja-copy-page]');
				if (!root || trigger.disabled) return;
				var source = trigger.dataset.markdownSource || '';
				try {
					var response = await fetch(source, { headers: { Accept: 'text/markdown' } });
					if (!response.ok) throw new Error('markdown request failed');
					await copyText(await response.text());
					setState(root, true, false);
				} catch (_) {
					setState(root, false, true);
				}
				window.setTimeout(function () { setState(root, false, false); }, 1800);
			});
		})();
	</script>
}

templ publicDocsLoading(selected selectedDocsItem) {
	<div id="public-docs-loading" data-public-docs-loading="true" data-loading-doc={ selected.Anchor } class="htmx-indicator mb-8" aria-busy="true">
		@skeleton.Skeleton(skeleton.Config{
			Shape:     skeleton.ShapeRectangle,
			Count:     3,
			Label:     "Loading public documentation",
			RootClass: "grid gap-4",
			ItemClass: "min-h-16",
		})
	</div>
}

templ publicDocsSidebar(idx core.SpecIndex, selected selectedDocsItem, opts PublicDocsOptions) {
	<div id="sidebar-nav-content" class="h-full">
		@sidebar.Sidebar(publicDocsSidebarConfig(idx, selected, opts, docsSearchField(idx.Search), ""))
	</div>
}

func publicDocsSidebarConfig(idx core.SpecIndex, selected selectedDocsItem, opts PublicDocsOptions, searchSlot templpkg.Component, idPrefix string) sidebar.Config {
	return sidebar.Config{
		Items:         overviewSidebarItems(selected.Anchor),
		SectionsTitle: "API Reference",
		Sections:      sidebarSections(idx, selected.Anchor, opts.EndpointSidebarLabel, idPrefix),
		SearchSlot:    searchSlot,
		DisableSkipLink: true,
	}
}

templ selectedDocsContent(idx core.SpecIndex, selected selectedDocsItem, opts PublicDocsOptions) {
	if selected.Kind == "overview" {
		@overviewSection(idx, opts)
	} else if selected.Kind == "operation" {
		<section aria-labelledby="operations-heading" class="grid gap-16">
			<h2 id="operations-heading" data-toc-heading class="sr-only">Operations</h2>
			@endpointSection(selected.Operation, idx.Overview.Servers, idx.ExampleSpecJSON, opts, publicOperationNavigation(idx, selected.Operation))
		</section>
	} else if selected.Kind == "schema" {
		<section aria-labelledby="schemas-heading">
			<h2 id="schemas-heading" data-toc-heading class="sr-only">Schemas</h2>
			@schemaSection(selected.Schema, idx.ExampleSpecJSON, opts)
		</section>
	} else if selected.Kind == "missing" {
		@publicDocsNotFound(idx, selected.Anchor)
	} else {
		@publicDocsEmpty(idx)
	}
}

templ publicDocsEmpty(idx core.SpecIndex) {
	@emptystate.EmptyState(emptystate.Config{
		Title:       "No public documentation",
		Description: "Publish a spec with operations or schemas to populate this view.",
		Action:      publicDocsOverviewLink("Open contract overview"),
		RootAttrs: templpkg.Attributes{
			"data-public-docs-empty": "true",
		},
	})
}

templ publicDocsNotFound(idx core.SpecIndex, requested string) {
	@emptystate.EmptyState(emptystate.Config{
		Title:       "Documentation not found",
		Description: "The requested operation or schema is not part of the current contract.",
		Action:      publicDocsOverviewLink("Return to contract overview"),
		RootAttrs: templpkg.Attributes{
			"data-public-docs-not-found": "true",
			"data-requested-doc":         requested,
		},
	})
}

templ publicDocsOverviewLink(label string) {
	<a href={ templpkg.URL(selectedDocsHref("overview")) } class="inline-flex min-h-11 items-center justify-center rounded-radius bg-primary px-4 py-2 text-sm font-semibold text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-primary-dark dark:text-on-primary-dark dark:focus-visible:outline-primary-dark">{ label }</a>
}

templ capabilityFooter(data CapabilityFooterData) {
	<footer aria-label="Documentation capabilities" data-manja-capability-footer class="manja-capability-footer mt-16 border-t border-outline pt-5 text-sm text-on-surface-muted dark:border-outline-dark dark:text-on-surface-dark-muted">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<nav aria-label="Documentation utilities" class="flex flex-wrap items-center gap-x-5 gap-y-3">
				if data.LLMsHref != "" {
					<a data-manja-capability="llms" href={ templpkg.URL(data.LLMsHref) } class="font-medium underline-offset-4 transition-colors hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:hover:text-primary-dark dark:focus-visible:outline-primary-dark">LLMs.txt</a>
				}
				if data.Clone != nil && data.Clone.Href != "" {
					<a data-manja-capability="clone" href={ templpkg.URL(data.Clone.Href) } title={ data.Clone.Title } target="_blank" rel="noreferrer" class="font-medium underline-offset-4 transition-colors hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:hover:text-primary-dark dark:focus-visible:outline-primary-dark">{ data.Clone.Label }</a>
				}
				if len(data.Exports) > 0 {
					<div data-manja-capability="export" class="flex min-w-0 flex-wrap items-center gap-2">
						<span class="font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Export</span>
						for _, export := range data.Exports {
							<a
								href={ templpkg.URL(export.Href) }
								title={ export.Title }
								if export.Download {
									download
								}
								class="rounded-radius bg-surface-alt px-2 py-1 font-mono text-xs text-on-surface-strong transition-colors hover:bg-primary hover:text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-surface-dark-alt dark:text-on-surface-dark-strong dark:hover:bg-primary-dark dark:hover:text-on-primary-dark dark:focus-visible:outline-primary-dark"
							>{ export.Label }</a>
						}
					</div>
				}
			</nav>
			<a data-manja-capability="built-with" href="https://manja.araihu.com" target="_blank" rel="noopener" class="inline-flex shrink-0 items-center gap-2 self-start font-medium underline-offset-4 transition-colors hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:self-auto dark:hover:text-primary-dark dark:focus-visible:outline-primary-dark">
				<svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0 text-primary dark:text-primary-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"></path>
				</svg>
				<span>Built with <strong class="text-on-surface-strong dark:text-on-surface-dark-strong">Manja</strong></span>
			</a>
		</div>
	</footer>
}

func publicDocsCapabilityFooter(idx core.SpecIndex, selected selectedDocsItem) CapabilityFooterData {
	data := CapabilityFooterData{LLMsHref: "/llms.txt"}
	if overviewHasSpecDownload(idx) {
		data.Exports = append(data.Exports, CapabilityFooterLink{
			Label: "OpenAPI JSON", Href: "/openapi.json", Title: "Download the OpenAPI document as JSON", Download: true,
		})
	}
	if selected.Kind == "operation" || selected.Kind == "schema" {
		data.Exports = append(data.Exports, CapabilityFooterLink{
			Label: "Page Markdown", Href: publicPageMarkdownHref(selected), Title: "View this page as Markdown",
		})
	}
	return data
}

templ selectedDocsBreadcrumbs(idx core.SpecIndex, selected selectedDocsItem) {
	if selected.Kind == "operation" {
		@breadcrumbs.Breadcrumbs(breadcrumbs.Config{
			Items:    operationBreadcrumbItems(idx, selected.Operation, selected.Anchor),
			Current: operationTitle(selected.Operation),
			NavClass: "mb-8",
		})
	}
}

templ overviewSection(idx core.SpecIndex, opts PublicDocsOptions) {
	<section id="overview" aria-labelledby="overview-heading" class="scroll-mt-24">
		<div class="max-w-[88rem]">
			@panel.Panel(panel.Config{
				Body:      overviewSummary(idx),
				RootClass: "max-w-3xl",
				RootAttrs: templpkg.Attributes{"data-public-overview-summary": "true"},
			})
			if len(idx.Overview.Servers) > 0 {
				<section class="mt-10 overflow-hidden rounded-radius border border-outline bg-surface-dark text-on-surface-dark dark:border-outline-dark" aria-labelledby="overview-base-url-heading">
					<div class="border-b border-outline-dark bg-surface-dark px-4 py-3">
						<h3 id="overview-base-url-heading" class="text-sm font-semibold text-on-surface-dark-strong">API Base URL</h3>
					</div>
					<div class="grid gap-4 bg-surface-dark-alt p-4">
						for _, server := range idx.Overview.Servers {
							<section class="overflow-hidden rounded-radius bg-surface-dark">
								<div class="flex min-w-0 flex-wrap items-center gap-2 px-4 py-3">
									<span aria-hidden="true" class="text-on-surface-dark-muted">▾</span>
									<p class="min-w-0 text-sm font-semibold text-on-surface-dark-strong">
										Live Server:
										<code class="ml-1 break-all font-mono text-sm font-semibold text-on-surface-dark">{ server.URL }</code>
									</p>
								</div>
								if server.Description != "" {
									<div class="px-4 pb-4">
										if hasMarkdown(opts.MarkdownRenderer, server.Description) {
											<div class="max-w-[70ch] text-sm">
												@renderedMarkdown(opts.MarkdownRenderer, server.Description)
											</div>
										} else {
											<p class="text-sm leading-6 text-on-surface-dark">{ server.Description }</p>
										}
									</div>
								}
								if len(server.Variables) > 0 {
									<dl class="grid gap-5 border-t border-outline-dark px-8 py-6">
										for _, variable := range server.Variables {
											<div class="grid gap-2">
												<dt class="font-mono text-sm font-bold text-on-surface-dark-strong">{ variable.Name }</dt>
												<dd class="grid gap-2 text-sm text-on-surface-dark-muted">
													<span>string</span>
													if variable.Description != "" {
														if hasMarkdown(opts.MarkdownRenderer, variable.Description) {
															<div class="max-w-[70ch] text-sm">
																@renderedMarkdown(opts.MarkdownRenderer, variable.Description)
															</div>
														} else {
															<p class="text-sm leading-6 text-on-surface-dark">{ variable.Description }</p>
														}
													}
													if variable.Default != "" {
														<p class="text-xs text-on-surface-dark-muted">
															Default:
															<code class="ml-1 rounded-radius bg-surface-dark-alt px-1.5 py-0.5 font-mono text-xs text-on-surface-dark">{ variable.Default }</code>
														</p>
													}
												</dd>
											</div>
										}
									</dl>
								}
							</section>
						}
					</div>
				</section>
			}
			@securitySchemesOverview(idx.SecuritySchemes)
			if overviewHasAdditionalInfo(idx.Overview) {
				<section class="mt-10 overflow-hidden rounded-radius border border-outline bg-surface-alt dark:border-outline-dark dark:bg-surface-dark-alt" aria-labelledby="overview-additional-info-heading">
					<div class="border-b border-outline bg-surface-alt px-4 py-3 dark:border-outline-dark dark:bg-surface-dark-alt">
						<h3 id="overview-additional-info-heading" class="text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Additional Information</h3>
					</div>
					<div class="grid gap-3 p-4">
						if overviewContactHref(idx.Overview.Contact) != "" {
							<a href={ templpkg.URL(overviewContactHref(idx.Overview.Contact)) } class="w-fit text-sm font-medium text-primary underline-offset-4 hover:underline dark:text-primary-dark">{ overviewContactLabel(idx.Overview.Contact) }</a>
						}
						if overviewLicenseLabel(idx.Overview.License) != "" {
							if idx.Overview.License.URL != "" {
								<a href={ templpkg.URL(idx.Overview.License.URL) } class="w-fit text-sm font-medium text-primary underline-offset-4 hover:underline dark:text-primary-dark">{ overviewLicenseLabel(idx.Overview.License) }</a>
							} else {
								<p class="text-sm font-medium text-on-surface dark:text-on-surface-dark">{ overviewLicenseLabel(idx.Overview.License) }</p>
							}
						}
						if idx.Overview.TermsOfService != "" {
							<a href={ templpkg.URL(idx.Overview.TermsOfService) } class="w-fit text-sm font-medium text-primary underline-offset-4 hover:underline dark:text-primary-dark">Terms of Service</a>
						}
					</div>
				</section>
			}
			if hasMarkdown(opts.MarkdownRenderer, idx.Overview.Description) {
				<div class="mt-8 max-w-[70ch]">
					@renderedMarkdown(opts.MarkdownRenderer, idx.Overview.Description)
				</div>
			} else if idx.Overview.Description != "" {
				<div class="manja-markdown mt-8 max-w-[70ch]">
					<p>{ idx.Overview.Description }</p>
				</div>
			}
		</div>
	</section>
}

templ securitySchemesOverview(schemes []core.SecurityScheme) {
	if len(schemes) > 0 {
		<section data-manja-security-schemes class="mt-10 grid gap-4" aria-labelledby="overview-security-schemes-heading">
			<div class="grid gap-1">
				<h3 id="overview-security-schemes-heading" class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Security schemes</h3>
				<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Read-only reference. Credentials are never accepted or stored on this documentation page.</p>
			</div>
			<div class="grid gap-4 lg:grid-cols-2">
				for _, scheme := range schemes {
					{{ item := core.OperationSecurity{Name: scheme.Name, Definition: scheme} }}
					<article data-manja-security-scheme={ scheme.Name } class="grid gap-3 rounded-radius border border-outline p-4 dark:border-outline-dark">
						@schemaPropertyIdentity(scheme.Name, securityTypeLabel(item))
						if securityInstruction(item) != "" {
							<p class="max-w-[70ch] text-sm text-on-surface dark:text-on-surface-dark">{ securityInstruction(item) }</p>
						}
						if scheme.Description != "" {
							<p class="max-w-[70ch] whitespace-pre-wrap text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">{ scheme.Description }</p>
						}
						if securityHasMetadata(item) {
							<dl class="grid gap-3 text-sm sm:grid-cols-2">
								if securityParameterName(item) != "" {
									@authorizationField(securityParameterLocation(item), securityParameterName(item))
								}
								if scheme.Scheme != "" {
									@authorizationField("Scheme", scheme.Scheme)
								}
								if scheme.BearerFormat != "" {
									@authorizationField("Bearer format", scheme.BearerFormat)
								}
								if scheme.OpenIDConnectURL != "" {
									<div class="min-w-0 sm:col-span-2">
										<dt class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">OpenID Connect URL</dt>
										<dd class="mt-1 min-w-0 break-all font-mono text-on-surface-strong dark:text-on-surface-dark-strong">{ scheme.OpenIDConnectURL }</dd>
									</div>
								}
							</dl>
						}
					</article>
				}
			</div>
		</section>
	}
}

templ overviewSummary(idx core.SpecIndex) {
	<dl class="grid gap-4 sm:grid-cols-2">
		<div>
			<dt class="text-sm font-medium text-on-surface-muted dark:text-on-surface-dark-muted">Endpoints</dt>
			<dd class="mt-1 font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ pluralizedCount(len(idx.Operations), "endpoint") }</dd>
		</div>
		<div>
			<dt class="text-sm font-medium text-on-surface-muted dark:text-on-surface-dark-muted">Schemas</dt>
			<dd class="mt-1 font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ pluralizedCount(len(idx.Schemas), "schema") }</dd>
		</div>
	</dl>
}

templ overviewIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" class="size-full" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6M9 16h6M8 4h8l3 3v13H5V4h3Z"></path>
	</svg>
}

templ downloadIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"></path>
	</svg>
}

func overviewSidebarItems(selectedAnchor string) []sidebar.Item {
	href := selectedDocsHref("overview")
	return []sidebar.Item{{
		ID:        "overview",
		Label:     "Overview",
		Icon:      overviewIcon(),
		Href:      href,
		Active:    selectedAnchor == "overview",
		LinkAttrs: sidebarNavigationAttrs("Overview", href),
	}}
}

func overviewHasSpecDownload(idx core.SpecIndex) bool {
	return len(idx.SpecDownload.JSON) > 0
}

func overviewSpecFilename(download core.SpecDownload) string {
	filename := strings.TrimSpace(download.Filename)
	if filename == "" {
		return "openapi.json"
	}
	return filename
}

func overviewHasAdditionalInfo(overview core.SpecOverview) bool {
	return overviewContactHref(overview.Contact) != "" || overviewLicenseLabel(overview.License) != "" || overview.TermsOfService != ""
}

func overviewContactHref(contact core.SpecContact) string {
	if strings.TrimSpace(contact.URL) != "" {
		return strings.TrimSpace(contact.URL)
	}
	if strings.TrimSpace(contact.Email) != "" {
		return "mailto:" + strings.TrimSpace(contact.Email)
	}
	return ""
}

func overviewContactLabel(contact core.SpecContact) string {
	return firstNonEmpty(contact.Name, contact.URL, contact.Email, "Contact")
}

func overviewLicenseLabel(license core.SpecLicense) string {
	return firstNonEmpty(license.Name, license.Identifier)
}

func docsBrandingDisplayName(branding core.DocsBranding) string {
	return firstNonEmpty(branding.DisplayName, "Manja")
}

func docsBrandingHomeURL(branding core.DocsBranding) string {
	return firstNonEmpty(branding.Logo.HomeURL, "/")
}

func hasMarkdown(renderer port.MarkdownRenderer, input string) bool {
	return renderer != nil && strings.TrimSpace(input) != ""
}

func renderedMarkdown(renderer port.MarkdownRenderer, input string) templpkg.Component {
	return templpkg.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		result, err := renderer.Render(ctx, input)
		if err != nil {
			return err
		}
		return templpkg.Raw(result.HTML).Render(ctx, w)
	})
}

// The request rail keeps one server-rendered body visible until its composer
// hydrates, then changes presentation at the mobile breakpoint. Goshtoso's
// edge-complete drawer is intentionally not mounted as a second copy here: its
// fixed panel has no static-desktop mode, and duplicating a large request/example
// tree would make every operation pay twice in the browser. This small adapter
// keeps the mobile sheet gesture local to the rendered endpoint.
// reuses Goshtoso semantic tokens and its Alpine focus-trap contract while
// preserving one body and a static rail.
templ endpointSection(op core.Operation, servers []core.SpecServer, exampleSpecJSON string, opts PublicDocsOptions, navigation OperationNavigationData) {
	{{ opID := operationAnchor(op) }}
	{{ requestConfigID := opID + "-request-config" }}
	{{ requestConfigTitleID := requestConfigID + "-title" }}
	{{ requestConfigContentID := requestConfigID + "-content" }}
	{{ requestConfigLabel := requestConfigPanelLabel(op, servers) }}
	{{ sectionClass := "scroll-mt-24" }}
	if operationHasRail(op, servers) {
		{{ sectionClass += " manja-endpoint-section-with-request-config" }}
	}
	<section
		id={ opID }
		class={ sectionClass }
		data-manja-request-config-root
		x-data="{
			requestConfigOpen: false,
			requestConfigDesktop: window.matchMedia('(min-width: 1280px)').matches,
			requestConfigDesktopVisible: false,
			requestConfigMedia: null,
			requestConfigMediaHandler: null,
			requestConfigEscapeHandler: null,
			requestConfigFocusTimer: null,
			requestConfigTouchStartY: null,
			requestConfigTouchStartX: null,
			init() {
				this.requestConfigMedia = window.matchMedia('(min-width: 1280px)');
				this.requestConfigDesktop = this.requestConfigMedia.matches;
				this.requestConfigMediaHandler = (event) => {
					this.requestConfigDesktop = event.matches;
					if (event.matches && this.requestConfigOpen) this.closeRequestConfig();
				};
				this.requestConfigMedia.addEventListener('change', this.requestConfigMediaHandler);
				this.requestConfigEscapeHandler = (event) => {
					if (event.key === 'Escape' && this.requestConfigOpen && !this.requestConfigDesktop) {
						event.preventDefault();
						event.stopPropagation();
						this.closeRequestConfig();
					}
				};
				document.addEventListener('keydown', this.requestConfigEscapeHandler, true);
				this.$nextTick(() => {
					const root = this.$root;
					if (!root || !root.dataset) return;
					root.dataset.manjaRequestConfigControlsReady = 'true';
					root.dispatchEvent(new CustomEvent('manja:request-config-controls-ready'));
				});
			},
			destroy() {
				if (this.requestConfigMedia && this.requestConfigMediaHandler) this.requestConfigMedia.removeEventListener('change', this.requestConfigMediaHandler);
				if (this.requestConfigEscapeHandler) document.removeEventListener('keydown', this.requestConfigEscapeHandler, true);
				if (this.requestConfigFocusTimer) clearTimeout(this.requestConfigFocusTimer);
				const root = this.$root;
				if (root && root.dataset) {
					delete root.dataset.manjaRequestConfigControlsReady;
					delete root.dataset.manjaRequestConfigEnhanced;
				}
			},
			openRequestConfig() {
				if (this.requestConfigDesktop) {
					this.requestConfigDesktopVisible = true;
					this.$nextTick(() => {
						if (this.$refs.requestConfigDesktopToggle) this.$refs.requestConfigDesktopToggle.focus({ preventScroll: true });
					});
					return;
				}
				this.requestConfigOpen = true;
				this.$nextTick(() => {
					requestAnimationFrame(() => requestAnimationFrame(() => {
						if (this.$refs.requestConfigClose) this.$refs.requestConfigClose.focus({ preventScroll: true });
					}));
				});
			},
			focusRequestConfigTrigger() {
				const trigger = this.$refs.requestConfigTrigger;
				if (trigger && trigger.getClientRects().length > 0 && !trigger.disabled) trigger.focus({ preventScroll: true });
			},
			closeRequestConfig() {
				this.requestConfigOpen = false;
				this.requestConfigTouchStartY = null;
				this.requestConfigTouchStartX = null;
				this.$nextTick(() => {
					if (this.requestConfigFocusTimer) clearTimeout(this.requestConfigFocusTimer);
					this.requestConfigFocusTimer = setTimeout(() => {
						this.requestConfigFocusTimer = null;
						requestAnimationFrame(() => requestAnimationFrame(() => {
							const trigger = this.$refs.requestConfigTrigger;
							if (trigger && trigger.getClientRects().length > 0 && !trigger.disabled) {
								trigger.focus({ preventScroll: true });
							} else if (this.$refs.requestConfigSheet) {
								this.$refs.requestConfigSheet.focus({ preventScroll: true });
							}
						}));
					}, 0);
				});
			},
			requestConfigTouchStart(event) {
				if (this.requestConfigDesktop || !this.requestConfigOpen) return;
				const touch = event.touches && event.touches[0];
				if (!touch) return;
				this.requestConfigTouchStartY = touch.clientY;
				this.requestConfigTouchStartX = touch.clientX;
			},
			requestConfigTouchEnd(event) {
				if (this.requestConfigDesktop || !this.requestConfigOpen || this.requestConfigTouchStartY === null) return;
				const touch = event.changedTouches && event.changedTouches[0];
				const startY = this.requestConfigTouchStartY;
				const startX = this.requestConfigTouchStartX;
				this.requestConfigTouchStartY = null;
				this.requestConfigTouchStartX = null;
				if (!touch || startX === null) return;
				const deltaY = touch.clientY - startY;
				const deltaX = Math.abs(touch.clientX - startX);
				if (deltaY > 64 && deltaY > deltaX * 1.25) this.closeRequestConfig();
			}
		}"
		x-on:keydown.escape.window="if (requestConfigOpen && !requestConfigDesktop) closeRequestConfig()"
		x-on:manja:request-config-open.window="openRequestConfig()"
		x-bind:data-request-config-desktop-open="(requestConfigDesktop && requestConfigDesktopVisible).toString()"
	>
		<div class="manja-endpoint-shell-layout">
			<div class="manja-endpoint-main min-w-0">
				if !opts.OperationIdentityInHeader {
					<div class="border-b border-outline pb-6 dark:border-outline-dark">
						if op.Deprecated {
							<div class="mb-3 flex flex-wrap items-center gap-2">
								@badge.Badge(badge.Config{Label: "Deprecated", Tone: badge.ToneWarning, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
							</div>
						}
						<div aria-label="Endpoint route" class="mt-4 inline-flex max-w-full items-center gap-3 rounded-radius border border-outline bg-surface-alt px-3 py-2 dark:border-outline-dark dark:bg-surface-dark-alt">
							@methodBadge(op.Method)
							<p class="min-w-0 break-words font-mono text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ op.Path }</p>
						</div>
						if hasMarkdown(opts.MarkdownRenderer, op.Description) {
							<div class="mt-4 max-w-[70ch]">
								@renderedMarkdown(opts.MarkdownRenderer, op.Description)
							</div>
						} else if op.Description != "" {
							<p class="mt-4 max-w-[70ch] text-base leading-6 text-on-surface dark:text-on-surface-dark">{ op.Description }</p>
						}
					</div>
				}
				if operationHasRequest(op) || len(op.Responses) > 0 {
					<div class={ endpointDetailLayoutClass(op) }>
						if operationHasRequest(op) {
							<section class="grid gap-8" aria-label="Request">
								<h4 class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Request</h4>
								@authorizationDocumentation(op.Security)
								@paramGroup(opID, "Path Parameters", parametersIn(op.Parameters, "path"), opts)
								@paramGroup(opID, "Query Parameters", parametersIn(op.Parameters, "query"), opts)
								@paramGroup(opID, "Header Parameters", parametersIn(op.Parameters, "header"), opts)
								if op.RequestBody != nil {
									<section data-manja-request-body class="grid min-w-0 gap-4 rounded-radius border border-outline p-4 dark:border-outline-dark" aria-label="Request body">
										<div class="flex flex-wrap items-center justify-between gap-3">
											<h5 class="font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Body Params</h5>
											@schemaPropertyState(schemaPropertyStateLabel(op.RequestBody.Required))
										</div>
										if op.RequestBody.Description != "" {
											if hasMarkdown(opts.MarkdownRenderer, op.RequestBody.Description) {
												<div class="max-w-[70ch] text-sm">
													@renderedMarkdown(opts.MarkdownRenderer, op.RequestBody.Description)
												</div>
											} else {
												<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ op.RequestBody.Description }</p>
											}
										}
										@mediaTypeList(opID+"-request-body", "Request body", op.RequestBody.MediaTypes, opts)
									</section>
								}
							</section>
						}
						if len(op.Responses) > 0 {
							<section class="manja-endpoint-responses-section grid gap-5" aria-label="Responses">
								<h4 class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Responses</h4>
								@accordion.Accordion(responseAccordionConfig(opID, op.Responses, exampleSpecJSON, opts))
							</section>
						}
					</div>
				}
				@operationNavigation(navigation)
			</div>
			if operationHasRail(op, servers) {
				<aside
					id={ requestConfigID }
					class="manja-endpoint-examples-rail manja-request-config-sheet"
					data-manja-request-config-sheet
					x-ref="requestConfigSheet"
					tabindex="-1"
					data-open="false"
					x-bind:data-open="(requestConfigDesktop ? requestConfigDesktopVisible : requestConfigOpen).toString()"
					x-bind:role="requestConfigDesktop ? null : 'dialog'"
					x-bind:aria-modal="requestConfigDesktop ? null : 'true'"
					x-bind:aria-hidden="requestConfigDesktop ? null : (!requestConfigOpen).toString()"
					aria-labelledby={ requestConfigTitleID }
					x-trap.inert.noscroll="requestConfigOpen && !requestConfigDesktop"
					x-on:keydown.esc.prevent="if (requestConfigOpen && !requestConfigDesktop) closeRequestConfig()"
					aria-label="Request configuration panel"
				>
					<header
						class="manja-request-config-sheet-header flex items-center justify-between gap-3 border-b border-outline bg-surface-alt px-4 py-3 dark:border-outline-dark dark:bg-surface-dark-alt"
						x-on:touchstart.passive="requestConfigTouchStart($event)"
						x-on:touchend.passive="requestConfigTouchEnd($event)"
						x-on:touchcancel.passive="requestConfigTouchEnd($event)"
					>
						<div class="flex min-w-0 items-center gap-3">
							<span class="manja-request-config-sheet-handle" aria-hidden="true"></span>
							<h2 id={ requestConfigTitleID } class="manja-request-config-title truncate font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ requestConfigLabel }</h2>
						</div>
						<button
							type="button"
							x-ref="requestConfigDesktopToggle"
							x-on:click="requestConfigDesktopVisible = false; $nextTick(() => requestAnimationFrame(() => requestAnimationFrame(() => focusRequestConfigTrigger())))"
							x-bind:aria-expanded="requestConfigDesktopVisible.toString()"
							aria-controls={ requestConfigID }
							aria-label="Collapse request configuration"
							class="manja-request-config-desktop-toggle inline-flex size-9 shrink-0 items-center justify-center rounded-radius border border-outline text-on-surface-strong transition hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:text-on-surface-dark-strong dark:hover:border-primary-dark dark:hover:text-primary-dark dark:focus-visible:outline-primary-dark"
						>
							@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidChevronRight, Size: icon.SizeSM, Decorative: true})
						</button>
						<button
							type="button"
							x-ref="requestConfigClose"
							x-on:click="closeRequestConfig()"
							aria-label="Close request configuration"
							class="manja-request-config-mobile-close inline-flex size-9 shrink-0 items-center justify-center rounded-radius text-on-surface-muted hover:bg-surface-alt hover:text-on-surface-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-on-surface-dark-muted dark:hover:bg-surface-dark-alt dark:hover:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark"
						>
							@requestConfigCloseIcon()
						</button>
					</header>
					<div id={ requestConfigContentID } class="manja-endpoint-examples-rail-content" x-bind:aria-hidden="(requestConfigDesktop ? !requestConfigDesktopVisible : !requestConfigOpen).toString()">
						@endpointExamplesContent(opID, op, servers, exampleSpecJSON)
					</div>
				</aside>
			}
		</div>
		if operationHasRail(op, servers) {
			<div
				class="manja-request-config-backdrop"
				data-manja-request-config-backdrop
				data-open="false"
				x-bind:data-open="(requestConfigOpen && !requestConfigDesktop).toString()"
				x-on:click="closeRequestConfig()"
				aria-hidden="true"
			></div>
			<button
				type="button"
				x-ref="requestConfigTrigger"
				x-bind:aria-haspopup="requestConfigDesktop ? null : 'dialog'"
				aria-controls={ requestConfigID }
				aria-label={ "Expand " + requestConfigLabel }
				x-bind:aria-expanded="(requestConfigDesktop ? requestConfigDesktopVisible : requestConfigOpen).toString()"
				x-on:click="openRequestConfig()"
				class="manja-request-config-trigger-bar"
				data-manja-request-config-trigger
				data-request-config-trigger-variant="bar"
				data-open="false"
				x-bind:data-open="(requestConfigDesktop ? requestConfigDesktopVisible : requestConfigOpen).toString()"
			>
				<span class="manja-request-config-trigger-label">{ requestConfigLabel }</span>
				@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidChevronLeft, Size: icon.SizeSM, Decorative: true})
			</button>
		}
	</section>
}

templ operationNavigation(navigation OperationNavigationData) {
	if navigation.Previous != nil || navigation.Next != nil {
		<nav data-manja-operation-navigation data-manja-operation-group={ navigation.Group } aria-label={ operationNavigationLabel(navigation.Group) } class="mt-10 border-t border-outline pt-6 dark:border-outline-dark">
			<div class="grid gap-3 lg:grid-cols-2">
				if navigation.Previous != nil {
					@operationNavigationLink(*navigation.Previous, "previous", navigation)
				}
				if navigation.Next != nil {
					@operationNavigationLink(*navigation.Next, "next", navigation)
				}
			</div>
		</nav>
	}
}

templ operationNavigationLink(item OperationNavigationItem, direction string, navigation OperationNavigationData) {
	if navigation.Catalog {
		<a
			data-manja-operation-neighbor={ direction }
			href={ templpkg.URL(item.Href) }
			hx-get={ item.Href }
			hx-target="#main-content"
			hx-select="#main-content"
			hx-select-oob="#catalog-navigation"
			hx-swap="outerHTML show:#main-content:top"
			hx-push-url="true"
			class={ operationNavigationLinkClass(direction) }
		>
			@operationNavigationLinkContent(item, direction)
		</a>
	} else {
		<a
			data-manja-operation-neighbor={ direction }
			href={ templpkg.URL(item.Href) }
			hx-get={ item.Href }
			hx-target="#main-content"
			hx-swap="innerHTML swap:120ms settle:240ms"
			hx-push-url="true"
			hx-indicator="#public-docs-loading"
			class={ operationNavigationLinkClass(direction) }
		>
			@operationNavigationLinkContent(item, direction)
		</a>
	}
}

templ operationNavigationLinkContent(item OperationNavigationItem, direction string) {
	if direction == "previous" {
		@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidChevronLeft, Size: icon.SizeSM, Decorative: true, RootClass: "mt-1 shrink-0"})
	}
	<span class={ operationNavigationContentClass(direction) }>
		<span class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ operationNavigationDirectionLabel(direction) }</span>
		<span class={ operationNavigationIdentityClass(direction) }>
			@methodBadge(item.Method)
			<span class="min-w-0 break-words font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ item.Title }</span>
		</span>
	</span>
	if direction == "next" {
		@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidChevronRight, Size: icon.SizeSM, Decorative: true, RootClass: "mt-1 shrink-0"})
	}
}

templ requestConfigCloseIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" fill="none" stroke-width="1.8" class="size-5">
		<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
	</svg>
}

templ endpointExamplesContent(opID string, op core.Operation, servers []core.SpecServer, exampleSpecJSON string) {
	if requestConfigHasContent(op, servers) {
		@requestComposer(opID, op, servers, exampleSpecJSON)
	}
	for _, snippet := range op.Snippets {
		if !requestComposerOwnsSnippet(op, servers, snippet) {
			@codeExample("Request Sample: "+snippet.Label, snippet.Language, snippet.Code)
		}
	}
	if op.RequestBody != nil && !requestConfigHasBody(op, exampleSpecJSON) {
		for _, media := range op.RequestBody.MediaTypes {
			{{ cfg := mediaSchemaExampleConfig(opID+"-request-body-"+anchorFragment(media.ContentType)+"-example", "Request Example: "+media.ContentType, media, exampleSpecJSON) }}
			if hasSchemaExample(cfg) {
				@schemaExample(cfg)
			}
		}
	}
}

templ requestComposer(opID string, op core.Operation, servers []core.SpecServer, exampleSpecJSON string) {
	{{ server := primarySpecServer(servers) }}
	{{ body := requestConfigBodyFor(op, opID, exampleSpecJSON) }}
	{{ snippet := requestComposerSnippet(op.Snippets) }}
	{{ items := requestConfigAccordionItems(opID, op, server, body) }}
	<div data-manja-request-composer class="grid min-w-0 gap-6">
		if len(items) > 0 {
			<section class="grid min-w-0 gap-2" data-manja-request-config-panel aria-labelledby={ opID + "-request-config-heading" }>
				<p id={ opID + "-request-config-heading" } class="px-1 text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Request configuration</p>
				@accordion.Accordion(accordion.AccordionConfig{
					ID:            opID + "-request-config-accordion",
					Items:         items,
					AllowMultiple: true,
					Appearance:    accordion.AppearanceDefault,
					RootClass:     "min-w-0 shadow-sm",
				})
			</section>
		}
		<div data-manja-request-sample class="min-w-0">
			@requestSampleTargetSelect(opID)
			@codeExample("Request Sample: "+requestSampleTargets()[0].Label, requestSampleTargets()[0].Language, snippet.Code)
		</div>
		@templpkg.JSONScript(opID+"-request-composer-payload", requestComposerPayload(op, server, body))
	</div>
}

templ requestSampleTargetSelect(opID string) {
	<div
		data-manja-request-sample-target
		x-data="{ requestSampleTarget: 'shell:curl' }"
		x-init="$watch('requestSampleTarget', value => $el.dispatchEvent(new CustomEvent('manja-request-sample-target-change', { detail: { value: value }, bubbles: true })))"
		class="mb-2 max-w-xs"
	>
		@selectfield.Select(selectfield.Config{
			ID:          opID + "-request-sample-target",
			Name:        "requestSampleTarget",
			Placeholder: "Request sample",
			Options:     requestSampleTargetOptions(),
			Alpine:      &selectfield.AlpineConfig{Model: "requestSampleTarget"},
			RootClass:   "w-full",
		})
	</div>
}

func requestConfigAccordionItems(opID string, op core.Operation, server core.SpecServer, body requestConfigBody) []accordion.AccordionItem {
	items := make([]accordion.AccordionItem, 0, 4)
	if fields := requestServerVariableFields(server); len(fields) > 0 {
		items = append(items, accordion.AccordionItem{
			ID:                opID + "-server-variables",
			Title:             "Server Variables",
			Content:           requestConfigFieldsContent(fields, "server"),
			InitiallyExpanded: true,
		})
	}
	if fields := requestParameterFields(op.Parameters); len(fields) > 0 {
		items = append(items, accordion.AccordionItem{
			ID:                opID + "-parameters",
			Title:             "Parameters",
			Content:           requestConfigFieldsContent(fields, "parameters"),
			InitiallyExpanded: true,
		})
	}
	if body.Has {
		items = append(items, accordion.AccordionItem{
			ID:                opID + "-body",
			Title:             "Body",
			Content:           requestConfigBodyContent(opID, body.Config),
			InitiallyExpanded: true,
		})
	}
	return items
}

templ requestConfigFieldsContent(fields []schemaform.Field, namePrefix string) {
	<div class="manja-request-config-fields" data-manja-request-config-fields>
		@schemaform.Fields(schemaform.FieldsConfig{
			Fields:     fields,
			NamePrefix: namePrefix,
		})
	</div>
}

templ authorizationDocumentation(security []core.OperationSecurity) {
	if len(security) > 0 {
		<section data-manja-authorization aria-label="Authorization requirements" class="grid min-w-0 gap-4 rounded-radius border border-outline p-4 dark:border-outline-dark">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h5 class="font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Authorization</h5>
				@badge.Badge(badge.Config{Label: "Read-only", Tone: badge.ToneSecondary, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
			</div>
			<p class="max-w-[70ch] text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Credentials are never accepted or stored on this documentation page.</p>
			<div class="divide-y divide-outline dark:divide-outline-dark">
				for _, item := range security {
					<article data-manja-security-requirement={ item.Name } class="grid gap-3 py-4 first:pt-0 last:pb-0">
						<div class="manja-schema-heading">
							@schemaPropertyIdentity(item.Name, securityTypeLabel(item))
							@schemaPropertyState("required")
						</div>
						if securityInstruction(item) != "" {
							<p class="max-w-[70ch] text-sm text-on-surface dark:text-on-surface-dark">{ securityInstruction(item) }</p>
						}
						if item.Definition.Description != "" {
							<p class="max-w-[70ch] whitespace-pre-wrap text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">{ item.Definition.Description }</p>
						}
						if securityHasMetadata(item) {
							<dl class="grid gap-3 text-sm sm:grid-cols-2">
								if securityParameterName(item) != "" {
									@authorizationField(securityParameterLocation(item), securityParameterName(item))
								}
								if item.Definition.Scheme != "" {
									@authorizationField("Scheme", item.Definition.Scheme)
								}
								if item.Definition.BearerFormat != "" {
									@authorizationField("Bearer format", item.Definition.BearerFormat)
								}
								if item.Definition.OpenIDConnectURL != "" {
									<div class="min-w-0 sm:col-span-2">
										<dt class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">OpenID Connect URL</dt>
										<dd class="mt-1 min-w-0 break-all font-mono text-on-surface-strong dark:text-on-surface-dark-strong">{ item.Definition.OpenIDConnectURL }</dd>
									</div>
								}
							</dl>
						}
						if len(item.Scopes) > 0 {
							<div class="grid gap-2">
								<p class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">Scopes</p>
								<div class="flex flex-wrap gap-2">
									for _, scope := range item.Scopes {
										<code class="rounded-radius bg-surface-alt px-2 py-1 text-xs text-on-surface-strong dark:bg-surface-dark-alt dark:text-on-surface-dark-strong">{ scope }</code>
									}
								</div>
							</div>
						}
					</article>
				}
			</div>
		</section>
	}
}

templ authorizationField(label string, value string) {
	<div class="min-w-0">
		<dt class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ label }</dt>
		<dd class="mt-1 break-words font-mono text-on-surface-strong dark:text-on-surface-dark-strong">{ value }</dd>
	</div>
}

templ requestConfigBodyContent(opID string, cfg ExampleConfig) {
	<div class="grid gap-2" data-manja-request-config-body>
		<label class="sr-only" for={ opID + "-request-body-input" }>Request body JSON</label>
		<div class="manja-request-body-editor relative" data-manja-request-body-editor>
			<pre aria-hidden="true" class="codeblock manja-request-body-highlight pointer-events-none absolute inset-0 min-h-48 overflow-hidden whitespace-pre-wrap break-words rounded-radius border border-transparent px-3 py-2 font-mono text-xs leading-5"><code data-manja-request-body-highlight></code></pre>
			<textarea
				id={ opID + "-request-body-input" }
				data-manja-request-body-input
				spellcheck="false"
				rows="10"
				class="relative min-h-48 w-full resize-y rounded-radius border border-outline bg-surface px-3 py-2 font-mono text-xs leading-5 text-on-surface-strong outline-none placeholder:text-on-surface-muted focus:ring-2 focus:ring-primary dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-strong dark:placeholder:text-on-surface-dark-muted dark:focus:ring-primary-dark"
			>{ exampleFallback(cfg) }</textarea>
		</div>
		@templpkg.JSONScript(opID+"-request-body-payload", schemaExamplePayload(cfg))
		<p data-manja-request-body-status class="sr-only" aria-live="polite"></p>
	</div>
}

templ schemaSection(schema core.Schema, exampleSpecJSON string, opts PublicDocsOptions) {
	{{ summary := schema.Summary }}
	if summary.Name == "" {
		{{ summary.Name = schema.Name }}
	}
	if summary.Description == "" {
		{{ summary.Description = schema.Description }}
	}
	<section id={ schemaAnchor(schema) } class="scroll-mt-24">
		<div class="max-w-3xl border-b border-outline pb-8 dark:border-outline-dark">
			<p class="font-mono text-sm font-semibold uppercase text-on-surface-muted dark:text-on-surface-dark-muted">Schema</p>
			if summary.Description != "" {
				if hasMarkdown(opts.MarkdownRenderer, summary.Description) {
					<div class="mt-6 max-w-[70ch]">
						@renderedMarkdown(opts.MarkdownRenderer, summary.Description)
					</div>
				} else {
					<p class="mt-6 max-w-[70ch] text-base leading-7 text-on-surface dark:text-on-surface-dark">{ summary.Description }</p>
				}
			}
		</div>
		{{ cfg := schemaPageExampleConfig(schema, exampleSpecJSON) }}
		if hasSchemaExample(cfg) {
			<div class="manja-schema-detail-layout">
				<div class="manja-schema-tree-panel">
					@schemaTree(schemaAnchor(schema)+"-tree", schema.Name, summary, opts)
				</div>
				<aside class="manja-schema-example-panel" aria-label="Schema example">
					@schemaExample(cfg)
				</aside>
			</div>
		} else {
			@schemaTree(schemaAnchor(schema)+"-tree", schema.Name, summary, opts)
		}
	</section>
}

templ responsePanel(opID string, response core.OperationResponse, exampleSpecJSON string, opts PublicDocsOptions) {
	<section class="grid gap-4">
		if len(response.MediaTypes) == 0 {
			@responseDescription(response.Description, opts)
			@responseHeaders(response.Headers, opID+"-"+anchorFragment(response.Status)+"-headers", opts)
		}
		@responseMediaTypeList(opID, response, exampleSpecJSON, opts)
	</section>
}

templ responseDescription(description string, opts PublicDocsOptions) {
	if description != "" {
		<div data-manja-response-section="description">
			if hasMarkdown(opts.MarkdownRenderer, description) {
				<div class="max-w-[70ch]">
					@renderedMarkdown(opts.MarkdownRenderer, description)
				</div>
			} else {
				<p class="max-w-[70ch] text-base font-medium text-on-surface dark:text-on-surface-dark">{ description }</p>
			}
		</div>
	}
}

templ responseHeaders(headers []core.OperationResponseHeader, scope string, opts PublicDocsOptions) {
	if len(headers) > 0 {
		<section data-manja-response-section="headers" aria-label="Response headers" class="grid gap-3">
			<h6 class="font-title text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Headers</h6>
			<div class="manja-schema-tree">
				<div class="manja-schema-root">
					for _, header := range headers {
						@schemaTreeNode(header.Name, "", responseHeaderSummary(header), scope, false, opts)
					}
				</div>
			</div>
		</section>
	}
}

func responseHeaderSummary(header core.OperationResponseHeader) core.SchemaSummary {
	summary := header.Schema
	if strings.TrimSpace(summary.Description) == "" {
		summary.Description = header.Description
	}
	if strings.TrimSpace(summary.Example) == "" {
		summary.Example = header.Example
	}
	return summary
}

templ mediaTypeList(idPrefix string, label string, mediaTypes []core.OperationMediaType, opts PublicDocsOptions) {
	if len(mediaTypes) > 0 {
		<div class="grid gap-3">
			for _, media := range mediaTypes {
				<div data-manja-request-body-media={ media.ContentType } class="min-w-0 border-t border-outline pt-4 dark:border-outline-dark">
					<div class="flex flex-wrap items-center gap-3">
						@badge.Badge(badge.Config{Label: media.ContentType, Tone: badge.ToneDefault, Appearance: badge.AppearanceSoft, Size: badge.SizeSM, RootClass: "shrink-0 font-mono"})
						if schemaInline(media.Schema) != "" {
							@schemaTypeLink(media.Schema, opts)
						}
					</div>
					@schemaProperties(mediaTypeTableID(idPrefix, media), label+" schema for "+media.ContentType, media.Schema, opts)
				</div>
			}
		</div>
	}
}

templ responseMediaTypeList(opID string, response core.OperationResponse, exampleSpecJSON string, opts PublicDocsOptions) {
	if len(response.MediaTypes) > 0 {
		if len(response.MediaTypes) > 1 {
			{{ items := responseMediaAccordionItems(opID, response, exampleSpecJSON, opts) }}
			@accordion.Accordion(accordion.AccordionConfig{
				ID:            opID + "-response-" + anchorFragment(response.Status) + "-media-types",
				Items:         items,
				Appearance:    accordion.AppearancePlain,
				RootClass:     "manja-response-media-accordion",
			})
		} else {
			<div class="grid gap-4">
				@responseMediaTypeBlock(opID, response, response.MediaTypes[0], exampleSpecJSON, opts, false)
			</div>
		}
	}
}

func responseMediaAccordionItems(opID string, response core.OperationResponse, exampleSpecJSON string, opts PublicDocsOptions) []accordion.AccordionItem {
	items := make([]accordion.AccordionItem, 0, len(response.MediaTypes))
	for i, media := range response.MediaTypes {
		items = append(items, accordion.AccordionItem{
			ID:                opID + "-response-" + anchorFragment(response.Status) + "-" + anchorFragment(media.ContentType),
			Title:             media.ContentType,
			Content:           responseMediaTypeBlock(opID, response, media, exampleSpecJSON, opts, true),
			InitiallyExpanded: i == 0,
		})
	}
	return items
}

templ responseMediaTypeBlock(opID string, response core.OperationResponse, media core.OperationMediaType, exampleSpecJSON string, opts PublicDocsOptions, inAccordion bool) {
	{{ idPrefix := opID+"-response-"+anchorFragment(response.Status) }}
	{{ cfg := mediaSchemaExampleConfig(idPrefix+"-"+anchorFragment(media.ContentType)+"-example", "Response Example: "+response.Status+" "+media.ContentType, media, exampleSpecJSON) }}
	{{ blockClass := "manja-response-media-block" }}
	if inAccordion {
		{{ blockClass += " grid gap-4" }}
	} else {
		{{ blockClass += " border-t border-outline pt-6 pb-5 dark:border-outline-dark" }}
	}
	<div class={ blockClass }>
		<div class="manja-response-panel-layout">
			<div class="manja-response-panel-main grid gap-4">
				<div data-manja-response-section="media-type" class="flex flex-wrap items-center gap-3">
					<span class="font-mono text-xs font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ media.ContentType }</span>
					if schemaInline(media.Schema) != "" {
						@schemaTypeLink(media.Schema, opts)
					}
				</div>
				@responseDescription(response.Description, opts)
				@responseHeaders(response.Headers, idPrefix+"-"+anchorFragment(media.ContentType)+"-headers", opts)
				@schemaProperties(mediaTypeTableID(idPrefix, media), "Response body", media.Schema, opts)
			</div>
			if hasResponseExample(media) {
				<aside class="manja-response-panel-example" aria-label={ "Response " + response.Status + " " + media.ContentType + " example" }>
					@schemaExample(cfg)
				</aside>
			}
		</div>
	</div>
}

templ paramGroup(idPrefix string, title string, parameters []core.OperationParameter, opts PublicDocsOptions) {
	if len(parameters) > 0 {
		{{ groupID := idPrefix + "-" + anchorFragment(title) }}
		<section class="grid min-w-0 gap-4" aria-labelledby={ groupID + "-heading" }>
			<h5 id={ groupID + "-heading" } class="font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h5>
			<dl id={ groupID } data-manja-parameter-list class="divide-y divide-outline border-y border-outline dark:divide-outline-dark dark:border-outline-dark">
				for _, parameter := range parameters {
					@parameterRow(groupID, parameter, opts.MarkdownRenderer)
				}
			</dl>
		</section>
	}
}

templ parameterRow(groupID string, parameter core.OperationParameter, renderer port.MarkdownRenderer) {
	{{ rowID := groupID + "-" + anchorFragment(parameter.In+"-"+parameter.Name) }}
	<div id={ rowID } data-manja-parameter-row class="min-w-0 py-4 first:pt-3 last:pb-3">
		<dt class="flex min-w-0 items-start justify-between gap-4">
			@schemaPropertyIdentity(parameter.Name, firstNonEmpty(schemaInline(parameter.Schema), parameter.In))
			@schemaPropertyState(schemaPropertyStateLabel(parameter.Required))
		</dt>
		if strings.TrimSpace(parameter.Description) != "" || strings.TrimSpace(parameter.Example) != "" {
			<dd class="mt-2 min-w-0 text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">
				@parameterDescriptionCell(rowID, renderer, parameter.Description, parameter.Example)
			</dd>
		}
	</div>
}

templ schemaProperties(id string, caption string, schema core.SchemaSummary, opts PublicDocsOptions) {
	if schemaTreeHasContent(schema) {
		<div class="mt-4">
			@schemaTree(id, caption, schema, opts)
		</div>
	}
}

templ schemaTree(id string, caption string, schema core.SchemaSummary, opts PublicDocsOptions) {
	<section id={ id } aria-label={ caption + " schema tree" } class="manja-schema-tree">
		if schemaTreeExpandable(schema) {
			<div class="manja-schema-root">
				@schemaTreeChildNodes(schema, opts, id)
			</div>
		} else {
			@schemaTreeNode(schemaTreeRootName(caption, schema), "", schema, id, true, opts)
		}
	</section>
}

templ schemaTreeNode(name string, propertyState string, schema core.SchemaSummary, scope string, root bool, opts PublicDocsOptions) {
	{{ displayName := schemaTreeDisplayName(name, schema) }}
	{{ rowScope := scope + "-" + anchorFragment(displayName) }}
	if schemaTreeExpandable(schema) {
		if root {
			<details open data-schema-tree-node={ displayName } class="manja-schema-node manja-schema-node-root">
				@schemaTreeSummary(displayName, propertyState, schema, rowScope, opts)
				@schemaTreeChildren(schema, opts, rowScope)
			</details>
		} else {
			<details open data-schema-tree-row={ displayName } class="manja-schema-node">
				@schemaTreeSummary(displayName, propertyState, schema, rowScope, opts)
				@schemaTreeChildren(schema, opts, rowScope)
			</details>
		}
	} else {
		if root {
			<div data-schema-tree-node={ displayName } class="manja-schema-node manja-schema-node-root">
				<div class="manja-schema-row">
					<span class="manja-schema-branch" aria-hidden="true"></span>
					@schemaTreeLabel(displayName, propertyState, schema, rowScope, opts)
				</div>
			</div>
		} else {
			<div data-schema-tree-row={ displayName } class="manja-schema-node">
				<div class="manja-schema-row">
					<span class="manja-schema-branch" aria-hidden="true"></span>
					@schemaTreeLabel(displayName, propertyState, schema, rowScope, opts)
				</div>
			</div>
		}
	}
}

templ schemaTreeSummary(name string, propertyState string, schema core.SchemaSummary, scope string, opts PublicDocsOptions) {
	<summary class="manja-schema-row">
		<span class="manja-schema-branch" aria-hidden="true"></span>
		<span class="manja-schema-caret" aria-hidden="true"></span>
		@schemaTreeLabel(name, propertyState, schema, scope, opts)
	</summary>
}

templ schemaTreeLabel(name string, propertyState string, schema core.SchemaSummary, scope string, opts PublicDocsOptions) {
	<div class="manja-schema-label">
		<div class="manja-schema-heading">
			@schemaTreePropertyIdentity(name, schema, scope, opts)
			@schemaPropertyStates(propertyState, schema.Nullable, schema.Deprecated)
		</div>
		if schema.Description != "" {
			if hasMarkdown(opts.MarkdownRenderer, schema.Description) {
				<div class="manja-schema-description">
					@renderedMarkdown(opts.MarkdownRenderer, schema.Description)
				</div>
			} else {
				<p class="manja-schema-description">{ schema.Description }</p>
			}
		}
		if schema.Default != "" {
			<p class="manja-schema-metadata">
				<span>Default:</span>
				<code>{ schema.Default }</code>
			</p>
		}
		if schema.Example != "" {
			if schemaTreeExampleBlock(schema.Example) {
				<div class="manja-schema-example manja-schema-example-block">
					<span>Example:</span>
					<pre><code>{ schema.Example }</code></pre>
				</div>
			} else {
				<p class="manja-schema-example manja-schema-example-inline">
					<span>Example:</span>
					<code>{ schema.Example }</code>
				</p>
			}
		}
		if len(schema.Enum) > 0 {
			<p class="manja-schema-metadata">
				<span>Allowed:</span>
				for _, value := range schema.Enum {
					<code>{ value }</code>
				}
			</p>
		}
		for _, constraint := range schema.Constraints {
			<p class="manja-schema-metadata"><span>{ constraint.Name }:</span><code>{ constraint.Value }</code></p>
		}
	</div>
}

templ schemaPropertyIdentity(name string, typeLabel string) {
	<div class="manja-schema-identity">
		<span class="manja-schema-name">{ name }</span>
		if typeLabel != "" {
			<span class="manja-schema-type">{ typeLabel }</span>
		}
	</div>
}

templ schemaPropertyState(state string) {
	if state == "required" {
		<span class="manja-schema-property-state" data-required="true">required</span>
	} else if state == "optional" {
		<span class="manja-schema-property-state" data-required="false">optional</span>
	}
}

templ schemaTreePropertyIdentity(name string, schema core.SchemaSummary, scope string, opts PublicDocsOptions) {
	<div class="manja-schema-identity">
		<span class="manja-schema-name">{ name }</span>
		if schemaIsNamedPrimitiveEnumAlias(schema) {
			@schemaEnumAliasType(name, schema, scope, opts)
		} else if typeLabel := schemaInline(schema); typeLabel != "" {
			<span class="manja-schema-type">{ typeLabel }</span>
		}
	</div>
}

templ schemaEnumAliasType(name string, schema core.SchemaSummary, scope string, opts PublicDocsOptions) {
	{{ tooltipID := schemaEnumAliasTooltipID(scope, name, schema) }}
	@tooltip.Tooltip(
		tooltipID,
		schema.Name,
		tooltip.WithDescription(schemaEnumAliasPreview(schema.Enum)),
		tooltip.WithPosition(tooltip.PositionBottom),
		tooltip.WithTrigger(schemaEnumAliasTrigger(schema, opts, tooltipID)),
	)
}

templ schemaEnumAliasTrigger(schema core.SchemaSummary, opts PublicDocsOptions, tooltipID string) {
	{{ href := schemaTypeHref(schema, opts) }}
	<span class="manja-schema-type">{ schemaInlineTypeLabel(schema) }&lt;</span>
	if href != "" {
		<a
			data-manja-schema-enum-reference="true"
			href={ templpkg.URL(href) }
			hx-get={ href }
			hx-target={ opts.SchemaLinkTarget }
			if opts.SchemaLinkSelect != "" {
				hx-select={ opts.SchemaLinkSelect }
			}
			hx-swap={ opts.SchemaLinkSwap }
			hx-push-url="true"
			aria-describedby={ tooltipID }
			aria-label={ "Open schema " + schema.Name }
			title={ "Open schema " + schema.Name }
			class="manja-schema-reference rounded-radius underline-offset-4 transition hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-dark"
		>{ schema.Name }</a>
	} else {
		<span class="manja-schema-type">{ schema.Name }</span>
	}
	<span class="manja-schema-type">&gt;</span>
}

templ schemaPropertyStates(state string, nullable bool, deprecated bool) {
	<span class="flex flex-wrap items-center justify-end gap-2">
		@schemaPropertyState(state)
		if nullable {
			<span class="manja-schema-property-state">nullable</span>
		}
		if deprecated {
			<span class="manja-schema-property-state" data-deprecated="true">deprecated</span>
		}
	</span>
}

templ schemaTreeChildren(schema core.SchemaSummary, opts PublicDocsOptions, scope string) {
	<div class="manja-schema-children">
		@schemaTreeChildNodes(schema, opts, scope)
	</div>
}

templ schemaTreeChildNodes(schema core.SchemaSummary, opts PublicDocsOptions, scope string) {
	if schema.Items != nil && schemaTreeExpandable(*schema.Items) {
		@schemaTreeNode("items", "", *schema.Items, scope, false, opts)
	}
	for _, property := range schema.Properties {
		@schemaTreeNode(property.Name, schemaPropertyStateLabel(property.Required), property.Schema, scope, false, opts)
	}
}

templ codeExample(label string, language string, code string) {
	@codeblock.CodeBlock(codeblock.Config{
		Label:     label,
		Language:  language,
		Code:      code,
		MaxHeight: "24rem",
	})
}

templ schemaExample(cfg ExampleConfig) {
	<div id={ cfg.ID } data-manja-example>
		@codeblock.CodeBlock(codeblock.Config{
			ID: cfg.ID+"-code",
			Label: cfg.Label,
			Language: exampleLanguage(cfg),
			Code: exampleFallback(cfg),
			MaxHeight: "24rem",
		})
		@templpkg.JSONScript(cfg.ID+"-payload", schemaExamplePayload(cfg))
		<p data-manja-example-status class="sr-only" aria-live="polite"></p>
	</div>
}

templ docsSearchField(docs []core.SearchDocument) {
	<div class="shrink-0 px-4 py-3" aria-label="Documentation search">
		@searchfield.SearchField(docsSearchConfig(docs))
	</div>
}

templ docsSearchOpenSlot() {
	<div class="shrink-0 px-4 py-3" aria-label="Documentation search">
		<button
			type="button"
			class="flex min-h-10 w-full items-center gap-2 rounded-radius border border-outline bg-surface px-3 text-left text-sm text-on-surface-muted transition hover:border-outline-strong hover:text-on-surface-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark/50 dark:text-on-surface-dark-muted dark:hover:border-outline-dark-strong dark:hover:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark"
			x-on:click="window.dispatchEvent(new CustomEvent('goshtoso-search-open', { detail: { id: 'docs-search' } }))"
			aria-haspopup="dialog"
			aria-controls="docs-search-dialog"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" class="size-5 shrink-0" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
			</svg>
			<span class="min-w-0 flex-1 truncate">Search docs</span>
		</button>
	</div>
}

func docsSearchConfig(docs []core.SearchDocument) searchfield.Config {
	return searchfield.Config{
		ID:             docsSearchID,
		Label:          "Search docs",
		Placeholder:    "Search operations and schemas",
		GlobalShortcut: true,
		ItemsURL:       "/search.json",
		MatchMode:      searchfield.MatchModeFuzzy,
		MaxResults:     8,
		EmptyText:      "No operations or schemas found.",
	}
}

func responseAccordionConfig(opID string, responses []core.OperationResponse, exampleSpecJSON string, opts PublicDocsOptions) accordion.AccordionConfig {
	items := make([]accordion.AccordionItem, 0, len(responses))
	for _, response := range responses {
		items = append(items, accordion.AccordionItem{
			ID:      opID + "-" + responseTabID(response),
			Title:   responseAccordionTitle(response),
			Icon:    responseStatusBadge(response.Status),
			Content: responsePanel(opID, response, exampleSpecJSON, opts),
		})
	}
	return accordion.AccordionConfig{
		ID:            opID + "-responses",
		Items:         items,
		Appearance:    accordion.AppearancePlain,
		RootClass:     "manja-response-accordion",
	}
}

func responseTabID(response core.OperationResponse) string {
	id := anchorFragment(response.Status)
	if id == "" {
		id = "default"
	}
	return "response-" + id
}

func responseAccordionTitle(response core.OperationResponse) string {
	status := strings.TrimSpace(response.Status)
	if code, err := strconv.Atoi(status); err == nil {
		if title := http.StatusText(code); title != "" {
			return title
		}
	}
	if strings.EqualFold(status, "default") {
		return "Default response"
	}
	return "Response"
}

templ parameterDescriptionCell(id string, renderer port.MarkdownRenderer, description string, example string) {
	if parameterDescriptionNeedsCollapse(description, example) {
		<div x-data="{ expanded: false }" class="manja-parameter-description">
			<div id={ id + "-description" } class="manja-parameter-description-content" data-expanded="true" x-bind:data-expanded="expanded.toString()">
				@parameterDescriptionBody(renderer, description, example)
			</div>
			<button
				type="button"
				x-cloak
				class="manja-description-toggle mt-1 text-xs font-medium text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary-dark dark:focus-visible:outline-primary-dark"
				x-bind:aria-expanded="expanded.toString()"
				aria-controls={ id + "-description" }
				x-on:click="expanded = !expanded"
				x-text="expanded ? 'Show less' : 'Show more'"
			>
				Show more
			</button>
		</div>
	} else {
		<div class="manja-parameter-description">
			@parameterDescriptionBody(renderer, description, example)
		</div>
	}
}

templ parameterDescriptionBody(renderer port.MarkdownRenderer, description string, example string) {
	if strings.TrimSpace(description) != "" {
		if hasMarkdown(renderer, description) {
			@renderedMarkdown(renderer, description)
		} else {
			<p>{ description }</p>
		}
	}
	if strings.TrimSpace(example) != "" {
		<p class="mt-2 text-xs text-on-surface-muted dark:text-on-surface-dark-muted">
			Example:
			<code class="ml-1 rounded-radius bg-surface-alt px-1.5 py-0.5 font-mono text-xs text-on-surface-strong dark:bg-surface-dark-alt dark:text-on-surface-dark-strong">{ example }</code>
		</p>
	}
}

func parameterDescriptionNeedsCollapse(description string, example string) bool {
	text := strings.TrimSpace(description)
	if example != "" {
		if text != "" {
			text += " "
		}
		text += "Example: " + example
	}
	return utf8.RuneCountInString(text) > 220 || strings.Count(text, "\n") >= 4
}

func mediaTypeTableID(idPrefix string, media core.OperationMediaType) string {
	contentType := anchorFragment(media.ContentType)
	if contentType == "" {
		contentType = "media"
	}
	return idPrefix + "-" + contentType + "-schema"
}

func mediaSchemaExampleConfig(id string, label string, media core.OperationMediaType, specJSON string) ExampleConfig {
	return ExampleConfig{
		ID:          id,
		Label:       label,
		Language:    "json",
		SchemaJSON:  media.Schema.JSON,
		ExampleJSON: media.Example,
		ExplicitExample: media.ExampleProvided,
		SpecJSON:    specJSON,
		Options:     defaultExampleOptions(),
	}
}

func schemaPageExampleConfig(schema core.Schema, specJSON string) ExampleConfig {
	return ExampleConfig{
		ID:          schemaAnchor(schema) + "-example",
		Label:       "Example: " + schema.Name,
		Language:    "json",
		SchemaJSON:  schema.Example.JSON,
		ExampleJSON: schema.Example.Example,
		ExplicitExample: schema.Example.Provided,
		SpecJSON:    specJSON,
		Options: ExampleOptions{
			SkipNonRequired: false,
			Quiet:           true,
			MaxSampleDepth:  4,
		},
	}
}

func defaultExampleOptions() ExampleOptions {
	return ExampleOptions{
		SkipNonRequired: false,
		Quiet:           true,
		MaxSampleDepth:  3,
	}
}

func hasSchemaExample(cfg ExampleConfig) bool {
	return strings.TrimSpace(cfg.SchemaJSON) != "" || strings.TrimSpace(cfg.ExampleJSON) != ""
}

func hasResponseExample(media core.OperationMediaType) bool {
	return strings.TrimSpace(media.Example) != ""
}

func exampleLanguage(cfg ExampleConfig) string {
	if strings.TrimSpace(cfg.Language) != "" {
		return cfg.Language
	}
	return "json"
}

func exampleFallback(cfg ExampleConfig) string {
	if strings.TrimSpace(cfg.ExampleJSON) != "" {
		return cfg.ExampleJSON
	}
	return "Example unavailable"
}

func schemaExamplePayload(cfg ExampleConfig) map[string]any {
	payload := map[string]any{
		"options": cfg.Options,
	}
	if cfg.ExplicitExample && strings.TrimSpace(cfg.ExampleJSON) != "" {
		payload["hasExplicitExample"] = true
	}
	var schema any
	if strings.TrimSpace(cfg.SchemaJSON) != "" {
		if err := json.Unmarshal([]byte(cfg.SchemaJSON), &schema); err != nil {
			schema = nil
		}
	}
	payload["schema"] = schema
	if strings.TrimSpace(cfg.SpecJSON) != "" {
		var spec any
		if err := json.Unmarshal([]byte(cfg.SpecJSON), &spec); err == nil {
			payload["spec"] = spec
		}
	}
	return payload
}

func sidebarSections(idx core.SpecIndex, selectedAnchor string, labelMode EndpointSidebarLabelMode, idPrefix string) []sidebar.Section {
	sections := make([]sidebar.Section, 0, 2)
	if len(idx.Operations) > 0 {
		tagOrder := make([]string, 0)
		tagItems := map[string][]sidebar.Item{}
		tagOpen := map[string]bool{}
		for _, op := range idx.Operations {
			tags := op.Tags
			if len(tags) == 0 {
				tags = []string{"Untagged"}
			}
			for _, tag := range tags {
				tag = strings.TrimSpace(tag)
				if tag == "" {
					tag = "Untagged"
				}
				if _, ok := tagItems[tag]; !ok {
					tagOrder = append(tagOrder, tag)
				}
				anchor := operationAnchor(op)
				active := anchor == selectedAnchor
				if active {
					tagOpen[tag] = true
				}
				label := operationSidebarLabel(op, labelMode)
				href := selectedDocsHref(anchor)
					tagItems[tag] = append(tagItems[tag], sidebar.Item{
						ID:         sidebarItemID(idPrefix, anchor),
						Label:      label,
						Href:       href,
						Active:     active,
						Badge:      op.Method,
						LinkAttrs:  sidebarOperationNavigationAttrs(label, href, op.Method),
					})
			}
		}
		items := make([]sidebar.Item, 0, len(tagOrder))
		for _, tag := range tagOrder {
			items = append(items, sidebar.Item{
				ID:        sidebarItemID(idPrefix, "tag-"+anchorFragment(tag)),
				Label:     tag,
				Href:      "#",
				Open:      tagOpen[tag],
				Items:     tagItems[tag],
				LinkAttrs: sidebarTagAttrs(tag),
			})
		}
		sections = append(sections, sidebar.Section{Title: "Operations", Collapsible: true, Items: items})
	}
	if len(idx.Schemas) > 0 {
		items := make([]sidebar.Item, 0, len(idx.Schemas))
		for _, schema := range idx.Schemas {
			anchor := schemaAnchor(schema)
			label := schemaSidebarLabel(schema)
			href := selectedDocsHref(anchor)
			items = append(items, sidebar.Item{
				ID:        sidebarItemID(idPrefix, anchor),
				Label:     label,
				Href:      href,
				Active:    anchor == selectedAnchor,
				LinkAttrs: sidebarNavigationAttrs(label, href),
			})
		}
		sections = append(sections, sidebar.Section{Title: "Schemas", Items: items, IndentItems: true})
	}
	return sections
}

func sidebarItemID(prefix string, id string) string {
	prefix = strings.TrimSpace(prefix)
	if prefix == "" {
		return id
	}
	return prefix + "-" + id
}

func selectedDocsItemFor(idx core.SpecIndex, selectedID string) selectedDocsItem {
	selectedID = strings.TrimPrefix(strings.TrimSpace(selectedID), "#")
	if selectedID == "" || selectedID == "overview" {
		return selectedDocsItem{Anchor: "overview", Kind: "overview"}
	}
	for _, op := range idx.Operations {
		anchor := operationAnchor(op)
		if anchor == selectedID {
			return selectedDocsItem{Anchor: anchor, Kind: "operation", Operation: op}
		}
	}
	for _, schema := range idx.Schemas {
		anchor := schemaAnchor(schema)
		if anchor == selectedID {
			return selectedDocsItem{Anchor: anchor, Kind: "schema", Schema: schema}
		}
	}
	return selectedDocsItem{Anchor: selectedID, Kind: "missing"}
}

func publicDocsPageTitle(idx core.SpecIndex, selected selectedDocsItem) string {
	switch selected.Kind {
	case "operation":
		return operationTitle(selected.Operation)
	case "schema":
		return selected.Schema.Name
	case "missing":
		return "Documentation not found"
	default:
		return firstNonEmpty(idx.Title, "OpenAPI documentation")
	}
}

func publicPageMarkdownHref(selected selectedDocsItem) string {
	query := url.Values{}
	query.Set("format", "markdown")
	query.Set("selected", selected.Anchor)
	return "/?" + query.Encode()
}

func publicDocsPageDescription(idx core.SpecIndex, selected selectedDocsItem) string {
	switch selected.Kind {
	case "operation":
		return strings.TrimSpace(strings.ToUpper(selected.Operation.Method) + " " + selected.Operation.Path)
	case "schema":
		return "Schema reference"
	case "missing":
		return "The requested documentation is not part of this contract."
	default:
		if idx.Version != "" {
			return "OpenAPI " + idx.Version
		}
		return "OpenAPI contract overview"
	}
}

func publicDocsDocumentTitle(idx core.SpecIndex, selected selectedDocsItem) string {
	pageTitle := publicDocsPageTitle(idx, selected)
	if strings.HasSuffix(pageTitle, " · Manja") {
		return pageTitle
	}
	return pageTitle + " · Manja"
}

// ResolvePublicDocsSelection normalizes and resolves a request selection once.
func ResolvePublicDocsSelection(idx core.SpecIndex, selectedID string) PublicDocsSelection {
	return PublicDocsSelection{item: selectedDocsItemFor(idx, selectedID)}
}

// PublicDocsMetadataDescription returns the resolved route's source description.
func PublicDocsMetadataDescription(idx core.SpecIndex, selected PublicDocsSelection) string {
	return publicDocsMetadataDescription(idx, selected.item)
}

func publicDocsMetadataDescription(idx core.SpecIndex, selected selectedDocsItem) string {
	switch selected.Kind {
	case "operation":
		return firstNonEmpty(
			selected.Operation.Description,
			selected.Operation.Summary,
			strings.TrimSpace(strings.ToUpper(selected.Operation.Method)+" "+selected.Operation.Path),
		)
	case "schema":
		return firstNonEmpty(
			selected.Schema.Description,
			selected.Schema.Summary.Description,
			"Schema reference for "+selected.Schema.Name+".",
		)
	case "missing":
		return "The requested documentation is not part of this contract."
	default:
		return firstNonEmpty(
			idx.Overview.Description,
			"Browse OpenAPI operations and schemas for "+firstNonEmpty(idx.Title, "this contract")+".",
		)
	}
}

func publicDocsPageMetadata(idx core.SpecIndex, selected selectedDocsItem, metadata PageMetadata) PageMetadata {
	metadata.Title = publicDocsDocumentTitle(idx, selected)
	if strings.TrimSpace(metadata.Description) == "" {
		metadata.Description = publicDocsMetadataDescription(idx, selected)
	}
	if selected.Kind == "missing" {
		metadata.Robots = "noindex,follow"
	}
	return metadata
}

func operationBreadcrumbItems(idx core.SpecIndex, op core.Operation, fallbackAnchor string) []breadcrumbs.Item {
	items := []breadcrumbs.Item{{
		Label: "Home",
		Href:  selectedDocsHref("overview"),
	}}
	tag := operationBreadcrumbTag(op)
	if tag != "" {
		items = append(items, breadcrumbs.Item{
			Label: tag,
			Href:  operationTagBreadcrumbHref(idx, tag, fallbackAnchor),
		})
	}
	return items
}

func operationBreadcrumbTag(op core.Operation) string {
	for _, tag := range op.Tags {
		if tag = strings.TrimSpace(tag); tag != "" {
			return tag
		}
	}
	return "Untagged"
}

func publicOperationNavigation(idx core.SpecIndex, selected core.Operation) OperationNavigationData {
	group := operationBreadcrumbTag(selected)
	navigation := OperationNavigationData{Group: group}
	selectedAnchor := operationAnchor(selected)
	groupOperations := make([]core.Operation, 0, len(idx.Operations))
	for _, operation := range idx.Operations {
		if strings.EqualFold(operationBreadcrumbTag(operation), group) {
			groupOperations = append(groupOperations, operation)
		}
	}
	for index, operation := range groupOperations {
		if operationAnchor(operation) != selectedAnchor {
			continue
		}
		if index > 0 {
			previous := groupOperations[index-1]
			navigation.Previous = &OperationNavigationItem{
				Title: operationTitle(previous),
				Method: previous.Method,
				Href: selectedDocsHref(operationAnchor(previous)),
			}
		}
		if index+1 < len(groupOperations) {
			next := groupOperations[index+1]
			navigation.Next = &OperationNavigationItem{
				Title: operationTitle(next),
				Method: next.Method,
				Href: selectedDocsHref(operationAnchor(next)),
			}
		}
		break
	}
	return navigation
}

func operationNavigationLabel(group string) string {
	return "More operations in " + firstNonEmpty(strings.TrimSpace(group), "Untagged")
}

func operationNavigationLinkClass(direction string) string {
	className := "group flex min-w-0 items-start gap-3 rounded-radius border border-outline bg-surface p-4 transition-colors hover:border-primary hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark dark:hover:border-primary-dark dark:hover:bg-surface-dark-alt dark:focus-visible:outline-primary-dark"
	if direction == "next" {
		className += " text-right sm:col-start-2"
	}
	return className
}

func operationNavigationContentClass(direction string) string {
	className := "flex min-w-0 flex-1 flex-col gap-2"
	if direction == "next" {
		className += " text-right"
	}
	return className
}

func operationNavigationIdentityClass(direction string) string {
	className := "flex w-full min-w-0 items-start gap-2"
	if direction == "next" {
		className += " justify-end"
	}
	return className
}

func operationNavigationDirectionLabel(direction string) string {
	if direction == "previous" {
		return "Previous operation"
	}
	return "Next operation"
}

func operationTagBreadcrumbHref(idx core.SpecIndex, tag string, fallbackAnchor string) string {
	tag = strings.TrimSpace(tag)
	for _, op := range idx.Operations {
		tags := op.Tags
		if len(tags) == 0 {
			tags = []string{"Untagged"}
		}
		for _, opTag := range tags {
			if strings.EqualFold(strings.TrimSpace(opTag), tag) {
				return selectedDocsHref(operationAnchor(op))
			}
		}
	}
	return selectedDocsHref(fallbackAnchor)
}

func selectedDocsHref(anchor string) string {
	anchor = strings.TrimPrefix(strings.TrimSpace(anchor), "#")
	if anchor == "" {
		return "/"
	}
	return "/?selected=" + url.QueryEscape(anchor) + "#" + anchor
}

func selectedDocsHrefFromDoc(href string) string {
	anchor, ok := strings.CutPrefix(strings.TrimSpace(href), "#")
	if !ok {
		return href
	}
	return selectedDocsHref(anchor)
}

func sidebarTitleAttrs(label string) templpkg.Attributes {
	label = strings.TrimSpace(label)
	if label == "" {
		return nil
	}
	return templpkg.Attributes{"title": label}
}

func sidebarTagAttrs(label string) templpkg.Attributes {
	attrs := sidebarTitleAttrs(label)
	if attrs == nil {
		attrs = templpkg.Attributes{}
	}
	attrs["data-manja-sidebar-tag"] = "true"
	return attrs
}

func sidebarNavigationAttrs(label string, href string) templpkg.Attributes {
	attrs := sidebarTitleAttrs(label)
	if attrs == nil {
		attrs = templpkg.Attributes{}
	}
	href = strings.TrimSpace(href)
	if href == "" || !strings.HasPrefix(href, "/") {
		return attrs
	}
	attrs["hx-get"] = href
	attrs["hx-target"] = "#main-content"
	attrs["hx-swap"] = "innerHTML swap:120ms settle:240ms"
	attrs["hx-push-url"] = "true"
	attrs["hx-indicator"] = "#public-docs-loading"
	attrs["data-manja-sidebar-nav"] = "true"
	return attrs
}

func sidebarOperationNavigationAttrs(label string, href string, method string) templpkg.Attributes {
	attrs := sidebarNavigationAttrs(label, href)
	if attrs == nil {
		attrs = templpkg.Attributes{}
	}
	attrs["data-manja-method"] = strings.ToUpper(strings.TrimSpace(method))
	return attrs
}

func firstSidebarHref(items []sidebar.Item) string {
	for _, item := range items {
		if item.Href != "" {
			return item.Href
		}
	}
	return "/"
}

templ methodBadge(method string) {
	@badge.Badge(badge.Config{
		Label:     strings.ToUpper(strings.TrimSpace(method)),
		Tone:      methodBadgeTone(method),
		Appearance: badge.AppearanceSoft,
		Size:      badge.SizeSM,
		RootClass: "shrink-0 font-mono font-bold",
	})
}

func methodBadgeTone(method string) badge.Tone {
	switch strings.ToUpper(strings.TrimSpace(method)) {
	case "GET":
		return badge.ToneSuccess
	case "POST":
		return badge.TonePrimary
	case "PUT":
		return badge.ToneWarning
	case "PATCH":
		return badge.ToneWarning
	case "DELETE":
		return badge.ToneDanger
	default:
		return badge.ToneDefault
	}
}

