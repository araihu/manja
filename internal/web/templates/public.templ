}

func operationAnchor(op core.Operation) string {
	if op.Anchor != "" {
		return op.Anchor
	}
	if op.ID != "" {
		return "operation-" + op.ID
	}
	fragment := anchorFragment(op.Method + " " + op.Path)
	if fragment == "" {
		return "operation"
	}
	return "operation-" + fragment
}

func schemaAnchor(schema core.Schema) string {
	return "schema-" + strings.ToLower(schema.Name)
}

func operationTitle(op core.Operation) string {
	if strings.TrimSpace(op.Summary) != "" {
		return op.Summary
	}
	if strings.TrimSpace(op.ID) != "" {
		return op.ID
	}
	return strings.TrimSpace(op.Method + " " + op.Path)
}

func operationSidebarLabel(op core.Operation, labelMode EndpointSidebarLabelMode) string {
	if labelMode == EndpointSidebarLabelPath {
		return firstNonEmpty(op.Path, operationTitle(op))
	}
	return firstNonEmpty(op.Summary, op.Path, operationTitle(op))
}

func schemaSidebarLabel(schema core.Schema) string {
	return firstNonEmpty(schema.Summary.Name, schema.Name)
}

func pluralizedCount(count int, singular string) string {
	label := singular
	if count != 1 {
		label += "s"
	}
	return strconv.Itoa(count) + " " + label
}

func schemaInline(schema core.SchemaSummary) string {
	typeLabel := schema.Type
	if strings.Contains(schema.Type, "array") {
		typeLabel = "array"
		if schema.Items != nil {
			if item := schemaInline(*schema.Items); item != "" {
				typeLabel += "[" + item + "]"
			}
		}
	} else if schema.Format != "" {
		if typeLabel != "" {
			typeLabel += "<" + schema.Format + ">"
		} else {
			typeLabel = schema.Format
		}
	}

	parts := make([]string, 0, 2)
	if schema.Name != "" {
		parts = append(parts, schema.Name)
	}
	if typeLabel != "" {
		parts = append(parts, typeLabel)
	}
	return strings.Join(parts, " ")
}

func schemaTreeRootName(caption string, schema core.SchemaSummary) string {
	if strings.TrimSpace(schema.Name) != "" {
		return schema.Name
	}
	if strings.TrimSpace(caption) != "" {
		return caption
	}
	return "schema"
}

func schemaTreeDisplayName(name string, schema core.SchemaSummary) string {
	if strings.TrimSpace(name) != "" {
		return name
	}
	if strings.TrimSpace(schema.Name) != "" {
		return schema.Name
	}
	return "schema"
}

func schemaTreeHasContent(schema core.SchemaSummary) bool {
	return schemaInline(schema) != "" ||
		strings.TrimSpace(schema.Description) != "" ||
		strings.TrimSpace(schema.Example) != "" ||
		len(schema.Properties) > 0 ||
		schema.Items != nil
}

func schemaTreeExpandable(schema core.SchemaSummary) bool {
	if len(schema.Properties) > 0 {
		return true
	}
	return schema.Items != nil && schemaTreeExpandable(*schema.Items)
}

func schemaTreeExampleBlock(example string) bool {
	trimmed := strings.TrimSpace(example)
	return len(trimmed) > 96 || strings.Contains(trimmed, "\n")
}

func securityLabel(security core.OperationSecurity) string {
	if len(security.Scopes) == 0 {
		return security.Name
	}
	return security.Name + " (" + strings.Join(security.Scopes, ", ") + ")"
}

func operationHasRail(op core.Operation, servers []core.SpecServer) bool {
	if requestConfigHasContent(op, servers) {
		return true
	}
	if len(op.Snippets) > 0 {
		return true
	}
	if op.RequestBody != nil {
		for _, media := range op.RequestBody.MediaTypes {
			if strings.TrimSpace(media.Example) != "" || strings.TrimSpace(media.Schema.JSON) != "" {
				return true
			}
		}
	}
	return false
}

func requestConfigHasContent(op core.Operation, servers []core.SpecServer) bool {
	return len(requestServerVariableFields(primarySpecServer(servers))) > 0 ||
		len(op.Parameters) > 0 ||
		len(op.Security) > 0 ||
		requestConfigHasBody(op, "")
}

func requestConfigHasBody(op core.Operation, exampleSpecJSON string) bool {
	return requestConfigBodyFor(op, operationAnchor(op), exampleSpecJSON).Has
}

func primarySpecServer(servers []core.SpecServer) core.SpecServer {
	for _, server := range servers {
		if server.URL != "" || len(server.Variables) > 0 {
			return server
		}
	}
	return core.SpecServer{}
}

func requestServerVariableFields(server core.SpecServer) []schemaform.Field {
	fields := make([]schemaform.Field, 0, len(server.Variables))
	for _, variable := range server.Variables {
		kind := schemaform.KindString
		if len(variable.Enum) > 0 {
			kind = schemaform.KindEnum
		}
		fields = append(fields, schemaform.Field{
			Path:       variable.Name,
			Label:      variable.Name,
			HelperText: variable.Description,
			Kind:       kind,
			Default:    variable.Default,
			Value:      variable.Default,
			Enum:       append([]string(nil), variable.Enum...),
		})
	}
	return fields
}

func requestParameterFields(parameters []core.OperationParameter) []schemaform.Field {
	fields := make([]schemaform.Field, 0, len(parameters))
	for _, param := range parameters {
		value := firstNonEmpty(param.Schema.Default, param.Example)
		fields = append(fields, schemaform.Field{
			Path:       param.Name,
			Label:      param.Name,
			HelperText: param.Description,
			Kind:       parameterSchemaFormKind(param.Schema),
			Required:   param.Required,
			Default:    value,
			Value:      value,
		})
	}
	return fields
}

func parameterSchemaFormKind(schema core.SchemaSummary) schemaform.Kind {
	switch strings.ToLower(strings.TrimSpace(schema.Type)) {
	case "integer":
		return schemaform.KindInteger
	case "number":
		return schemaform.KindNumber
	case "boolean":
		return schemaform.KindBoolean
	case "array":
		return schemaform.KindArray
	case "object":
		return schemaform.KindUnknown
	default:
		return schemaform.KindString
	}
}

func requestConfigBodyFor(op core.Operation, opID string, exampleSpecJSON string) requestConfigBody {
	if op.RequestBody == nil {
		return requestConfigBody{}
	}
	for _, media := range op.RequestBody.MediaTypes {
		cfg := mediaSchemaExampleConfig(opID+"-request-body-composer", "Body", media, exampleSpecJSON)
		if hasSchemaExample(cfg) {
			return requestConfigBody{Has: true, Media: media, Config: cfg}
		}
	}
	return requestConfigBody{}
}

func requestComposerPayload(op core.Operation, server core.SpecServer, body requestConfigBody) map[string]any {
	payload := map[string]any{
		"method":        strings.ToUpper(op.Method),
		"urlTemplate":   requestComposerURLTemplate(server, op),
		"parameters":    requestComposerParameters(op.Parameters),
		"sampleTargets": requestSampleTargetsPayload(),
	}
	if body.Has {
		payload["bodyContentType"] = body.Media.ContentType
		payload["body"] = schemaExamplePayload(body.Config)
	}
	return payload
}

