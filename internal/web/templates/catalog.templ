package templates

import (
	"fmt"
	"strings"

	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/appshell"
	"github.com/araihu/goshtoso/components/avatar"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/combobox"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/kbd"
	"github.com/araihu/goshtoso/components/pageheader"
	searchcomponent "github.com/araihu/goshtoso/components/search"
	"github.com/araihu/goshtoso/components/sidebar"
	"github.com/araihu/manja/application/catalog"
	core "github.com/araihu/manja/domain"
)

type CatalogDocumentOption struct {
	Key string
	Label string
	Href string
	Selected bool
}

type CatalogSidebarItemData struct {
	ID string
	Label string
	Href string
	Method string
	Active bool
}

type CatalogSidebarGroupData struct {
	ID string
	Label string
	Href string
	Count int
	Open bool
	Items []CatalogSidebarItemData
}

type CatalogOrganizationItem struct {
	ID          string
	Label       string
	Description string
	Href        string
	AvatarSrc   string
	AvatarAlt   string
	AvatarSymbol string
	Initials    string
	Count       int
	Active      bool
}

type CatalogOrganizationNavData struct {
	Visible bool
	Catalogs []CatalogOrganizationItem
	Specs    []CatalogOrganizationItem
}

type CatalogPageData struct {
	Metadata PageMetadata
	Mount string
	SnapshotID catalog.SnapshotID
	Directory catalog.CatalogArtifactV1
	Document *catalog.DocumentDirectoryV1
	DocumentHref string
	SchemaLinks map[string]string
	Documents []CatalogDocumentOption
	Groups []CatalogSidebarGroupData
	OrganizationNav CatalogOrganizationNavData
	Selected *catalog.DetailRecordV1
	OperationView *core.Operation
	OperationServers []core.SpecServer
	Search *CatalogSearchData
	SchemaNode *CatalogSchemaNodeData
	DownloadHref string
	SearchHref string
	SearchChildBase string
	SearchDirectoryPath string
	SearchDirectoryLength uint64
	SearchDirectorySHA256 string
	CurrentVisit *CatalogSearchItemData
}

func catalogNavigationLabel(data CatalogPageData) string {
	if data.OrganizationNav.Visible {
		return "Catalogs and specs"
	}
	return "API sections"
}

type CatalogSearchItemData struct {
	ID string `json:"id,omitempty"`
	Title string `json:"title"`
	Description string `json:"description,omitempty"`
	Href string `json:"href"`
	Kind string `json:"kind,omitempty"`
	Method string `json:"method,omitempty"`
	Path string `json:"path,omitempty"`
	Section string `json:"section,omitempty"`
}

type CatalogSearchData struct {
	Query string
	Results []CatalogSearchResultData
	PostingsScanned uint64
	SegmentsDecoded uint64
	BytesDecoded uint64
}

type CatalogSearchResultData struct {
	Record catalog.SearchRecordV1
	Href string
}

type CatalogSchemaNodeData struct {
	Ordinal uint32
	Name string
	Type string
	Format string
	Description string
	DefaultValue string
	ExampleText string
	Edges []CatalogSchemaEdgeData
	Truncated bool
}

type CatalogSchemaEdgeData struct {
	Name string
	Type string
	Description string
	Required bool
	Href string
}

templ CatalogPage(data CatalogPageData) {
	{{ metadata := data.Metadata }}
	if metadata.Title == "" {
		{{ metadata.Title = catalogPageTitle(data) }}
	}
	@LayoutWithBrandingMetadata(metadata, catalogBranding(data.Directory.Branding), false, false) {
		<script src="/manja-assets/catalog-search.js"></script>
		<div
			hx-history="false"
			x-data="{ catalogNavOpen: false }"
			x-on:keydown.escape.window="if (catalogNavOpen) { catalogNavOpen = false; $nextTick(() => $refs.catalogNavTrigger.focus()) }"
			x-on:resize.window="if (window.innerWidth >= 1024) catalogNavOpen = false"
			class="fixed inset-0 overflow-clip bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark"
		>
			<button
				type="button"
				x-cloak
				x-show="catalogNavOpen"
				x-on:click="catalogNavOpen = false; $nextTick(() => $refs.catalogNavTrigger.focus())"
				aria-label={ "Close " + catalogNavigationLabel(data) }
				data-catalog-navigation-backdrop="true"
				class="fixed inset-0 z-[60] bg-black/40 lg:hidden"
			></button>
			@appshell.AppShell(appshell.Config{
				Header: catalogHeader(data),
				Sidebar: catalogSidebar(data),
				MainID: "main-content",
				RootClass: "h-full",
				RootAttrs: templpkg.Attributes{
					"data-manja-catalog-shell": "true",
					"data-snapshot-id": string(data.SnapshotID),
					"data-catalog-search-href": data.SearchHref,
				},
				HeaderClass: "relative z-50",
				SidebarClass: "h-full w-80",
				SidebarAttrs: templpkg.Attributes{
					"id": "catalog-navigation",
					"aria-label": catalogNavigationLabel(data),
					"x-bind:style": "catalogNavOpen ? 'display: block' : ''",
					"x-bind:class": "catalogNavOpen ? 'fixed inset-y-0 left-0 z-[80] w-80 max-w-full shadow-xl' : ''",
					"x-bind:role": "catalogNavOpen ? 'dialog' : null",
					"x-bind:aria-modal": "catalogNavOpen ? 'true' : null",
					"x-trap.noscroll": "catalogNavOpen",
				},
				MainClass: "min-h-0 overflow-y-auto px-5 py-6 lg:px-10 lg:py-8",
				MainAttrs: templpkg.Attributes{"data-manja-primary-scroll": "true"},
			}) {
				<div class="mx-auto flex min-h-full max-w-[100rem] flex-col">
					if data.Search != nil {
						@catalogSearch(data)
					} else if data.Document == nil {
						@catalogOverview(data)
					} else {
						@catalogDocument(data)
					}
					<footer class="mt-auto border-t border-outline pt-8 pb-4 text-sm text-on-surface-muted dark:border-outline-dark dark:text-on-surface-dark-muted">
						<span aria-hidden="true" class="mr-2 text-primary dark:text-primary-dark">ϟ</span>
						Powered by <strong class="text-on-surface-strong dark:text-on-surface-dark-strong">Manja</strong>
					</footer>
				</div>
			}
			@catalogSearchModal(data)
			@catalogDocumentSelection()
			@catalogSidebarFocusRestoration()
			@catalogSidebarOverflowTooltip()
		</div>
	}
}

templ catalogSearchModal(data CatalogPageData) {
	@templpkg.JSONScript("catalog-search-current-visit", data.CurrentVisit)
	<div
		x-cloak
		x-data="manjaCatalogSearch($el)"
		x-init="init()"
		x-on:goshtoso-search-open.window="if ($event.detail.id === 'catalog-search' && !open) openSearch()"
		x-show="open"
		x-transition.opacity.duration.150ms
		x-trap.inert.noscroll="open"
		x-on:keydown.window="handleWindowKey($event)"
		x-on:click.self="closeSearch()"
		data-search-child-base={ data.SearchChildBase }
		data-search-directory-path={ data.SearchDirectoryPath }
		data-search-directory-length={ fmt.Sprint(data.SearchDirectoryLength) }
		data-search-directory-sha256={ data.SearchDirectorySHA256 }
		data-search-fallback-url={ data.SearchHref + ".json" }
		data-search-mount={ data.Mount }
		data-search-catalog-id={ data.Directory.CatalogID }
		class="fixed inset-0 z-[90] flex items-center justify-center bg-surface-dark/55 p-4 backdrop-blur-md dark:bg-black/60"
		role="dialog"
		aria-modal="true"
		aria-labelledby="catalog-search-label"
		id="catalog-search-dialog"
	>
		<div x-show="open" x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0 translate-y-1" x-transition:enter-end="opacity-100 translate-y-0" class="relative flex w-full max-w-2xl flex-col text-on-surface shadow-2xl shadow-black/20 dark:text-on-surface-dark">
			<div class="relative flex items-center gap-3 rounded-t-radius border border-b-0 border-outline bg-surface px-4 py-3 dark:border-outline-dark dark:bg-surface-dark-alt">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" class="size-5 shrink-0 text-on-surface-muted dark:text-on-surface-dark-muted" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path></svg>
				<label id="catalog-search-label" class="sr-only" for="catalog-search-input">Search operations and schemas</label>
				<input x-ref="input" x-model="query" x-on:input="queueSearch()" x-on:keydown.down.prevent="move(1)" x-on:keydown.up.prevent="move(-1)" x-on:keydown.enter.prevent="choose()" x-on:keydown.escape.prevent="closeSearch()" x-bind:aria-expanded="open.toString()" x-bind:aria-activedescendant="activeOptionID()" id="catalog-search-input" type="text" role="combobox" aria-autocomplete="list" aria-controls="catalog-search-results" maxlength="256" class="min-w-0 flex-1 bg-transparent py-1 text-base text-on-surface-strong placeholder:text-on-surface-muted focus:outline-none dark:text-on-surface-dark-strong dark:placeholder:text-on-surface-dark-muted" placeholder="Operation, path, schema, or content" autocomplete="off" spellcheck="false"/>
				<button type="button" x-cloak x-show="query.length > 0" x-on:click="clearQuery()" aria-label="Clear search" class="inline-flex size-8 items-center justify-center rounded-radius text-on-surface-muted hover:text-on-surface-strong dark:text-on-surface-dark-muted dark:hover:text-on-surface-dark-strong">×</button>
				@kbd.Kbd("Esc", kbd.WithSize(kbd.SizeSM), kbd.WithRootClass("text-on-surface-muted dark:text-on-surface-dark-muted"))
			</div>
			<div id="catalog-search-results" class="flex max-h-[min(28rem,calc(100vh-12rem))] flex-col overflow-hidden overflow-y-auto rounded-b-radius border border-outline bg-surface text-sm font-light dark:border-outline-dark dark:bg-surface-dark-alt" role="listbox" aria-label="Catalog search results" x-bind:aria-busy="loading.toString()">
				<div x-show="query.trim().length === 0" data-catalog-search-recent>
					<p class="border-b border-outline px-4 py-2 text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:border-outline-dark dark:text-on-surface-dark-muted">Recently visited</p>
					<p x-show="recent.length === 0" class="px-4 py-4 text-on-surface-muted dark:text-on-surface-dark-muted">No recently visited items yet.</p>
				</div>
				<p x-show="query.trim().length > 0 && loading" class="px-4 py-4 text-on-surface-muted dark:text-on-surface-dark-muted">Searching…</p>
				<p x-show="query.trim().length > 0 && !loading && error" x-text="error" class="px-4 py-4 text-danger"></p>
				<p x-show="query.trim().length > 0 && !loading && !error && results.length === 0" class="px-4 py-4 text-on-surface-muted dark:text-on-surface-dark-muted">No matching operations or schemas.</p>
				<div class="divide-y divide-outline dark:divide-outline-dark">
					<template x-for="(item, index) in visibleItems()" x-bind:key="item.id || item.href">
						<button type="button" tabindex="-1" data-catalog-search-result x-bind:id="optionID(index)" x-bind:aria-selected="(activeIndex === index).toString()" x-bind:data-catalog-search-recent-result="query.trim().length === 0 ? 'true' : null" x-on:mouseenter="activeIndex = index" x-on:click="select(item)" x-bind:class="activeIndex === index ? 'bg-surface-alt text-on-surface-strong shadow-[inset_2px_0_0_var(--color-outline-strong)] dark:bg-surface-dark dark:text-on-surface-dark-strong' : 'text-on-surface hover:bg-surface-alt dark:text-on-surface-dark dark:hover:bg-surface-dark'" class="flex w-full flex-col gap-2 p-4 text-left transition focus:outline-none" role="option">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0 space-y-1">
									<div class="flex min-w-0 flex-wrap items-center gap-2"><span x-show="item.method" x-text="item.method" class="shrink-0 rounded-radius border border-outline px-1.5 py-0.5 font-mono text-[10px] font-bold uppercase dark:border-outline-dark"></span><strong x-html="highlight(item.title)" class="min-w-0 text-base font-semibold"></strong></div>
									<div x-show="item.kind || item.path" class="flex min-w-0 flex-wrap items-center gap-1.5 text-xs text-on-surface-muted dark:text-on-surface-dark-muted"><span x-html="highlight(item.kind)"></span><span x-show="item.kind && item.path" aria-hidden="true">·</span><code x-show="item.path" x-html="highlight(item.path)" class="min-w-0 font-mono text-[11px]"></code></div>
								</div>
								<span x-show="item.section" x-html="highlight(item.section)" class="shrink-0 rounded-radius border border-outline px-2 py-0.5 text-xs font-medium text-on-surface-muted dark:border-outline-dark dark:text-on-surface-dark-muted"></span>
							</div>
							<p x-show="item.description" x-html="highlight(item.description)" class="line-clamp-2 text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted"></p>
						</button>
					</template>
				</div>
				<p x-show="query.trim().length > 0 && sourceLabel" data-catalog-search-source x-text="sourceLabel" class="border-t border-outline px-4 py-2 text-xs text-on-surface-muted dark:border-outline-dark dark:text-on-surface-dark-muted"></p>
			</div>
		</div>
	</div>
}

templ catalogSearch(data CatalogPageData) {
	<main data-catalog-search="true" class="pb-16">
		<div class="mb-8 border-b border-outline pb-8 dark:border-outline-dark">
			<p class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary dark:text-primary-dark">Global catalog search</p>
			<h1 class="font-title text-4xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Search { data.Directory.Title }</h1>
			<form method="get" action={ data.SearchHref } class="mt-6 flex max-w-3xl gap-3">
				<label for="catalog-search-query" class="sr-only">Search operations and schemas</label>
				<input id="catalog-search-query" name="q" value={ data.Search.Query } maxlength="256" autofocus placeholder="Operation, path, schema, or canonical detail ID" class="min-h-12 min-w-0 flex-1 rounded-radius border border-outline bg-surface px-4 text-on-surface-strong dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-strong"/>
				<button type="submit" class="min-h-12 rounded-radius bg-primary px-5 font-semibold text-on-primary dark:bg-primary-dark dark:text-on-primary-dark">Search</button>
			</form>
		</div>
		if data.Search.Query == "" {
			<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Search across every operation and semantically deduplicated schema without loading the full catalog into the page.</p>
		} else {
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
				<h2 class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ fmt.Sprintf("%d results", len(data.Search.Results)) }</h2>
				<span class="font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ fmt.Sprintf("%d segments · %d postings · %d bytes", data.Search.SegmentsDecoded, data.Search.PostingsScanned, data.Search.BytesDecoded) }</span>
			</div>
			if len(data.Search.Results) == 0 {
				<p class="rounded-radius border border-outline p-5 text-on-surface-muted dark:border-outline-dark dark:text-on-surface-dark-muted">No matching operations or schemas.</p>
			} else {
				<div class="space-y-3" id="catalog-search-results">
					for _, result := range data.Search.Results {
						<a href={ templpkg.URL(result.Href) } class="block rounded-radius border border-outline bg-surface p-5 transition hover:border-primary hover:bg-surface-alt dark:border-outline-dark dark:bg-surface-dark dark:hover:border-primary-dark dark:hover:bg-surface-dark-alt">
							<div class="flex flex-wrap items-center gap-2">
								if result.Record.Method != "" {
									@badge.Badge(badge.Config{Label: result.Record.Method, Tone: catalogMethodTone(result.Record.Method), Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
								}
								<span class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ result.Record.Kind } · { result.Record.DocumentKey }</span>
							</div>
							<h3 class="mt-2 font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ result.Record.Title }</h3>
							if result.Record.Path != "" {
								<code class="mt-2 block break-all text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ result.Record.Path }</code>
							}
							if result.Record.Description != "" {
								<p class="mt-2 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ result.Record.Description }</p>
							}
						</a>
					}
				</div>
			}
		}
	</main>
}

templ catalogHeader(data CatalogPageData) {
	<div class="flex h-16 items-center justify-between gap-4 px-4 lg:px-8">
		<div class="flex min-w-0 items-center gap-3">
			<button
				type="button"
				x-ref="catalogNavTrigger"
				x-on:click="catalogNavOpen = true; $nextTick(() => $refs.catalogNavClose.focus())"
				x-bind:aria-expanded="catalogNavOpen.toString()"
				aria-controls="catalog-navigation"
				aria-label={ "Open " + catalogNavigationLabel(data) }
				class="inline-flex size-10 shrink-0 items-center justify-center rounded-radius border border-outline hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary lg:hidden dark:border-outline-dark dark:hover:bg-surface-dark-alt dark:focus-visible:outline-primary-dark"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
			<a href="/" class="shrink-0 font-title text-base font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Manja</a>
			<span class="text-on-surface-muted dark:text-on-surface-dark-muted">/</span>
			<a href={ templpkg.URL(data.Mount) } class="hidden shrink-0 text-sm font-semibold text-on-surface-muted hover:text-on-surface-strong sm:inline dark:text-on-surface-dark-muted dark:hover:text-on-surface-dark-strong">Catalogs</a>
			<span class="hidden text-on-surface-muted sm:inline dark:text-on-surface-dark-muted">/</span>
			<a href={ templpkg.URL(data.Mount) } class="flex min-w-0 items-center gap-2 font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">
				if data.Directory.Branding.LogoSrc != "" {
					<img src={ templpkg.URL(data.Directory.Branding.LogoSrc) } alt={ data.Directory.Branding.LogoAlt } loading="lazy" decoding="async" class="size-8 shrink-0 rounded-full object-cover"/>
				}
				<span class="max-w-[12rem] truncate">{ catalogBrandName(data) }</span>
			</a>
			<span class="hidden text-on-surface-muted sm:inline dark:text-on-surface-dark-muted">/</span>
			<div class="hidden items-center md:flex">
				<input type="hidden" name={ CatalogDocumentComboboxMountFieldName } value={ data.Mount }/>
				@combobox.Combobox(CatalogDocumentComboboxConfig(), catalogDocumentComboboxState(data.Documents))
			</div>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			@themeToggle()
			<span class="hidden rounded-radius border border-outline px-2 py-1 font-mono text-xs text-on-surface-muted xl:inline dark:border-outline-dark dark:text-on-surface-dark-muted">{ shortSnapshotID(data.SnapshotID) }</span>
		</div>
	</div>
}

templ catalogSidebar(data CatalogPageData) {
	<div class="flex h-full min-h-0 flex-col">
		<div class="flex shrink-0 items-center justify-end p-3 lg:hidden">
			<button
				type="button"
				x-ref="catalogNavClose"
				x-on:click="catalogNavOpen = false; $nextTick(() => $refs.catalogNavTrigger.focus())"
				aria-label={ "Close " + catalogNavigationLabel(data) }
				class="inline-flex size-10 items-center justify-center rounded-radius border border-outline hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:hover:bg-surface-dark-alt dark:focus-visible:outline-primary-dark"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</div>
		<div id="catalog-sidebar-groups" class="flex min-h-0 flex-1 flex-col">
			if data.OrganizationNav.Visible {
				@catalogSidebarSearch()
				@catalogOrganizationNav(data.OrganizationNav)
			} else {
				@sidebar.Sidebar(catalogSidebarConfig(data))
			}
		</div>
	</div>
}

templ catalogOrganizationNav(data CatalogOrganizationNavData) {
	<nav id="catalog-organization-navigation" aria-label="Catalogs and specs" class="flex min-h-0 flex-1 flex-col overflow-y-auto px-3 pb-4">
		@catalogOrganizationSection("Catalogs", heroicons.Icon16SolidRectangleGroup, data.Catalogs)
		@catalogOrganizationSection("Specs", heroicons.Icon16SolidDocumentText, data.Specs)
	</nav>
}

templ catalogOrganizationSection(label string, symbol icon.Symbol, items []CatalogOrganizationItem) {
	<section class="py-3" aria-labelledby={ "catalog-organization-section-" + strings.ToLower(label) }>
		<div class="mb-2 flex items-center gap-2 px-2 text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: symbol, Size: icon.SizeSM, Decorative: true})
			<h2 id={ "catalog-organization-section-" + strings.ToLower(label) }>{ label }</h2>
		</div>
		<div class="grid gap-1">
			for _, item := range items {
				<a
					href={ templpkg.URL(item.Href) }
					if item.Active {
						aria-current="page"
					}
					data-catalog-organization-item={ item.ID }
					class="group flex min-w-0 items-center gap-3 rounded-radius px-2 py-2 text-sm transition hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:hover:bg-surface-dark-alt dark:focus-visible:outline-primary-dark"
				>
					@catalogOrganizationAvatar(item)
					<span class="min-w-0 flex-1">
						<span class="block truncate font-medium text-on-surface-strong group-hover:text-primary dark:text-on-surface-dark-strong dark:group-hover:text-primary-dark">{ item.Label }</span>
						if item.Description != "" {
							<span class="block truncate text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ item.Description }</span>
						}
					</span>
					if item.Count > 0 {
						<span class="shrink-0 rounded-full bg-surface-alt px-2 py-0.5 text-xs font-semibold tabular-nums text-on-surface-muted dark:bg-surface-dark-alt dark:text-on-surface-dark-muted">{ fmt.Sprint(item.Count) }</span>
					}
				</a>
			}
			if len(items) == 0 {
				<p class="px-2 py-2 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">No { strings.ToLower(label) } published yet.</p>
			}
		</div>
	</section>
}

templ catalogSidebarSearch() {
	<div data-catalog-sidebar-search class="shrink-0 px-4 py-3">
		@searchcomponent.SearchField(searchcomponent.Config{
			ID: "catalog-search",
			Label: "Search API...",
			ShortcutText: "⌘ K",
			GlobalShortcut: false,
		})
	</div>
}

templ catalogOverview(data CatalogPageData) {
	<main data-catalog-overview="true" class="pb-16">
		<div class="mb-8 flex flex-wrap items-start justify-between gap-5 border-b border-outline pb-8 dark:border-outline-dark">
			<div>
				<p class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary dark:text-primary-dark">OpenAPI catalog</p>
				<h1 class="font-title text-4xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ data.Directory.Title }</h1>
			</div>
			<a href={ templpkg.URL(data.DownloadHref) } class="inline-flex min-h-11 items-center rounded-radius border border-outline px-4 font-semibold hover:bg-surface-alt dark:border-outline-dark dark:hover:bg-surface-dark-alt">Download catalog JSON</a>
		</div>
		<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
			@catalogMetric("Documents", fmt.Sprintf("%d", len(data.Directory.Documents)))
			@catalogMetric("Operations", fmt.Sprintf("%d", catalogOperationCount(data.Directory)))
			@catalogMetric("Schemas", fmt.Sprintf("%d", catalogSchemaCount(data.Directory)))
			@catalogMetric("Profile", string(data.Directory.ProfileID))
		</div>
		<section class="mt-10" aria-labelledby="catalog-documents-heading">
			<div class="mb-4 flex items-center justify-between gap-3">
				<h2 id="catalog-documents-heading" class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">API groups and versions</h2>
				<span class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ fmt.Sprintf("%d documents", len(data.Documents)) }</span>
			</div>
			<div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
				for _, option := range data.Documents {
					<a href={ templpkg.URL(option.Href) } class="group rounded-radius border border-outline bg-surface p-4 transition hover:border-primary hover:bg-surface-alt dark:border-outline-dark dark:bg-surface-dark dark:hover:border-primary-dark dark:hover:bg-surface-dark-alt">
						<span class="block font-semibold text-on-surface-strong group-hover:text-primary dark:text-on-surface-dark-strong dark:group-hover:text-primary-dark">{ option.Label }</span>
					</a>
				}
			</div>
		</section>
	</main>
}

templ catalogMetric(label string, value string) {
	<div class="rounded-radius border border-outline bg-surface p-5 dark:border-outline-dark dark:bg-surface-dark">
		<p class="text-sm font-medium text-on-surface-muted dark:text-on-surface-dark-muted">{ label }</p>
		<p class="mt-2 break-words font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ value }</p>
	</div>
}

templ catalogDocument(data CatalogPageData) {
	<main data-catalog-document={ data.Document.Key } class="pb-16">
		<div class="mb-8 flex flex-wrap items-start justify-between gap-5 border-b border-outline pb-8 dark:border-outline-dark">
			<div class="min-w-0">
				<h1 class="font-title text-4xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ data.Document.Title }</h1>
			</div>
			if data.Selected == nil {
				<div class="flex min-w-0 flex-col items-start gap-2 sm:items-end">
					<a href={ templpkg.URL(data.DownloadHref) } class="inline-flex min-h-11 items-center rounded-radius border border-outline px-4 font-semibold hover:bg-surface-alt dark:border-outline-dark dark:hover:bg-surface-dark-alt">Download source</a>
					<p class="max-w-full break-all text-left font-mono text-sm text-on-surface-muted sm:text-right dark:text-on-surface-dark-muted">{ data.Document.SourcePath }</p>
				</div>
			}
		</div>
		if data.Selected == nil {
			<div class="grid gap-4 sm:grid-cols-2">
				@catalogMetric("Operations", fmt.Sprintf("%d", len(data.Document.Operations)))
				@catalogMetric("Schemas", fmt.Sprintf("%d", len(data.Document.Schemas)))
			</div>
		} else if data.Selected.Operation != nil {
			@catalogOperationDetail(data)
		} else if data.Selected.Schema != nil {
			@catalogSchemaDetail(data)
		}
	</main>
}

templ catalogOperationDetail(data CatalogPageData) {
	if data.OperationView != nil {
		{{ operation := *data.OperationView }}
		<article data-catalog-detail="operation">
			@pageheader.PageHeader(pageheader.Config{
				Title: operationTitle(operation),
				RootClass: "mb-8 min-w-0",
				RootAttrs: templpkg.Attributes{
					"data-public-page-header": "true",
				},
				TitleClass: "manja-doc-title",
				TitleAttrs: templpkg.Attributes{
					"id": operation.Anchor + "-heading",
					"tabindex": "-1",
					"data-public-doc-identity": operation.Anchor,
					"data-manja-settled-focus": "true",
				},
			})
			@endpointSection(operation, data.OperationServers, "", PublicDocsOptions{
				SchemaLinks:      data.SchemaLinks,
				SchemaLinkTarget: "#main-content",
				SchemaLinkSelect: "#main-content",
				SchemaLinkSwap:   "outerHTML show:#main-content:top",
			})
		</article>
	} else {
		{{ operation := *data.Selected.Operation }}
	<article id={ operation.Anchor } data-catalog-detail="operation" class="space-y-6">
		<div class="flex flex-wrap items-center gap-3">
			@badge.Badge(badge.Config{Label: operation.Method, Tone: catalogMethodTone(operation.Method), Appearance: badge.AppearanceSoft, Size: badge.SizeMD})
			<code class="break-all text-base text-on-surface-strong dark:text-on-surface-dark-strong">{ operation.Path }</code>
		</div>
		<h2 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ operation.Heading }</h2>
		if operation.Description != "" {
			<p class="max-w-4xl whitespace-pre-wrap text-on-surface-muted dark:text-on-surface-dark-muted">{ operation.Description }</p>
		}
		if len(operation.Parameters) > 0 {
			<section class="rounded-radius border border-outline p-5 dark:border-outline-dark">
				<h3 class="font-title text-xl font-bold">Parameters</h3>
				<div class="mt-4 divide-y divide-outline dark:divide-outline-dark">
					for _, parameter := range operation.Parameters {
						<div class="grid gap-2 py-3 sm:grid-cols-[14rem_1fr]">
							<div><code class="font-semibold">{ parameter.Name }</code> <span class="text-xs uppercase text-on-surface-muted dark:text-on-surface-dark-muted">{ parameter.In }</span></div>
							<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ parameter.Description }</p>
						</div>
					}
				</div>
			</section>
		}
		if len(operation.Responses) > 0 {
			<section class="rounded-radius border border-outline p-5 dark:border-outline-dark">
				<h3 class="font-title text-xl font-bold">Responses</h3>
				<div class="mt-4 space-y-3">
					for _, item := range operation.Responses {
						<div class="rounded-radius bg-surface-alt p-4 dark:bg-surface-dark-alt"><code class="font-semibold">{ item.Status }</code><p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ item.Description }</p></div>
					}
				</div>
			</section>
		}
	</article>
	}
}

templ catalogOrganizationAvatar(item CatalogOrganizationItem) {
	if item.AvatarSrc != "" {
		<span x-data="{ imageError: false }" class="relative inline-flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-full bg-surface-alt text-xs font-bold tracking-wider text-on-surface-strong dark:bg-surface-dark-alt dark:text-on-surface-dark-strong">
			<span x-show="imageError" aria-hidden="true" class="absolute inset-0 flex items-center justify-center">
				if item.AvatarSymbol != "" {
					@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: icon.Symbol(item.AvatarSymbol), Size: icon.SizeSM, Decorative: true})
				} else {
					{ item.Initials }
				}
			</span>
			<img
				src={ templpkg.URL(item.AvatarSrc) }
				alt={ item.AvatarAlt }
				loading="lazy"
				decoding="async"
				x-init="if ($el.complete && $el.naturalWidth === 0) imageError = true"
				x-show="!imageError"
				x-on:error="imageError = true"
				class="absolute inset-0 size-full object-cover"
			/>
		</span>
	} else if item.AvatarSymbol != "" {
		@avatar.Avatar(avatar.Config{Icon: icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: icon.Symbol(item.AvatarSymbol), Size: icon.SizeSM, Decorative: true}), Name: item.Label, Size: avatar.SizeXS, Shape: avatar.ShapeCircle, Tone: avatar.TonePrimary, RootClass: "shrink-0"})
	} else {
		@avatar.Avatar(avatar.Config{Name: item.Label, Initials: item.Initials, Size: avatar.SizeXS, Shape: avatar.ShapeCircle, Tone: avatar.TonePrimary, RootClass: "shrink-0"})
	}
}

templ catalogSchemaDetail(data CatalogPageData) {
	{{ schema := *data.Selected.Schema }}
	<article id={ schema.Anchor } data-catalog-detail="schema" class="space-y-6">
		@badge.Badge(badge.Config{Label: "Schema", Tone: badge.ToneSecondary, Appearance: badge.AppearanceSoft, Size: badge.SizeMD})
		<h2 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ schema.Heading }</h2>
		if schema.Description != "" {
			<p class="max-w-4xl whitespace-pre-wrap text-on-surface-muted dark:text-on-surface-dark-muted">{ schema.Description }</p>
		}
		if data.SchemaNode != nil {
			@catalogSchemaNode(*data.SchemaNode)
		}
		if schema.ExampleSchemaJSON != "" {
			<section class="rounded-radius border border-outline p-5 dark:border-outline-dark">
				<h3 class="font-title text-xl font-bold">Schema</h3>
				<pre class="mt-4 max-h-[32rem] overflow-auto rounded-radius bg-surface-alt p-4 text-sm dark:bg-surface-dark-alt"><code>{ schema.ExampleSchemaJSON }</code></pre>
			</section>
		}
	</article>
}

templ catalogSchemaNode(node CatalogSchemaNodeData) {
	<section id="schema-node-panel" aria-label={ node.Name + " schema node" } class="scroll-mt-24 rounded-radius border border-outline bg-surface p-5 dark:border-outline-dark dark:bg-surface-dark">
		<div class="flex flex-wrap items-start justify-between gap-3 border-b border-outline pb-4 dark:border-outline-dark">
			<div class="min-w-0">
				<p class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">Schema node { fmt.Sprintf("#%d", node.Ordinal) }</p>
				<h3 class="mt-1 break-words font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ node.Name }</h3>
			</div>
			if node.Type != "" || node.Format != "" {
				<code class="rounded-radius bg-surface-alt px-3 py-1.5 text-sm text-on-surface-strong dark:bg-surface-dark-alt dark:text-on-surface-dark-strong">{ strings.TrimSpace(node.Type + " " + node.Format) }</code>
			}
		</div>
		if node.Description != "" {
			<p class="mt-4 whitespace-pre-wrap text-on-surface-muted dark:text-on-surface-dark-muted">{ node.Description }</p>
		}
		if node.DefaultValue != "" || node.ExampleText != "" {
			<div class="mt-4 grid gap-3 sm:grid-cols-2">
				if node.DefaultValue != "" {
					<div class="rounded-radius bg-surface-alt p-3 dark:bg-surface-dark-alt"><span class="text-xs font-semibold uppercase text-on-surface-muted dark:text-on-surface-dark-muted">Default</span><code class="mt-1 block break-all text-sm">{ node.DefaultValue }</code></div>
				}
				if node.ExampleText != "" {
					<div class="rounded-radius bg-surface-alt p-3 dark:bg-surface-dark-alt"><span class="text-xs font-semibold uppercase text-on-surface-muted dark:text-on-surface-dark-muted">Example</span><code class="mt-1 block break-all text-sm">{ node.ExampleText }</code></div>
				}
			</div>
		}
		if len(node.Edges) > 0 {
			<div class="mt-5 divide-y divide-outline border-l border-outline dark:divide-outline-dark dark:border-outline-dark">
				for _, edge := range node.Edges {
					<a
						href={ templpkg.URL(edge.Href) }
						hx-get={ edge.Href }
						hx-target="#schema-node-panel"
						hx-select="#schema-node-panel"
						hx-swap="outerHTML show:#schema-node-panel:top"
						hx-push-url="true"
						class="block border-l-2 border-transparent px-4 py-4 transition hover:border-primary hover:bg-surface-alt dark:hover:border-primary-dark dark:hover:bg-surface-dark-alt"
					>
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div class="min-w-0"><span class="break-words font-mono font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ edge.Name }</span><span class="ml-3 break-all font-mono text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ edge.Type }</span></div>
							if edge.Required {
								<span class="shrink-0 text-xs font-semibold text-danger dark:text-danger-dark">required</span>
							}
						</div>
						if edge.Description != "" {
							<p class="mt-2 whitespace-pre-wrap text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ edge.Description }</p>
						}
					</a>
				}
			</div>
		}
		if node.Truncated {
			<p class="mt-4 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Showing first 100 links from this node.</p>
		}
	</section>
}

func catalogBranding(branding catalog.BrandingV1) core.DocsBranding {
	return core.DocsBranding{DisplayName: branding.DisplayName, Logo: core.DocsBrandingLogo{Src: branding.LogoSrc, Alt: branding.LogoAlt, HomeURL: branding.LogoHomeHref}, Favicon: branding.FaviconHref}
}

func catalogBrandName(data CatalogPageData) string {
	if strings.TrimSpace(data.Directory.Branding.DisplayName) != "" { return data.Directory.Branding.DisplayName }
	return data.Directory.Title
}

func catalogPageTitle(data CatalogPageData) string {
	if data.Selected != nil && data.Selected.Operation != nil { return data.Selected.Operation.Heading + " · " + data.Directory.Title }
	if data.Selected != nil && data.Selected.Schema != nil { return data.Selected.Schema.Heading + " · " + data.Directory.Title }
	if data.Search != nil { return "Search · " + data.Directory.Title }
	if data.Document != nil { return data.Document.Title + " · " + data.Directory.Title }
	return data.Directory.Title
}

func shortSnapshotID(id catalog.SnapshotID) string {
	value := strings.TrimPrefix(string(id), "snapshot-sha256-")
	if len(value) > 12 { value = value[:12] }
	return value
}

func catalogOperationCount(directory catalog.CatalogArtifactV1) int {
	total := 0
	for _, document := range directory.Documents { total += len(document.Operations) }
	return total
}

func catalogSchemaCount(directory catalog.CatalogArtifactV1) int {
	total := 0
	for _, document := range directory.Documents { total += len(document.Schemas) }
	return total
}

func catalogSidebarConfig(data CatalogPageData) sidebar.Config {
	config := sidebar.Config{
		DisableSkipLink: true,
		SearchSlot: catalogSidebarSearch(),
	}
	if data.Document == nil {
		config.Items = []sidebar.Item{{ID: "catalog-overview", Label: "Catalog overview", Href: data.Mount, Active: true}}
	} else {
		config.Items = []sidebar.Item{
			{ID: "back-to-catalog", Label: "Back to catalog", Href: data.Mount},
			{ID: "spec-overview", Label: "Spec overview", Href: data.DocumentHref, Active: data.Selected == nil},
		}
	}
	if data.Document == nil { return config }
	items := make([]sidebar.Item, 0, len(data.Groups))
	for _, group := range data.Groups {
		children := make([]sidebar.Item, 0, len(group.Items))
		for _, item := range group.Items {
			children = append(children, sidebar.Item{
				ID:         item.ID,
				Label:      item.Label,
				Href:       item.Href,
				Active:     item.Active,
				Badge:      item.Method,
				BadgeClass: catalogMethodBadgeClass(item.Method),
				LinkAttrs:  templpkg.Attributes{"data-catalog-sidebar-operation": "true"},
			})
		}
		linkAttrs := templpkg.Attributes{
			"id":                         "catalog-group-control-" + group.ID,
			"data-catalog-group-control": "true",
			"hx-get":                     group.Href,
			"hx-target":                  "#catalog-sidebar-groups",
			"hx-select":                  "#catalog-sidebar-groups",
			"hx-swap":                    "outerHTML",
			"hx-push-url":                "true",
		}
		if !group.Open {
			linkAttrs["aria-expanded"] = "false"
			linkAttrs["aria-controls"] = "catalog-sidebar-groups"
		}
		items = append(items, sidebar.Item{
			ID: group.ID, Label: group.Label, Href: group.Href, Badge: fmt.Sprintf("%d", group.Count),
			Items: children, Collapsible: group.Open, Open: group.Open,
			LinkAttrs: linkAttrs,
		})
	}
	config.Sections = []sidebar.Section{{Title: data.Document.Title, Items: items, Collapsible: true}}
	return config
}

templ catalogSidebarFocusRestoration() {
	<script data-catalog-sidebar-focus-restoration="true">
		(function () {
			if (window.__manjaCatalogSidebarFocusBound) return;
			window.__manjaCatalogSidebarFocusBound = true;
			var pendingControlID = "";
			document.body.addEventListener("htmx:beforeRequest", function (event) {
				var trigger = event.detail && event.detail.elt;
				var control = trigger && trigger.closest && trigger.closest("[data-catalog-group-control]");
				pendingControlID = control && document.activeElement === control ? control.id : "";
			});
			document.body.addEventListener("htmx:afterSettle", function () {
				if (!pendingControlID) return;
				var control = document.getElementById(pendingControlID);
				pendingControlID = "";
				if (!control) return;
				try { control.focus({ preventScroll: true }); } catch (error) { control.focus(); }
			});
			["htmx:responseError", "htmx:sendError", "htmx:timeout"].forEach(function (name) {
				document.body.addEventListener(name, function () { pendingControlID = ""; });
			});
		})();
	</script>
}

func catalogMethodTone(method string) badge.Tone {
	switch strings.ToUpper(method) {
	case "GET": return badge.ToneSuccess
	case "POST": return badge.TonePrimary
	case "DELETE": return badge.ToneDanger
	case "PUT", "PATCH": return badge.ToneWarning
	default: return badge.ToneDefault
	}
}

func catalogMethodBadgeClass(method string) string {
	switch strings.ToUpper(strings.TrimSpace(method)) {
	case "GET":
		return "catalog-method-get"
	case "POST":
		return "catalog-method-post"
	case "DELETE":
		return "catalog-method-delete"
	case "PUT", "PATCH":
		return "catalog-method-warning"
	default:
		return "catalog-method-neutral"
	}
}

templ catalogSidebarOverflowTooltip() {
	<script data-catalog-sidebar-overflow-tooltip="true">
		(function () {
			if (window.__manjaCatalogSidebarOverflowTooltipBound) return;
			window.__manjaCatalogSidebarOverflowTooltipBound = true;
			var tooltip;
			var activeLink;

			function labelFor(link) {
				return link && link.querySelector && link.querySelector(".truncate");
			}

			function hide() {
				if (activeLink && activeLink.getAttribute("aria-describedby") === "catalog-sidebar-overflow-tooltip") {
					activeLink.removeAttribute("aria-describedby");
				}
				activeLink = null;
				if (tooltip) tooltip.hidden = true;
			}

			function show(link) {
				var label = labelFor(link);
				if (!label || label.scrollWidth <= label.clientWidth + 1 || !label.textContent.trim()) {
					hide();
					return;
				}
				if (!tooltip) {
					tooltip = document.createElement("div");
					tooltip.id = "catalog-sidebar-overflow-tooltip";
					tooltip.setAttribute("role", "tooltip");
					tooltip.hidden = true;
					document.body.appendChild(tooltip);
				}
				tooltip.textContent = label.textContent.trim();
				tooltip.hidden = false;
				activeLink = link;
				link.setAttribute("aria-describedby", tooltip.id);
				var rect = link.getBoundingClientRect();
				var left = rect.right + 8;
				var top = rect.top + (rect.height - tooltip.offsetHeight) / 2;
				if (left + tooltip.offsetWidth > window.innerWidth - 8) left = rect.left - tooltip.offsetWidth - 8;
				tooltip.style.left = Math.max(8, left) + "px";
				tooltip.style.top = Math.min(Math.max(8, top), Math.max(8, window.innerHeight - tooltip.offsetHeight - 8)) + "px";
			}

			document.addEventListener("pointerover", function (event) {
				var link = event.target && event.target.closest && event.target.closest("[data-catalog-sidebar-operation]");
				if (link) show(link);
			});
			document.addEventListener("pointerout", function (event) {
				var link = event.target && event.target.closest && event.target.closest("[data-catalog-sidebar-operation]");
				if (link && (!event.relatedTarget || !link.contains(event.relatedTarget))) hide();
			});
			document.addEventListener("focusin", function (event) {
				var link = event.target && event.target.closest && event.target.closest("[data-catalog-sidebar-operation]");
				if (link) show(link);
			});
			document.addEventListener("focusout", function (event) {
				var link = event.target && event.target.closest && event.target.closest("[data-catalog-sidebar-operation]");
				if (link && (!event.relatedTarget || !link.contains(event.relatedTarget))) hide();
			});
			window.addEventListener("resize", hide);
			window.addEventListener("scroll", hide, true);
			document.body.addEventListener("htmx:beforeSwap", hide);
		})();
	</script>
}

templ catalogDocumentSelection() {
	<script data-catalog-document-selection="true">
		(function () {
			if (window.__manjaCatalogDocumentSelectionBound) return;
			window.__manjaCatalogDocumentSelectionBound = true;
			document.addEventListener("combobox:change", function (event) {
				var detail = event && event.detail;
				if (!detail || detail.id !== "catalog-document" || !Array.isArray(detail.values) || detail.values.length !== 1) return;
				var value = detail.values[0];
				if (typeof value !== "string" || value.charAt(0) !== "/" || value.indexOf("//") === 0) return;
				window.location.assign(value);
			});
		})();
	</script>
}
