package templates

import (
	"fmt"
	"strings"
	"time"

	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/radio"
	"github.com/araihu/goshtoso/components/textinput"
	"github.com/araihu/manja/internal/core"
)

type ManagementOverviewModel struct {
	Specs       []ManagedSpecModel
	Project     core.Project
	Source      core.Source
	Revision    core.Revision
	Publication core.Publication
	SyncRecord  core.SyncRecord
}

type ManagedSpecModel struct {
	ID          string
	Title       string
	Version     string
	Project     core.Project
	Source      core.Source
	Revision    core.Revision
	Candidates  []core.RevisionCandidate
	Publication core.Publication
	SyncRecord  core.SyncRecord
}

templ ManagementOverview(model ManagementOverviewModel) {
	@LayoutWithBranding("Management", core.DocsBranding{}) {
		<div class="min-h-screen bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			<header class="border-b border-outline bg-surface dark:border-outline-dark dark:bg-surface-dark">
				<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4">
					<div class="min-w-0">
						<p class="text-xs font-semibold uppercase tracking-normal text-on-surface-muted dark:text-on-surface-dark-muted">Management</p>
						<h1 class="truncate text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Specs and sources</h1>
					</div>
					<a href="/" class="inline-flex h-10 shrink-0 items-center justify-center rounded-radius border border-outline bg-surface-alt px-3 text-sm font-semibold text-on-surface-strong transition hover:bg-surface dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark-strong dark:hover:bg-surface-dark">View docs</a>
				</div>
			</header>
			<main class="mx-auto grid max-w-7xl gap-6 px-6 py-6">
				<section class="grid gap-4" aria-labelledby="management-home-heading">
					<div class="flex flex-wrap items-end justify-between gap-3">
						<div>
							<h2 id="management-home-heading" class="text-lg font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Managed specs</h2>
							<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ managementSpecCount(len(model.Specs)) } across repositories and spec files.</p>
						</div>
					</div>
					<div class="overflow-hidden rounded-radius border border-outline bg-surface-alt dark:border-outline-dark dark:bg-surface-dark-alt">
						<div class="hidden grid-cols-[minmax(14rem,1.2fr)_minmax(12rem,1fr)_minmax(10rem,0.8fr)_minmax(15rem,1.1fr)] gap-4 border-b border-outline px-4 py-2 text-xs font-semibold uppercase tracking-normal text-on-surface-muted dark:border-outline-dark dark:text-on-surface-dark-muted lg:grid">
							<div>Spec</div>
							<div>Source</div>
							<div>Sync</div>
							<div>Publication</div>
						</div>
						<div class="divide-y divide-outline dark:divide-outline-dark">
							for _, spec := range model.Specs {
								@managementSpecRow(spec)
							}
						</div>
					</div>
				</section>
				<section class="grid gap-3" aria-labelledby="management-docs-heading">
					<div class="flex flex-wrap items-end justify-between gap-3">
						<div>
							<h2 id="management-docs-heading" class="text-lg font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ managementSpecTitle(model) }</h2>
							<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Version { managementSpecVersion(model) }</p>
						</div>
						@badge.Badge(badge.Config{
							Label:   managementPublicationLabel(model.Publication),
							Variant: managementPublicationBadgeVariant(model.Publication),
							Style:   badge.StyleSoft,
						})
					</div>
					<div class="grid gap-3 md:grid-cols-3">
						@managementFact("Project ID", model.Project.ID)
						@managementFact("Source", managementSourceLabel(model.Source))
						@managementFact("Revision", managementRevisionLabel(model.Revision))
					</div>
				</section>
				<section class="grid gap-4 md:grid-cols-2" aria-label="Project configuration">
					<div class="rounded-radius border border-outline bg-surface-alt p-4 dark:border-outline-dark dark:bg-surface-dark-alt">
						<h2 class="text-base font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Source</h2>
						<dl class="mt-4 grid gap-3">
							@managementTerm("Source ID", model.Source.ID)
							@managementTerm("Kind", model.Source.Kind)
							@managementTerm("Spec path", model.Source.SpecPath)
							@managementTerm("Credential", managementCredentialLabel(model.Source))
						</dl>
					</div>
					<div class="rounded-radius border border-outline bg-surface-alt p-4 dark:border-outline-dark dark:bg-surface-dark-alt">
						<h2 class="text-base font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Publication</h2>
						<dl class="mt-4 grid gap-3">
							@managementTerm("Visibility", managementPublicationLabel(model.Publication))
							@managementTerm("Public path", model.Publication.Path)
							@managementTerm("Hostname", model.Publication.Hostname)
							@managementTerm("Revision ID", model.Publication.RevisionID)
						</dl>
						<form method="post" action="/manage/publication" class="mt-5 grid gap-4 border-t border-outline pt-4 dark:border-outline-dark">
							<input type="hidden" name="spec_id" value={ managementSelectedSpecID(model) }/>
							<fieldset class="grid gap-2">
								<legend class="text-xs font-semibold uppercase tracking-normal text-on-surface-muted dark:text-on-surface-dark-muted">Visibility</legend>
								@radio.RadioBar() {
									@radio.Radio(radio.Config{ID: "management-visibility-public", Name: "visibility", Value: "public", Label: "Public", Checked: model.Publication.Public, Variant: radio.Primary, Segmented: true})
									@radio.Radio(radio.Config{ID: "management-visibility-private", Name: "visibility", Value: "private", Label: "Private", Checked: !model.Publication.Public, Variant: radio.Primary, Segmented: true})
								}
							</fieldset>
							@textinput.TextInput(textinput.Config{
								ID:          "management-public-path",
								Name:        "path",
								Label:       "Public path",
								Placeholder: "/docs/v1",
								Value:       managementPublicationPathValue(model.Publication, model.Project),
								RootClass:   "font-mono",
							})
							@button.Button(button.Config{Variant: button.Primary, Type: "submit", RootClass: "w-fit"}) {
								Save publication
							}
						</form>
					</div>
					<div class="rounded-radius border border-outline bg-surface-alt p-4 dark:border-outline-dark dark:bg-surface-dark-alt">
						<h2 class="text-base font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Revision</h2>
						<dl class="mt-4 grid gap-3">
							@managementTerm("Revision ID", model.Revision.ID)
							@managementTerm("Ref", model.Revision.Ref)
							@managementTerm("Commit", model.Revision.CommitSHA)
							@managementTerm("Version", model.Revision.Version)
						</dl>
					</div>
					<div class="rounded-radius border border-outline bg-surface-alt p-4 dark:border-outline-dark dark:bg-surface-dark-alt">
						<h2 class="text-base font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">SEO and theme</h2>
						<dl class="mt-4 grid gap-3">
							@managementTerm("Canonical base", model.Project.SEO.CanonicalBase)
							@managementTerm("Robots", model.Project.SEO.Robots)
							@managementTerm("Theme", model.Project.Theme.Theme)
							@managementTerm("Dark mode", model.Project.Theme.DarkMode)
						</dl>
					</div>
					<div class="rounded-radius border border-outline bg-surface-alt p-4 dark:border-outline-dark dark:bg-surface-dark-alt">
						<h2 class="text-base font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Last sync</h2>
						<dl class="mt-4 grid gap-3">
							@managementTerm("Result", model.SyncRecord.Result)
							@managementTerm("Trigger", model.SyncRecord.Trigger)
							@managementTerm("Finished", managementTime(model.SyncRecord.FinishedAt))
							@managementTerm("Error", model.SyncRecord.ErrorSummary)
						</dl>
					</div>
				</section>
			</main>
		</div>
	}
}

templ managementSyncForm(spec ManagedSpecModel, idPrefix string) {
	<form method="post" action="/manage/sync" class="mt-5 grid gap-4 border-t border-outline pt-4 dark:border-outline-dark">
		<input type="hidden" name="spec_id" value={ spec.ID }/>
		<div class="grid gap-2">
			<label for={ idPrefix + "-sync-ref" } class="text-xs font-semibold uppercase tracking-normal text-on-surface-muted dark:text-on-surface-dark-muted">Available refs</label>
			<select id={ idPrefix + "-sync-ref" } name="ref" class="min-h-10 rounded-radius border border-outline bg-surface px-3 py-2 font-mono text-sm text-on-surface-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-strong">
				for _, candidate := range spec.Candidates {
					<option value={ candidate.Ref } selected?={ candidate.Ref == spec.Revision.Ref }>{ managementCandidateLabel(candidate) }</option>
				}
			</select>
		</div>
		<label class="flex items-center gap-2 text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">
			<input type="checkbox" name="publish" value="public" class="size-4 rounded border-outline text-primary focus-visible:outline-primary dark:border-outline-dark"/>
			<span>Publish synced revision</span>
		</label>
		@textinput.TextInput(textinput.Config{
			ID:          idPrefix + "-sync-public-path",
			Name:        "path",
			Label:       "Public path",
			Placeholder: "/docs/v1",
			Value:       managementPublicationPathValue(spec.Publication, spec.Project),
			RootClass:   "font-mono",
		})
		@button.Button(button.Config{Variant: button.Primary, Type: "submit", RootClass: "w-fit"}) {
			Sync selected ref
		}
	</form>
}

templ managementSpecRow(spec ManagedSpecModel) {
	<div class="grid gap-4 px-4 py-4 lg:grid-cols-[minmax(14rem,1.2fr)_minmax(12rem,1fr)_minmax(10rem,0.8fr)_minmax(15rem,1.1fr)] lg:items-start">
		<div class="min-w-0">
			<div class="flex flex-wrap items-center gap-2">
				<h3 class="min-w-0 break-words text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ spec.Title }</h3>
				@badge.Badge(badge.Config{
					Label:   managementPublicationLabel(spec.Publication),
					Variant: managementPublicationBadgeVariant(spec.Publication),
					Style:   badge.StyleSoft,
				})
			</div>
			<p class="mt-1 font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Version { spec.Version }</p>
			<p class="mt-2 font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ managementValue(spec.Project.ID) }</p>
		</div>
		<dl class="grid gap-2">
			@managementTerm("Source ID", spec.Source.ID)
			@managementTerm("Kind", spec.Source.Kind)
			@managementTerm("Spec path", spec.Source.SpecPath)
		</dl>
		<dl class="grid gap-2">
			@managementTerm("Revision", managementRevisionLabel(spec.Revision))
			@managementTerm("Commit", spec.Revision.CommitSHA)
			@managementTerm("Result", spec.SyncRecord.Result)
			@managementTerm("Error", spec.SyncRecord.ErrorSummary)
		</dl>
		<div class="grid gap-4">
			if len(spec.Candidates) > 0 {
				@managementSyncForm(spec, "management-" + spec.ID)
			}
			<form method="post" action="/manage/publication" class="grid gap-3">
				<input type="hidden" name="spec_id" value={ spec.ID }/>
				<fieldset class="grid gap-2">
					<legend class="text-xs font-semibold uppercase tracking-normal text-on-surface-muted dark:text-on-surface-dark-muted">Visibility</legend>
					@radio.RadioBar() {
						@radio.Radio(radio.Config{ID: "management-visibility-public-" + spec.ID, Name: "visibility", Value: "public", Label: "Public", Checked: spec.Publication.Public, Variant: radio.Primary, Segmented: true})
						@radio.Radio(radio.Config{ID: "management-visibility-private-" + spec.ID, Name: "visibility", Value: "private", Label: "Private", Checked: !spec.Publication.Public, Variant: radio.Primary, Segmented: true})
					}
				</fieldset>
				@textinput.TextInput(textinput.Config{
					ID:          "management-public-path-" + spec.ID,
					Name:        "path",
					Label:       "Public path",
					Placeholder: "/docs/v1",
					Value:       managementPublicationPathValue(spec.Publication, spec.Project),
					RootClass:   "font-mono",
				})
				@button.Button(button.Config{Variant: button.Primary, Type: "submit", RootClass: "w-fit"}) {
					Save publication
				}
			</form>
		</div>
	</div>
}

templ managementFact(label string, value string) {
	<div class="rounded-radius border border-outline bg-surface-alt px-4 py-3 dark:border-outline-dark dark:bg-surface-dark-alt">
		<p class="text-xs font-semibold uppercase tracking-normal text-on-surface-muted dark:text-on-surface-dark-muted">{ label }</p>
		<p class="mt-1 min-w-0 break-words font-mono text-sm text-on-surface-strong dark:text-on-surface-dark-strong">{ managementValue(value) }</p>
	</div>
}

templ managementTerm(label string, value string) {
	<div class="grid gap-1 sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-baseline">
		<dt class="text-xs font-semibold uppercase tracking-normal text-on-surface-muted dark:text-on-surface-dark-muted">{ label }</dt>
		<dd class="min-w-0 break-words font-mono text-sm text-on-surface-strong dark:text-on-surface-dark-strong">{ managementValue(value) }</dd>
	</div>
}

func managementSpecTitle(model ManagementOverviewModel) string {
	if len(model.Specs) > 0 && strings.TrimSpace(model.Specs[0].Title) != "" {
		return model.Specs[0].Title
	}
	if strings.TrimSpace(model.Project.Name) != "" {
		return model.Project.Name
	}
	return "Untitled API"
}

func managementSpecVersion(model ManagementOverviewModel) string {
	if len(model.Specs) > 0 && strings.TrimSpace(model.Specs[0].Version) != "" {
		return model.Specs[0].Version
	}
	if strings.TrimSpace(model.Revision.Version) != "" {
		return model.Revision.Version
	}
	return "unversioned"
}

func managementSelectedSpecID(model ManagementOverviewModel) string {
	if len(model.Specs) > 0 {
		return model.Specs[0].ID
	}
	return "current"
}

func managementSpecCount(count int) string {
	if count == 1 {
		return "1 spec"
	}
	return fmt.Sprintf("%d specs", count)
}

func managementSourceLabel(source core.Source) string {
	parts := []string{source.ID, source.Kind}
	return strings.Trim(strings.Join(compactStrings(parts), " "), " ")
}

func managementRevisionLabel(rev core.Revision) string {
	for _, value := range []string{rev.Ref, rev.Version, rev.ID} {
		if strings.TrimSpace(value) != "" {
			return value
		}
	}
	return ""
}

func managementCredentialLabel(source core.Source) string {
	if strings.TrimSpace(source.CredentialID) == "" {
		return "not configured"
	}
	return "configured"
}

func managementCandidateLabel(candidate core.RevisionCandidate) string {
	parts := []string{candidate.Ref, candidate.Kind, candidate.CommitSHA}
	return strings.Join(compactStrings(parts), " ")
}

func managementPublicationLabel(pub core.Publication) string {
	if pub.Public {
		return "Public"
	}
	return "Private"
}

func managementPublicationBadgeVariant(pub core.Publication) badge.Variant {
	if pub.Public {
		return badge.Success
	}
	return badge.Warning
}

func managementPublicationPathValue(pub core.Publication, project core.Project) string {
	if strings.TrimSpace(pub.Path) != "" {
		return pub.Path
	}
	if strings.TrimSpace(project.Slug) != "" {
		return "/" + strings.Trim(strings.TrimSpace(project.Slug), "/")
	}
	return ""
}

func managementTime(t time.Time) string {
	if t.IsZero() {
		return "not synced"
	}
	return t.UTC().Format("2006-01-02 15:04 UTC")
}

func managementValue(value string) string {
	if strings.TrimSpace(value) == "" {
		return "not configured"
	}
	return value
}

func compactStrings(values []string) []string {
	compact := make([]string, 0, len(values))
	for _, value := range values {
		value = strings.TrimSpace(value)
		if value != "" {
			compact = append(compact, value)
		}
	}
	return compact
}
