package templates

import "github.com/araihu/goshtoso/components/head"

templ Layout(title string) {
	<!DOCTYPE html>
	<html
		lang="en"
		data-theme="goshtoso"
		x-data="{
			theme: localStorage.getItem('theme') || 'goshtoso',
			darkMode: (function() {
				const stored = localStorage.getItem('darkMode');
				if (stored !== null) return stored === 'true';
				return window.matchMedia('(prefers-color-scheme: dark)').matches;
			})(),
			setTheme(name) { this.theme = name; document.documentElement.setAttribute('data-theme', name); },
			applyDarkMode(on) { document.documentElement.classList.toggle('dark', on); },
			toggleDarkMode() { this.darkMode = !this.darkMode; }
		}"
		x-init="
			document.documentElement.setAttribute('data-theme', theme);
			applyDarkMode(darkMode);
			$watch('theme', value => {
				localStorage.setItem('theme', value);
				document.documentElement.setAttribute('data-theme', value);
			});
			$watch('darkMode', value => {
				localStorage.setItem('darkMode', value ? 'true' : 'false');
				applyDarkMode(value);
			});
		"
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<script>
				(function() {
					try {
						document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'goshtoso');
						var d = localStorage.getItem('darkMode');
						var on = d !== null ? d === 'true' : window.matchMedia('(prefers-color-scheme: dark)').matches;
						document.documentElement.classList.toggle('dark', on);
					} catch (e) {}
				})();
			</script>
			@head.Dependencies()
			<script>
				(function () {
					var pendingSidebarHref = "";
					var sidebarLinkClasses = {
						item: {
							active: "flex items-center gap-2 py-2 text-base font-medium text-primary dark:text-primary-dark".split(" "),
							inactive: "flex items-center gap-2 py-2 text-base text-on-surface transition-colors hover:text-on-surface-strong dark:text-on-surface-dark dark:hover:text-on-surface-dark-strong".split(" "),
							iconActive: "shrink-0 size-8 rounded-sm p-1.5 bg-primary/10 text-primary dark:bg-primary-dark/10 dark:text-primary-dark".split(" "),
							iconInactive: "shrink-0 size-8 rounded-sm p-1.5 bg-surface-alt text-on-surface dark:bg-surface-dark-alt dark:text-on-surface-dark".split(" ")
						},
						section: {
							active: "pointer-events-none flex items-center gap-2 border-l-2 border-primary py-2.5 pl-4 text-sm font-bold text-primary dark:border-primary-dark dark:text-primary-dark".split(" "),
							inactive: "flex items-center gap-2 border-l border-outline py-2.5 pl-4 text-sm font-medium text-on-surface transition duration-200 hover:border-l-2 hover:border-outline-strong hover:text-on-surface-strong dark:border-outline-dark dark:text-on-surface-dark dark:hover:border-outline-dark-strong dark:hover:text-on-surface-dark-strong".split(" ")
						}
					};

					function sidebarLinkFromEvent(event) {
						var detail = event && event.detail;
						var element = detail && (detail.elt || (detail.requestConfig && detail.requestConfig.elt));
						if (!element || !element.closest) return null;
						return element.closest('[data-manja-sidebar-nav="true"]');
					}

					function normalizeHref(href) {
						try {
							var url = new URL(href, window.location.origin);
							return url.pathname + url.search + url.hash;
						} catch (e) {
							return href || "";
						}
					}

					function activeMarker(link) {
						for (var i = 0; i < link.children.length; i++) {
							var child = link.children[i];
							if (child.classList && child.classList.contains('sr-only') && child.textContent.trim() === 'active') {
								return child;
							}
						}
						return null;
					}

					function directIcon(link) {
						for (var i = 0; i < link.children.length; i++) {
							var child = link.children[i];
							if (child.classList && child.classList.contains('size-8')) {
								return child;
							}
						}
						return null;
					}

					function classProfile(link) {
						if (link.closest('[data-sidebar-section]')) return sidebarLinkClasses.section;
						return sidebarLinkClasses.item;
					}

					function setSidebarLinkActive(link, active) {
						var profile = classProfile(link);
						link.classList.remove.apply(link.classList, profile.active.concat(profile.inactive));
						link.classList.add.apply(link.classList, active ? profile.active : profile.inactive);
						if (active) {
							link.setAttribute('aria-current', 'page');
							if (!activeMarker(link)) {
								var marker = document.createElement('span');
								marker.className = 'sr-only';
								marker.textContent = 'active';
								link.appendChild(marker);
							}
						} else {
							link.removeAttribute('aria-current');
							var marker = activeMarker(link);
							if (marker) marker.remove();
						}

						var icon = directIcon(link);
						if (!icon || !profile.iconActive || !profile.iconInactive) return;
						icon.classList.remove.apply(icon.classList, profile.iconActive.concat(profile.iconInactive));
						icon.classList.add.apply(icon.classList, active ? profile.iconActive : profile.iconInactive);
					}

					function updateSidebarActiveLink(href) {
						href = normalizeHref(href);
						if (!href) return;
						var links = document.querySelectorAll('[data-manja-sidebar-nav="true"][href]');
						var matched = false;
						for (var i = 0; i < links.length; i++) {
							var link = links[i];
							var active = normalizeHref(link.getAttribute('href')) === href;
							setSidebarLinkActive(link, active);
							matched = matched || active;
						}
						if (!matched) {
							for (var j = 0; j < links.length; j++) setSidebarLinkActive(links[j], false);
						}
					}

					document.addEventListener('htmx:beforeRequest', function (e) {
						var link = sidebarLinkFromEvent(e);
						if (link) pendingSidebarHref = link.getAttribute('href') || "";
					});

					document.addEventListener('htmx:afterSwap', function (e) {
						var target = e && e.detail && e.detail.target;
						if (!target || target.id !== 'main-content') return;
						updateSidebarActiveLink(pendingSidebarHref || (window.location.pathname + window.location.search + window.location.hash));
						pendingSidebarHref = "";
						window.scrollTo({ top: 0 });
					});
				})();
			</script>
			<link rel="stylesheet" href="/manja-assets/manja.css"/>
			<script defer src="/manja-assets/schema-example.js"></script>
			<script defer src="/manja-assets/request-composer.js"></script>
			<style>[x-cloak] { display: none !important; }</style>
		</head>
		<body class="min-h-screen bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			{ children... }
		</body>
	</html>
}
