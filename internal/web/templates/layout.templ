package templates

import (
	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/head"
	core "github.com/araihu/manja/domain"
)

type PageMetadata struct {
	Title string
	Description string
	CanonicalURL string
	SocialImageURL string
	SocialImageAlt string
	Robots string
}

templ Layout(title string) {
	@LayoutWithBranding(title, core.DocsBranding{}, false, false)
}

templ LayoutWithBranding(title string, branding core.DocsBranding, seasonalCampaign bool, manageFavicon bool) {
	@LayoutWithBrandingMetadata(PageMetadata{Title: title}, branding, seasonalCampaign, manageFavicon) {
		{ children... }
	}
}

templ LayoutWithBrandingMetadata(metadata PageMetadata, branding core.DocsBranding, seasonalCampaign bool, manageFavicon bool) {
	<!DOCTYPE html>
	<html
		lang="en"
		data-theme="araihu"
		data-theme-source="default"
		x-data="{
			theme: localStorage.getItem('theme') || 'araihu',
			darkMode: (function() {
				const stored = localStorage.getItem('darkMode');
				if (stored !== null) return stored === 'true';
				return window.matchMedia('(prefers-color-scheme: dark)').matches;
			})(),
			setTheme(name) { this.theme = name; document.documentElement.setAttribute('data-theme', name); document.documentElement.dataset.themeSource = 'preference'; },
			applyDarkMode(on) { document.documentElement.classList.toggle('dark', on); },
			toggleDarkMode() { this.darkMode = !this.darkMode; }
		}"
		x-init="
			document.documentElement.setAttribute('data-theme', theme);
			applyDarkMode(darkMode);
			$watch('theme', value => {
				localStorage.setItem('theme', value);
				document.documentElement.setAttribute('data-theme', value);
				document.documentElement.dataset.themeSource = 'preference';
			});
			$watch('darkMode', value => {
				localStorage.setItem('darkMode', value ? 'true' : 'false');
				applyDarkMode(value);
			});
		"
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ metadata.Title }</title>
			if metadata.Description != "" {
				<meta name="description" content={ metadata.Description }/>
			}
			if metadata.CanonicalURL != "" {
				<link rel="canonical" href={ metadata.CanonicalURL }/>
				<meta property="og:url" content={ metadata.CanonicalURL }/>
			}
			if metadata.Description != "" || metadata.CanonicalURL != "" || metadata.SocialImageURL != "" {
				if metadata.Title != "" {
					<meta property="og:title" content={ metadata.Title }/>
					<meta name="twitter:title" content={ metadata.Title }/>
				}
				if metadata.Description != "" {
					<meta property="og:description" content={ metadata.Description }/>
					<meta name="twitter:description" content={ metadata.Description }/>
				}
			}
			if metadata.SocialImageURL != "" {
				<meta property="og:image" content={ metadata.SocialImageURL }/>
				<meta property="og:image:width" content="1280"/>
				<meta property="og:image:height" content="640"/>
				<meta property="og:image:alt" content={ metadata.SocialImageAlt }/>
				<meta name="twitter:card" content="summary_large_image"/>
				<meta name="twitter:image" content={ metadata.SocialImageURL }/>
				<meta name="twitter:image:alt" content={ metadata.SocialImageAlt }/>
			}
			if metadata.Robots != "" {
				<meta name="robots" content={ metadata.Robots }/>
			}
			if branding.Favicon != "" {
				if manageFavicon {
					<link rel="icon" href={ templpkg.URL(branding.Favicon) } crossorigin="anonymous" data-asset-brand="icon"/>
				} else {
					<link rel="icon" href={ templpkg.URL(branding.Favicon) }/>
				}
			}
			<script>
				(function() {
					try {
						var savedTheme = localStorage.getItem('theme');
						document.documentElement.setAttribute('data-theme', savedTheme || 'araihu');
						document.documentElement.dataset.themeSource = savedTheme ? 'preference' : 'default';
					var d = localStorage.getItem('darkMode');
					var on = d !== null ? d === 'true' : window.matchMedia('(prefers-color-scheme: dark)').matches;
					document.documentElement.classList.toggle('dark', on);
					document.documentElement.classList.add('boot');
					addEventListener('DOMContentLoaded', function () {
						setTimeout(function () {
							document.documentElement.classList.remove('boot');
						}, 600);
					});
				} catch (e) {}
				})();
			</script>
			@head.Dependencies()
			<link rel="stylesheet" href="/manja-assets/araihu.css"/>
			<script>
				(function () {
					var pendingSidebarHref = "";

					function sidebarLinkFromEvent(event) {
						var detail = event && event.detail;
						var element = detail && (detail.elt || (detail.requestConfig && detail.requestConfig.elt));
						if (!element || !element.closest) return null;
						return element.closest('[data-manja-sidebar-nav="true"]');
					}

					function normalizeHref(href) {
						try {
							var url = new URL(href, window.location.origin);
							return url.pathname + url.search + url.hash;
						} catch (e) {
							return href || "";
						}
					}

					function activeMarker(link) {
						for (var i = 0; i < link.children.length; i++) {
							var child = link.children[i];
							if (child.classList && child.classList.contains('sr-only') && child.textContent.trim() === 'active') {
								return child;
							}
						}
						return null;
					}

					function setSidebarLinkActive(link, active) {
						if (active) {
							link.setAttribute('aria-current', 'page');
							if (!activeMarker(link)) {
								var marker = document.createElement('span');
								marker.className = 'sr-only';
								marker.textContent = 'active';
								link.appendChild(marker);
							}
						} else {
							link.removeAttribute('aria-current');
							var marker = activeMarker(link);
							if (marker) marker.remove();
						}
					}

					function updateSidebarActiveLink(href) {
						href = normalizeHref(href);
						if (!href) return;
						var links = document.querySelectorAll('[data-manja-sidebar-nav="true"][href]');
						var matched = false;
						for (var i = 0; i < links.length; i++) {
							var link = links[i];
							var active = normalizeHref(link.getAttribute('href')) === href;
							setSidebarLinkActive(link, active);
							matched = matched || active;
						}
						if (!matched) {
							for (var j = 0; j < links.length; j++) setSidebarLinkActive(links[j], false);
						}
					}

					document.addEventListener('htmx:beforeRequest', function (e) {
						var link = sidebarLinkFromEvent(e);
						if (link) pendingSidebarHref = link.getAttribute('href') || "";
					});

					document.addEventListener('htmx:afterSwap', function (e) {
						var target = e && e.detail && e.detail.target;
						if (!target || target.id !== 'main-content') return;
						var content = target.querySelector('[data-public-docs-content="true"]');
						if (content && content.dataset.selectedDoc) {
							target.dataset.selectedDoc = content.dataset.selectedDoc;
						}
						if (content && content.dataset.documentTitle) {
							document.title = content.dataset.documentTitle;
						}
						var shouldFocus = pendingSidebarHref !== "";
						updateSidebarActiveLink(pendingSidebarHref || (window.location.pathname + window.location.search + window.location.hash));
						pendingSidebarHref = "";
						target.scrollTo({ top: 0 });
						if (shouldFocus) {
							var focusTarget = target.querySelector('[data-manja-settled-focus="true"]');
							if (focusTarget) focusTarget.focus({ preventScroll: true });
						}
					});
				})();
			</script>
			<link rel="stylesheet" href="/manja-assets/manja.css"/>
			if seasonalCampaign {
				<script
					defer
					src="https://araihu.com/assets/campaign/v1.js"
					data-channel="https://araihu.com/assets/releases/current"
					integrity="sha384-oPH7l1vK9vKP1Dn+18sO3yEXlz4ts6KzPEQl0SW4Y/+im05gOaamNNaQAf6bGH/n"
					crossorigin="anonymous"
				></script>
				<script>
					(function () {
						function syncCampaignToggleLabels() {
							document.querySelectorAll('[data-campaign-toggle]').forEach(function (button) {
								var label = button.getAttribute('aria-pressed') === 'true'
									? button.dataset.useBaselineLabel
									: button.dataset.useCampaignLabel;
								if (!label) return;
								button.setAttribute('aria-label', label);
								var text = button.querySelector('[data-campaign-toggle-label]');
								if (text) text.textContent = label;
							});
						}
						document.addEventListener('DOMContentLoaded', syncCampaignToggleLabels);
						document.addEventListener('araihu:campaign:applied', syncCampaignToggleLabels);
						document.addEventListener('araihu:campaign:restored', syncCampaignToggleLabels);
					})();
				</script>
			}
			<script defer src="/manja-assets/schema-example.js"></script>
			<script defer src="/manja-assets/request-composer.js"></script>
			<style>[x-cloak] { display: none !important; }</style>
		</head>
		<body class="min-h-screen bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			{ children... }
		</body>
	</html>
}
