package render

import (
	"github.com/araihu/goshtoso/components/codeblock"
	templpkg "github.com/a-h/templ"
)

templ operationResponseExample(data operationResponseExampleData) {
	{{ id := data.ID }}
	<div id={ id } data-manja-example>
		@codeblock.CodeBlock(codeblock.Config{
			ID: id+"-code",
			Label: "Response Example: "+data.Status+" "+data.ContentType,
			Language: "json",
			Code: data.Example,
			MaxHeight: "24rem",
		})
		@templpkg.JSONScript(id+"-payload", operationResponseExamplePayload(data))
		<p data-manja-example-status class="sr-only" aria-live="polite"></p>
	</div>
}

templ operationCodeSample(data operationCodeSampleData) {
	@codeblock.CodeBlock(codeblock.Config{
		Label: data.DisplayLabel,
		Language: data.Language,
		Code: data.Code,
		MaxHeight: "24rem",
	})
}
