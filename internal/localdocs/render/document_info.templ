package render

import (
	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/link"
)

templ catalogDocumentInfo(data catalogDocumentInfoData) {
	if data.HasInfo {
		<dl class="mb-8 grid gap-4 rounded-radius border border-outline bg-surface p-5 sm:grid-cols-2 xl:grid-cols-3 dark:border-outline-dark dark:bg-surface-dark" aria-label="OpenAPI information">
			if data.HasContact {
				<div class="min-w-0">
					<dt class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">Contact</dt>
					<dd class="mt-2 grid min-w-0 gap-1 text-sm">
						if data.ContactName != "" {
							<span class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ data.ContactName }</span>
						}
						if data.ContactURL != "" {
							@link.Link(data.ContactURL, link.WithTarget("_blank"), link.WithRootClass("min-w-0 truncate"), link.WithAttrs(templpkg.Attributes{"title": data.ContactURL})) {
								{ data.ContactURL }
							}
						}
						if data.ContactEmail != "" {
							@link.Link("mailto:" + data.ContactEmail, link.WithTarget("_blank"), link.WithRootClass("min-w-0 truncate"), link.WithAttrs(templpkg.Attributes{"title": data.ContactEmail})) {
								{ data.ContactEmail }
							}
						}
					</dd>
				</div>
			}
			if data.HasLicense {
				<div class="min-w-0">
					<dt class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">License</dt>
					<dd class="mt-2 grid min-w-0 gap-1 text-sm">
						if data.LicenseURL != "" {
							@link.Link(data.LicenseURL, link.WithTarget("_blank"), link.WithRootClass("min-w-0 truncate font-semibold"), link.WithAttrs(templpkg.Attributes{"title": data.LicenseURL})) {
								if data.LicenseName != "" {
									{ data.LicenseName }
								} else {
									View license
								}
							}
						} else if data.LicenseName != "" {
							<span class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ data.LicenseName }</span>
						}
						if data.LicenseIdentifier != "" {
							<code class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ data.LicenseIdentifier }</code>
						}
					</dd>
				</div>
			}
			if data.HasTerms {
				<div class="min-w-0">
					<dt class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">Terms of service</dt>
					<dd class="mt-2 min-w-0 text-sm">
						@link.Link(data.TermsOfService, link.WithTarget("_blank"), link.WithRootClass("block min-w-0 truncate font-semibold"), link.WithAttrs(templpkg.Attributes{"title": data.TermsOfService})) {
							View terms
						}
					</dd>
				</div>
			}
		</dl>
	}
}
