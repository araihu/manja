package render

import (
	"strings"

	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/badge"
)

templ operationHeader(operation operationHeaderData, actions, provenance templpkg.Component) {
	<header class="mb-6 min-w-0" data-public-page-header="true">
		<div class="flex min-w-0 flex-wrap items-start justify-between gap-3">
			<div class="flex min-w-0 flex-wrap items-center gap-2">
				<h1
					id={ operation.Anchor + "-heading" }
					tabindex="-1"
					data-public-doc-identity={ operation.Anchor }
					data-manja-settled-focus="true"
					class="manja-doc-title min-w-0 font-title text-2xl font-bold leading-tight text-on-surface-strong sm:text-3xl dark:text-on-surface-dark-strong"
				>{ operation.Title }</h1>
				if operation.Deprecated {
					@badge.Badge(badge.Config{Label: "Deprecated", Tone: badge.ToneWarning, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
				}
			</div>
			if actions != nil {
				@actions
			}
		</div>
		@EndpointRoute(operation.Method, operation.Path)
		if operation.Description != "" {
			<div class="manja-operation-markdown mt-4 min-w-0">
				@OperationDescription(operation.Description, operation.Anchor)
			</div>
		}
		if provenance != nil {
			<div class="mt-4">
				@provenance
			</div>
		}
	</header>
}

templ EndpointRoute(method string, path string) {
	<div aria-label="Endpoint route" class="mt-4 flex min-w-0 w-full items-center gap-3 rounded-radius border border-outline bg-surface-alt px-3 py-2 dark:border-outline-dark dark:bg-surface-dark-alt">
		@operationMethodBadge(method)
		<code class="min-w-0 break-all text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ path }</code>
	</div>
}

templ operationMethodBadge(method string) {
	@badge.Badge(badge.Config{
		Label:      strings.ToUpper(strings.TrimSpace(method)),
		Tone:       operationMethodBadgeTone(method),
		Appearance: badge.AppearanceSoft,
		Size:       badge.SizeSM,
		RootClass:  "shrink-0 font-mono font-bold",
	})
}

func operationMethodBadgeTone(method string) badge.Tone {
	switch strings.ToUpper(strings.TrimSpace(method)) {
	case "GET":
		return badge.ToneSuccess
	case "POST":
		return badge.TonePrimary
	case "PUT", "PATCH":
		return badge.ToneWarning
	case "DELETE":
		return badge.ToneDanger
	default:
		return badge.ToneDefault
	}
}
