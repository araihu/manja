package render

import (
	"strings"

	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/tooltip"
	"github.com/araihu/goshtoso/components/schematree"
)

templ operationSchemaProperties(tree operationSchemaTreeData) {
	if tree.HasContent {
		<div class="mt-4">
			@operationSchemaTree(tree)
			if tree.Root.Limited {
				<p class="mt-2 text-sm text-on-surface">Schema preview is limited. Download the OpenAPI document for the complete schema.</p>
			}
		</div>
	}
}

templ operationSchemaTree(tree operationSchemaTreeData) {
	@schematree.SchemaTree(operationSharedSchemaTree(tree))
}

templ operationSchemaTreeEnumAliasType(node operationSchemaTreeNodeData, scope string, tree operationSchemaTreeData) {
	{{ tooltipID := operationSchemaTreeEnumAliasTooltipID(scope, node) }}
	@tooltip.Tooltip(
		tooltipID,
		node.SchemaName,
		tooltip.WithDescription(operationSchemaTreeEnumAliasPreview(node.EnumValues)),
		tooltip.WithPosition(tooltip.PositionBottom),
		tooltip.WithTrigger(operationSchemaTreeEnumAliasTrigger(node, tooltipID, tree)),
	)
}

templ operationSchemaTreeEnumAliasTrigger(node operationSchemaTreeNodeData, tooltipID string, tree operationSchemaTreeData) {
	<span class="manja-schema-type">{ node.InlineType }&lt;</span>
	if node.ReferenceHref != "" {
		<a
			data-manja-schema-enum-reference="true"
			href={ templpkg.URL(node.ReferenceHref) }
			hx-get={ node.ReferenceHref }
			hx-target={ tree.LinkTarget }
			if tree.LinkSelect != "" {
				hx-select={ tree.LinkSelect }
			}
			hx-swap={ tree.LinkSwap }
			hx-push-url="true"
			aria-describedby={ tooltipID }
			aria-label={ "Open schema " + node.SchemaName }
			title={ "Open schema " + node.SchemaName }
			class="manja-schema-reference rounded-radius underline-offset-4 transition hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-dark"
		>{ node.SchemaName }</a>
	} else {
		<span class="manja-schema-type">{ node.SchemaName }</span>
	}
	<span class="manja-schema-type">&gt;</span>
}

func operationSchemaTreeRootName(caption, schemaName string) string {
	if strings.TrimSpace(schemaName) != "" {
		return schemaName
	}
	if strings.TrimSpace(caption) != "" {
		return caption
	}
	return "schema"
}

func operationSchemaTreeEnumAliasTooltipID(scope string, node operationSchemaTreeNodeData) string {
	return "schema-enum-alias-" + anchorFragment(scope) + "-" + anchorFragment(node.Name) + "-" + anchorFragment(node.SchemaName)
}

func operationSchemaTreeEnumAliasPreview(values []string) string {
	const previewLimit = 5
	preview := make([]string, 0, min(len(values), previewLimit))
	for _, value := range values {
		value = strings.TrimSpace(value)
		if value == "" {
			continue
		}
		preview = append(preview, value)
		if len(preview) == previewLimit {
			break
		}
	}
	if len(preview) == 0 {
		return "Named primitive enum."
	}
	if len(values) > len(preview) {
		return "Allowed: " + strings.Join(preview, ", ") + ", and more."
	}
	return "Allowed: " + strings.Join(preview, ", ")
}
