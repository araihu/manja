package render

import (
	"strconv"
	"strings"

	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/tooltip"
	"github.com/araihu/goshtoso/components/schematree"
)

templ schemaNode(node schemaNodeData) {
	{{ rootNode := strings.TrimSpace(node.Name) == strings.TrimSpace(node.RootHeading) }}
	<section id="schema-node-panel" data-manja-schema-node={ strconv.FormatUint(uint64(node.Ordinal), 10) } aria-label={ node.Name + " schema node" } class="scroll-mt-24 rounded-radius border border-outline bg-surface p-5 dark:border-outline-dark dark:bg-surface-dark">
		if !rootNode {
			<div class="flex flex-wrap items-start justify-between gap-3 border-b border-outline pb-4 dark:border-outline-dark">
				<div class="min-w-0">
					<h2 tabindex="-1" data-catalog-schema-node-focus="true" class="manja-schema-title font-title text-2xl font-bold text-on-surface-strong focus-visible:rounded-radius focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark">{ node.Name }</h2>
				</div>
				if node.Type != "" || node.Format != "" {
					<code class="rounded-radius bg-surface-alt px-3 py-1.5 text-sm text-on-surface-strong dark:bg-surface-dark-alt dark:text-on-surface-dark-strong">{ strings.TrimSpace(node.Type + " " + node.Format) }</code>
				}
			</div>
			if node.Description != "" {
				<div class="gs-schema-tree-description">
					@schemaDescriptionContent(node.Description)
				</div>
			}
		}
		if schemaHasMetadata(node.DefaultValue, node.ExampleText, node.EnumValues, node.Constraints, node.Nullable, node.Deprecated) {
			<div class="mt-4">
				@schemaMetadata(node.DefaultValue, node.ExampleText, node.EnumValues, node.Constraints, node.Nullable, node.Deprecated)
			</div>
		}
		if len(node.Edges) > 0 {
			@schematree.SchemaTree(sharedSchemaNodeEdges(node))
		}
		if node.Truncated {
			<p class="mt-4 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Showing first 100 links from this node.</p>
		}
	</section>
}

templ sharedSchemaEdgeType(nodeOrdinal uint32, edge schemaEdgeData) {
	if edge.ReferenceIsEnumAlias {
		@schemaEnumAliasType(nodeOrdinal, edge)
	} else {
		if edge.Reference != "" {
			@schemaReferenceLink(edge, "")
		}
		if edge.Type != "" {
			<span>{ edge.Type }</span>
		}
	}
}

templ schemaEnumAliasType(nodeOrdinal uint32, edge schemaEdgeData) {
	{{ tooltipID := schemaEnumAliasTooltipID(nodeOrdinal, edge) }}
	@tooltip.Tooltip(
		tooltipID,
		edge.Reference,
		tooltip.WithDescription(schemaEnumAliasPreview(edge.EnumValues)),
		tooltip.WithPosition(tooltip.PositionBottom),
		tooltip.WithTrigger(schemaEnumAliasTrigger(edge, tooltipID)),
	)
}

templ schemaEnumAliasTrigger(edge schemaEdgeData, tooltipID string) {
	<span class="manja-schema-type">{ edge.Type }&lt;</span>
	@schemaReferenceLink(edge, tooltipID)
	<span class="manja-schema-type">&gt;</span>
}

templ schemaReferenceLink(edge schemaEdgeData, tooltipID string) {
	if edge.ReferenceHref != "" {
		<a
			data-catalog-schema-reference="true"
			if edge.ReferenceIsEnumAlias {
				data-catalog-schema-enum-reference="true"
			}
			href={ templpkg.URL(edge.ReferenceHref) }
			hx-get={ edge.ReferenceHref }
			hx-target="#schema-node-panel"
			hx-select="#schema-node-panel"
			hx-swap="outerHTML show:#schema-node-panel:top"
			hx-push-url="true"
			if tooltipID != "" {
				aria-describedby={ tooltipID }
			}
			title={ "Open schema " + edge.Reference }
			class="manja-schema-reference rounded-radius underline-offset-4 transition hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-dark"
		>{ edge.Reference }</a>
	} else {
		<span class="manja-schema-type">{ edge.Reference }</span>
	}
}

func schemaEnumAliasTooltipID(nodeOrdinal uint32, edge schemaEdgeData) string {
	return "catalog-schema-enum-alias-" + strconv.FormatUint(uint64(nodeOrdinal), 10) + "-" + anchorFragment(edge.Name) + "-" + anchorFragment(edge.Reference)
}

func schemaEnumAliasPreview(values []string) string {
	const previewLimit = 5
	preview := make([]string, 0, min(len(values), previewLimit))
	for _, value := range values {
		value = strings.TrimSpace(value)
		if value == "" {
			continue
		}
		preview = append(preview, value)
		if len(preview) == previewLimit {
			break
		}
	}
	if len(preview) == 0 {
		return "Named primitive enum."
	}
	if len(values) > len(preview) {
		return "Allowed: " + strings.Join(preview, ", ") + ", and more."
	}
	return "Allowed: " + strings.Join(preview, ", ")
}

func schemaEdgeHasDescription(edge schemaEdgeData) bool {
	description := strings.TrimSpace(edge.Description)
	return description != "" && !strings.EqualFold(description, strings.TrimSpace(edge.Reference))
}

templ schemaMetadata(defaultValue string, exampleText string, enumValues []string, constraints []schemaConstraintData, nullable bool, deprecated bool) {
	if defaultValue != "" {
		<p class="manja-schema-metadata"><span>Default:</span><code>{ defaultValue }</code></p>
	}
	if exampleText != "" {
		<p class="manja-schema-metadata"><span>Example:</span><code>{ exampleText }</code></p>
	}
	if len(enumValues) > 0 {
		<p class="manja-schema-metadata">
			<span>Allowed:</span>
			for _, value := range enumValues {
				<code>{ value }</code>
			}
		</p>
	}
	for _, constraint := range constraints {
		<p class="manja-schema-metadata"><span>{ constraint.Name }:</span><code>{ constraint.Value }</code></p>
	}
	if nullable || deprecated {
		<p class="manja-schema-metadata">
			<span>Status:</span>
			if nullable {
				<code>nullable</code>
			}
			if deprecated {
				<code>deprecated</code>
			}
		</p>
	}
}

func schemaHasMetadata(defaultValue string, exampleText string, enumValues []string, constraints []schemaConstraintData, nullable bool, deprecated bool) bool {
	return defaultValue != "" || exampleText != "" || len(enumValues) > 0 || len(constraints) > 0 || nullable || deprecated
}

func schemaPropertyStateLabel(required bool) string {
	if required {
		return "required"
	}
	return "optional"
}

func anchorFragment(value string) string {
	var builder strings.Builder
	lastWasSeparator := false
	for _, character := range strings.ToLower(value) {
		switch {
		case character >= 'a' && character <= 'z':
			builder.WriteRune(character)
			lastWasSeparator = false
		case character >= '0' && character <= '9':
			builder.WriteRune(character)
			lastWasSeparator = false
		default:
			if builder.Len() > 0 && !lastWasSeparator {
				builder.WriteByte('-')
				lastWasSeparator = true
			}
		}
	}
	return strings.Trim(builder.String(), "-")
}
