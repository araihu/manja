package render

import (
	"strings"

	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
)

templ catalogDocumentSecuritySchemes(data catalogDocumentSecuritySchemesData) {
	if len(data.Schemes) > 0 {
		<section class="mt-8" aria-labelledby="document-security-schemes">
			<div class="mb-4 flex items-center gap-2">
				@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidLockClosed, Size: icon.SizeSM, Decorative: true})
				<h2 id="document-security-schemes" class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Security Schemes</h2>
			</div>
			<p class="mb-4 max-w-[70ch] text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Read-only reference. Credentials are never accepted or stored on this documentation page.</p>
			<div class="grid gap-4 lg:grid-cols-2">
				for _, scheme := range data.Schemes {
					<article id={ scheme.Anchor } class="scroll-mt-24 rounded-radius border border-outline bg-surface p-5 dark:border-outline-dark dark:bg-surface-dark">
						<div class="flex min-w-0 flex-wrap items-center gap-2">
							<h3 class="min-w-0 break-words font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ scheme.Name }</h3>
							if scheme.Type != "" {
								@badge.Badge(badge.Config{Label: scheme.Type, Tone: badge.ToneSecondary, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
							}
						</div>
						if scheme.Description != "" {
							<p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">{ scheme.Description }</p>
						}
						if scheme.ParameterName != "" || scheme.In != "" || scheme.Scheme != "" || scheme.BearerFormat != "" || scheme.OpenIDConnectURL != "" {
							<dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
								if scheme.ParameterName != "" {
									@catalogDocumentSecuritySchemeField(catalogDocumentSecurityParameterLabel(scheme.In), scheme.ParameterName)
								}
								if scheme.In != "" && scheme.ParameterName == "" {
									@catalogDocumentSecuritySchemeField("Location", scheme.In)
								}
								if scheme.Scheme != "" {
									@catalogDocumentSecuritySchemeField("Scheme", scheme.Scheme)
								}
								if scheme.BearerFormat != "" {
									@catalogDocumentSecuritySchemeField("Bearer format", scheme.BearerFormat)
								}
								if scheme.OpenIDConnectURL != "" {
									<div class="min-w-0 sm:col-span-2">
										<dt class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">OpenID Connect URL</dt>
										<dd class="mt-1 min-w-0"><a href={ templpkg.URL(scheme.OpenIDConnectURL) } rel="noreferrer" class="block truncate text-primary hover:underline dark:text-primary-dark" title={ scheme.OpenIDConnectURL }>{ scheme.OpenIDConnectURL }</a></dd>
									</div>
								}
							</dl>
						}
					</article>
				}
			</div>
		</section>
	}
}

templ catalogDocumentSecuritySchemeField(label string, value string) {
	<div class="min-w-0">
		<dt class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ label }</dt>
		<dd class="mt-1 break-words font-mono text-on-surface-strong dark:text-on-surface-dark-strong">{ value }</dd>
	</div>
}

func catalogDocumentSecurityParameterLabel(location string) string {
	switch strings.ToLower(strings.TrimSpace(location)) {
	case "header":
		return "Request header"
	case "query":
		return "Query parameter"
	case "cookie":
		return "Cookie"
	default:
		return "Parameter"
	}
}
