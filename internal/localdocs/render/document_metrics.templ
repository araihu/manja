package render

import "fmt"

templ catalogDocumentMetrics(data catalogDocumentMetricsData) {
	<div class="grid gap-4 sm:grid-cols-2">
		@catalogDocumentMetric("Operations", fmt.Sprintf("%d", data.Operations))
		@catalogDocumentMetric("Schemas", fmt.Sprintf("%d", data.Schemas))
	</div>
}

templ catalogDocumentMetric(label string, value string) {
	<div class="rounded-radius border border-outline bg-surface p-5 dark:border-outline-dark dark:bg-surface-dark">
		<p class="text-sm font-medium text-on-surface-muted dark:text-on-surface-dark-muted">{ label }</p>
		<p class="mt-2 break-words font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ value }</p>
	</div>
}
