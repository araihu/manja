package render

import (
	"strings"

	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/tooltip"
	"github.com/araihu/goshtoso/components/schematree"
	"github.com/araihu/manja/domain"
)

templ operationResponseDetails(response operationResponseDetailData, scope string, schemaLinks map[string]string) {
	@operationResponseDetailDescription(response.Description)
	if response.Description != "" && len(response.Headers) > 0 {
		{ " " }
	}
	@operationResponseDetailHeaders(response.Headers, scope, schemaLinks)
}

templ operationResponseDetailDescription(description string) {
	if description != "" {
		<div data-manja-response-section="description">
			<p class="max-w-[70ch] text-base font-medium text-on-surface dark:text-on-surface-dark">{ description }</p>
		</div>
	}
}

templ operationResponseDetailHeaders(headers []operationResponseHeaderData, scope string, schemaLinks map[string]string) {
	if len(headers) > 0 {
		<section data-manja-response-section="headers" aria-label="Response headers" class="grid gap-3">
			<h6 class="font-title text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Headers</h6>
			@schematree.SchemaTree(sharedResponseHeaderTree(headers, scope, schemaLinks))
		</section>
	}
}

func operationResponseDetailHeaderSummary(header operationResponseHeaderData) domain.SchemaSummary {
	summary := header.Schema
	if strings.TrimSpace(summary.Description) == "" {
		summary.Description = header.Description
	}
	if strings.TrimSpace(summary.Example) == "" {
		summary.Example = header.Example
	}
	return summary
}

templ operationResponseDetailSchemaEnumAliasType(name string, schema domain.SchemaSummary, scope string, schemaLinks map[string]string) {
	{{ tooltipID := "schema-enum-alias-" + anchorFragment(scope) + "-" + anchorFragment(name) + "-" + anchorFragment(schema.Name) }}
	@tooltip.Tooltip(tooltipID, schema.Name, tooltip.WithDescription(operationResponseDetailSchemaEnumAliasPreview(schema.Enum)), tooltip.WithPosition(tooltip.PositionBottom), tooltip.WithTrigger(operationResponseDetailSchemaEnumAliasTrigger(schema, schemaLinks, tooltipID)))
}

templ operationResponseDetailSchemaEnumAliasTrigger(schema domain.SchemaSummary, schemaLinks map[string]string, tooltipID string) {
	{{ href := strings.TrimSpace(schemaLinks[strings.TrimSpace(schema.Name)]) }}
	<span class="manja-schema-type">{ operationResponseDetailSchemaInlineTypeLabel(schema) }&lt;</span>
	if href != "" {
		<a data-manja-schema-enum-reference="true" href={ templpkg.URL(href) } hx-get={ href } hx-target="#catalog-main-content" hx-select="#catalog-main-content" hx-swap="outerHTML show:#main-content:top" hx-push-url="true" aria-describedby={ tooltipID } aria-label={ "Open schema " + schema.Name } title={ "Open schema " + schema.Name } class="manja-schema-reference rounded-radius underline-offset-4 transition hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-dark">{ schema.Name }</a>
	} else {
		<span class="manja-schema-type">{ schema.Name }</span>
	}
	<span class="manja-schema-type">&gt;</span>
}

func operationResponseDetailSchemaTreeDisplayName(name string, schema domain.SchemaSummary) string {
	if strings.TrimSpace(name) != "" {
		return name
	}
	if strings.TrimSpace(schema.Name) != "" {
		return schema.Name
	}
	return "schema"
}

func operationResponseDetailSchemaTreeExpandable(schema domain.SchemaSummary) bool {
	if len(schema.Properties) > 0 {
		return true
	}
	return schema.Items != nil && operationResponseDetailSchemaTreeExpandable(*schema.Items)
}

func operationResponseDetailSchemaInlineTypeLabel(schema domain.SchemaSummary) string {
	typeLabel := schema.Type
	if strings.Contains(schema.Type, "array") {
		typeLabel = "array"
		if schema.Items != nil {
			if item := parameterSchemaInline(*schema.Items); item != "" {
				typeLabel += "[" + item + "]"
			}
		}
	} else if schema.Format != "" {
		if typeLabel != "" {
			typeLabel += "<" + schema.Format + ">"
		} else {
			typeLabel = schema.Format
		}
	}
	return typeLabel
}

func operationResponseDetailSchemaEnumAliasPreview(values []string) string {
	const previewLimit = 5
	preview := make([]string, 0, min(len(values), previewLimit))
	for _, value := range values {
		value = strings.TrimSpace(value)
		if value == "" {
			continue
		}
		preview = append(preview, value)
		if len(preview) == previewLimit {
			break
		}
	}
	if len(preview) == 0 {
		return "Named primitive enum."
	}
	if len(values) > len(preview) {
		return "Allowed: " + strings.Join(preview, ", ") + ", and more."
	}
	return "Allowed: " + strings.Join(preview, ", ")
}
