{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manja-site",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist/site",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "manja.araihu.com", "custom_domain": true }],
  "workers_dev": true
}
