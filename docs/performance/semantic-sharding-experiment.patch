diff --git a/internal/selfhosted/semantic_partition_profile_test.go b/internal/selfhosted/semantic_partition_profile_test.go
new file mode 100644
index 0000000..e39216f
--- /dev/null
+++ b/internal/selfhosted/semantic_partition_profile_test.go
@@ -0,0 +1,198 @@
+package selfhosted
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"testing"
+
+	"github.com/araihu/manja/application/catalog"
+	"github.com/araihu/manja/application/projection"
+	"github.com/araihu/manja/internal/adapters/catalogjson"
+)
+
+// TestSemanticPartitionProfile recompiles only partitioning from an existing
+// verified export, leaving source and search data untouched. It exercises the
+// real encoders/admission bounds before investing in a full export.
+func TestSemanticPartitionProfile(t *testing.T) {
+	root := os.Getenv("MANJA_PARTITION_INPUT")
+	if root == "" {
+		t.Skip("opt-in partition experiment")
+	}
+	report := os.Getenv("MANJA_PARTITION_REPORT")
+	if report == "" {
+		t.Fatal("explicit report required")
+	}
+	var results []map[string]any
+	err := filepath.WalkDir(root, func(p string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if d.IsDir() || d.Name() != "catalog.json" {
+			return nil
+		}
+		data, err := os.ReadFile(p)
+		if err != nil {
+			return err
+		}
+		var directory catalog.CatalogArtifactV1
+		if err = json.Unmarshal(data, &directory); err != nil {
+			return err
+		}
+		manifestBytes, err := os.ReadFile(filepath.Join(filepath.Dir(p), "manifest.json"))
+		if err != nil {
+			return err
+		}
+		var manifest catalog.ManifestV1
+		if err = json.Unmarshal(manifestBytes, &manifest); err != nil {
+			return err
+		}
+		var identities []catalog.ChildIdentityV1
+		for _, c := range manifest.Children {
+			if c.Kind != "detail" && c.Kind != "schema-node" && c.Kind != "catalog" {
+				identities = append(identities, c)
+			}
+		}
+		nodes, details := 0, 0
+		for i := range directory.Documents {
+			dir := &directory.Documents[i]
+			var doc projection.Document
+			paths := map[string]bool{}
+			for _, op := range dir.Operations {
+				paths[op.DetailChild] = true
+			}
+			for _, s := range dir.Schemas {
+				paths[s.DetailChild] = true
+			}
+			for path := range paths {
+				b, e := os.ReadFile(filepath.Join(filepath.Dir(p), "projection-data", path))
+				if e != nil {
+					return e
+				}
+				shard, e := catalogjson.DecodeDetailShard(b)
+				if e != nil {
+					return e
+				}
+				for _, r := range shard.Records {
+					if r.Operation != nil {
+						doc.OperationDetails = append(doc.OperationDetails, *r.Operation)
+					}
+					if r.Schema != nil {
+						doc.SchemaDetails = append(doc.SchemaDetails, *r.Schema)
+					}
+				}
+			}
+			for _, ref := range dir.SchemaNodeShards {
+				b, e := os.ReadFile(filepath.Join(filepath.Dir(p), "projection-data", ref.Path))
+				if e != nil {
+					return e
+				}
+				shard, e := catalogjson.DecodeSchemaNodeShard(b)
+				if e != nil {
+					return e
+				}
+				doc.SchemaNodes = append(doc.SchemaNodes, shard.Nodes...)
+			}
+			partition, e := catalog.PartitionDocument(dir.Key, doc, *dir, catalog.DefaultPartitionLimits(catalog.DefaultBounds()))
+			if e != nil {
+				return e
+			}
+			*dir = partition.Directory
+			for _, c := range partition.Children {
+				identities = append(identities, catalog.ChildIdentityV1{Path: c.Path, Kind: c.Kind, Length: c.Length, SHA256: c.SHA256})
+				if c.Kind == "schema-node" {
+					nodes++
+				} else {
+					details++
+				}
+			}
+		}
+
+		search, err := catalog.BuildSearchArtifactsWithoutResourceLimits(directory, catalog.DefaultBounds())
+		if err != nil {
+			return err
+		}
+		searchRoot := filepath.Join(filepath.Dir(p), "search-data")
+		oldPaths := make(map[string]bool)
+		if err := filepath.WalkDir(searchRoot, func(path string, entry os.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if entry.IsDir() {
+				return nil
+			}
+			relative, err := filepath.Rel(searchRoot, path)
+			if err != nil {
+				return err
+			}
+			oldPaths[filepath.ToSlash(relative)] = true
+			return nil
+		}); err != nil {
+			return err
+		}
+		newPaths := make(map[string]bool)
+		for _, child := range search.Children {
+			newPaths[child.Path] = true
+		}
+		for path := range oldPaths {
+			if !newPaths[path] {
+				return fmt.Errorf("search output removed: %s", path)
+			}
+		}
+		for path := range newPaths {
+			if !oldPaths[path] {
+				return fmt.Errorf("search output added: %s", path)
+			}
+		}
+		for _, child := range search.Children {
+			old, e := os.ReadFile(filepath.Join(searchRoot, child.Path))
+			if e != nil {
+				return e
+			}
+			if !bytes.Equal(old, child.Bytes) {
+				return fmt.Errorf("search output changed: %s", child.Path)
+			}
+		}
+		encoded, err := json.Marshal(directory)
+		if err != nil {
+			return err
+		}
+		digest := sha256.Sum256(encoded)
+		identities = append(identities, catalog.ChildIdentityV1{Path: "catalog.json", Kind: "catalog", Length: uint64(len(encoded)), SHA256: hex.EncodeToString(digest[:])})
+		sort.Slice(identities, func(i, j int) bool { return identities[i].Path < identities[j].Path })
+		manifest.Children = identities
+		manifest.Identity.Children = identities
+		manifest.Identity.Versions.PartitionPolicy = catalog.DefaultCompilerOptions().Versions.PartitionPolicy
+		idBytes, _ := json.Marshal(manifest.Identity)
+		id := sha256.Sum256(idBytes)
+		manifest.SnapshotID = catalog.SnapshotID("snapshot-sha256-" + hex.EncodeToString(id[:]))
+		encodedManifest, err := json.Marshal(manifest)
+		if err != nil {
+			return err
+		}
+		_, catalogErr := catalogjson.DecodeCatalog(encoded)
+		_, manifestErr := catalogjson.DecodeManifest(encodedManifest)
+		r := map[string]any{"catalog": directory.CatalogID, "schema_files": nodes, "detail_files": details, "old_catalog_bytes": len(data), "catalog_bytes": len(encoded), "old_manifest_bytes": len(manifestBytes), "manifest_bytes": len(encodedManifest), "search_children_unchanged": true, "search_children_rebuilt_and_compared": len(search.Children)}
+		if catalogErr != nil {
+			r["catalog_admission_error"] = catalogErr.Error()
+		}
+		if manifestErr != nil {
+			r["manifest_admission_error"] = manifestErr.Error()
+		}
+		results = append(results, r)
+		t.Log(r)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, _ := json.MarshalIndent(results, "", "  ")
+	if err = os.WriteFile(report, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+}
