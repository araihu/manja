+// Group operation details by literal API path, while keeping each standalone
+// schema detail separate. Oversized paths still obey the record/byte ceilings.
+func partitionSemanticDetails(documentKey string, records []DetailRecordV1, limits PartitionLimits) ([]ChildArtifact, map[domain.DetailID]string, BudgetUsage, error) {
+	groupKey := func(r DetailRecordV1) string {
+		if r.Operation != nil {
+			return "operation\x00" + r.Operation.Path
+		}
+		return "schema\x00" + string(r.ID)
+	}
+	sort.Slice(records, func(i, j int) bool {
+		a, b := groupKey(records[i]), groupKey(records[j])
+		if a != b {
+			return a < b
+		}
+		return records[i].ID < records[j].ID
+	})
+	var children []ChildArtifact
+	paths := make(map[domain.DetailID]string, len(records))
+	var usage BudgetUsage
+	for start := 0; start < len(records); {
+		end := start + 1
+		for end < len(records) && groupKey(records[end]) == groupKey(records[start]) {
+			end++
+		}
+		part, mapped, used, err := partitionDetailRecords(documentKey, records[start:end], limits)
+		if err != nil {
+			return nil, nil, BudgetUsage{}, err
+		}
+		children = append(children, part...)
+		for id, p := range mapped {
+			paths[id] = p
+		}
+		usage.Children += used.Children
+		usage.ProjectionBytes += used.ProjectionBytes
+		usage.DetailShardRecords = max(usage.DetailShardRecords, used.DetailShardRecords)
+		usage.DetailShardBytes = max(usage.DetailShardBytes, used.DetailShardBytes)
+		start = end
+	}
+	return children, paths, usage, nil
+}
+
